# ── Restos de construir la ISO ───────────────────────────────────────
# Se regeneran solos y ocupan 14 GB. Nunca van al repositorio.
receta/chroot/
receta/binary/
receta/cache/
receta/.build/
receta/build.log
receta/chroot.*
receta/binary.*
receta/live-image-*

# ── Lo que genera «lb config» a partir de auto/config ─────────────────
# La receta de verdad es auto/config y las listas. Esto es su resultado.
receta/config/bootstrap
receta/config/binary
receta/config/chroot
receta/config/common
receta/config/source
receta/config/package-lists/live.list.chroot

# Los «hooks» de config/hooks/ son enlaces a los de live-build, no nuestros.
# Los propios viven en receta/hooks-propios/ y construir-iso.sh los copia.
receta/config/hooks/

# ── Binarios grandes ─────────────────────────────────────────────────
# Una ISO son 2,7 GB: no caben ni tienen sentido en un repositorio.
isos/
*.iso
*.qcow2
*.deb
*.tar.*

# ── Respaldos de trabajo ─────────────────────────────────────────────
*.antes-de-*
*~
# Los .deb que se generan para meter en la ISO
receta/config/packages.chroot/
paquetes/deb/

# ── El repositorio APT ───────────────────────────────────────────────
# repositorio/ se arma solo a partir de paquetes/deb/ y tiene su propio
# git, apuntando a la rama gh-pages de ESTE MISMO repositorio. Si se
# rastreara también desde main, los .deb acabarían duplicados dentro del
# código fuente y las dos ramas pelearían por los mismos archivos.
repositorio/

# ── Restos de las pruebas en máquina virtual ─────────────────────────
# Registros de QEMU, memorias UEFI y fotos del arranque. Se vuelven a
# generar cada vez que se corre una prueba, y lo que importa de ellas
# —si arrancó o no— queda escrito en pruebas/resultados.md.
pruebas/**/qemu.log
pruebas/**/vars.fd
pruebas/fotos-arranque/
