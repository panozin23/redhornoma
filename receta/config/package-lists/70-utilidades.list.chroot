# 70 · UTILIDADES
# Lo que necesitan las herramientas de RedHornoma para funcionar.

# Ventanas gráficas desde guiones — con esto se hacen los paneles
yad
zenity
xdg-utils

# Comprimir y descomprimir.
#
# El Ministerio manda sus actualizaciones y catálogos en RAR, y ni Debian
# ni Windows los abren de fábrica. Sin esto, un centro que reciba la
# actualización de enero se queda sin poder abrirla. Los lectores de RAR
# de siempre están en la sección non-free; estos dos hacen el trabajo y
# son software libre.
unrar-free
libarchive-tools
p7zip-full
unzip
zip
xz-utils

# Leer las bases de datos de SALMI desde Linux.
#
# SALMI guarda todo en archivos .mdb de Access. Sin esto, el respaldo solo
# puede mirar el tamaño del archivo; con esto ABRE la base, cuenta pacientes
# y prestaciones, y avisa si la información menguó. Es la diferencia entre
# una copia y una copia comprobada.
mdbtools

# Hablar con el Windows virtual desde Python.
#
# Los datos se sacan y se devuelven por el agente invitado. Pasarlos como
# argumento de un comando no sirve: medio mega de texto supera el límite del
# sistema y el fallo solo aparece al escribir, no al leer. Con esta
# biblioteca se hace desde Python y no hay límite.
python3
python3-libvirt

# Copiar respaldos a otra computadora del centro y a la nube
rsync
rclone
smbclient
cifs-utils

# Diagnóstico
htop
lsb-release
pciutils
dmidecode
lshw
inxi

# Programación de tareas — respaldos nocturnos
cron

# Registro de lo que pasa
rsyslog

# Cuando RedHornoma se ejecuta DENTRO de una máquina virtual — que es como
# lo probamos nosotros — esto comparte el portapapeles con el equipo de
# fuera y ajusta la resolución de pantalla sola. Sin ellos hay que teclear
# a mano cada comando de prueba.
spice-vdagent
qemu-guest-agent
