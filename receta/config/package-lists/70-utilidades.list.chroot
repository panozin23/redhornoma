# 70 · UTILIDADES
# Lo que necesitan las herramientas de RedHornoma para funcionar.

# Ventanas gráficas desde guiones — con esto se hacen los paneles
yad
zenity
xdg-utils

# Comprimir y descomprimir.
#
# El Ministerio manda sus actualizaciones y catálogos en RAR, y ni Debian
# ni Windows los abren de fábrica. Sin esto, un centro que reciba la
# actualización de enero se queda sin poder abrirla. Los lectores de RAR
# de siempre están en la sección non-free; estos dos hacen el trabajo y
# son software libre.
unrar-free
libarchive-tools
p7zip-full
unzip
zip
xz-utils

# Leer las bases de datos de SALMI desde Linux.
#
# SALMI guarda todo en archivos .mdb de Access. Sin esto, el respaldo solo
# puede mirar el tamaño del archivo; con esto ABRE la base, cuenta pacientes
# y prestaciones, y avisa si la información menguó. Es la diferencia entre
# una copia y una copia comprobada.
mdbtools

# Hablar con el Windows virtual desde Python.
#
# Los datos se sacan y se devuelven por el agente invitado. Pasarlos como
# argumento de un comando no sirve: medio mega de texto supera el límite del
# sistema y el fallo solo aparece al escribir, no al leer. Con esta
# biblioteca se hace desde Python y no hay límite.
python3
python3-libvirt

# Copiar respaldos a otra computadora del centro y a la nube
rsync
rclone
smbclient
cifs-utils

# Diagnóstico
htop
lsb-release
pciutils
dmidecode
lshw
inxi

# Programación de tareas — respaldos nocturnos
cron

# Registro de lo que pasa
rsyslog

# Cuando RedHornoma se ejecuta DENTRO de una máquina virtual — que es como
# lo probamos nosotros — esto comparte el portapapeles con el equipo de
# fuera y ajusta la resolución de pantalla sola. Sin ellos hay que teclear
# a mano cada comando de prueba.
spice-vdagent
qemu-guest-agent
# Órdenes que las herramientas de RedHornoma usan de verdad.
#
# Estas cinco salieron el 14/08/2026 de una comprobación nueva: mirar QUÉ
# ÓRDENES invocan las herramientas y de qué paquete viene cada una. Todas
# estaban instaladas aquí de arrastre y ninguna declarada, así que en una
# ISO reconstruida podían faltar y la herramienta fallaría sin explicar por
# qué. Ahora esa comprobación la hace comprobar-receta.sh sola.
#
# fuser         · redhornoma-discos, para ver quién retiene un disco
# xdg-user-dir  · redhornoma-equipos y la carpeta compartida
# xorriso       · redhornoma-virtio-reducido, para abrir y rehacer la ISO
#                 de controladores de Windows
# genisoimage   · lo mismo, en máquinas donde xorriso no basta
psmisc
xdg-user-dirs
xorriso
genisoimage
# Que la máquina se ponga al día ella sola. Es parte del objetivo 9: un
# centro donde no hay informático no puede depender de que alguien se
# acuerde de actualizar.
unattended-upgrades
# El cortafuegos, con ventana. «ufw» ya estaba, pero solo se maneja
# escribiendo, y esta distro no se maneja escribiendo.
gufw
# Reinicia los servicios que se quedaron con una librería vieja después de
# actualizar. Viene de arrastre con unattended-upgrades y se declara igual,
# porque redhornoma-base le trae su configuración: sin él, ese archivo no
# lo lee nadie.
needrestart
