# 00 · SISTEMA BASE
# Lo mínimo para que la máquina arranque en cualquier hardware.
# Los centros de salud tienen computadoras de todas las épocas: aquí no se
# escatima en controladores.

# Núcleo
linux-image-amd64

# Controladores de fábrica — imprescindibles en hardware variado
firmware-linux
firmware-linux-nonfree
firmware-misc-nonfree
firmware-realtek
firmware-atheros
firmware-iwlwifi
firmware-brcm80211
firmware-amd-graphics
intel-microcode
amd64-microcode

# Arranque, incluido el seguro
grub-efi-amd64
grub-efi-amd64-signed
shim-signed
mokutil
efibootmgr
os-prober

# Arranque a la manera antigua, para máquinas sin UEFI.
#
# Sin esto, instalar en un equipo que arrancó en modo BIOS falla al final
# con «grub-install --target=i386-pc devolvió el código de error 1», y el
# instalador no dice qué hacer. Se descubrió el 2026-08-02 en un PC de
# escritorio de 2011 — justo el tipo de máquina que hay en los centros.
#
# cursalialinux lo lleva desde siempre, y por eso instala en todas partes.
# mtools hace falta para escribir la partición de arranque EFI.
grub-pc-bin
mtools

# Discos y sistemas de archivos
ntfs-3g
exfatprogs
dosfstools
e2fsprogs
gdisk
parted
smartmontools

# Red básica
network-manager
network-manager-gnome
iproute2
iputils-ping
bind9-dnsutils

# Hora — los informes dependen de la fecha
systemd-timesyncd

# Permisos y servicios
polkitd
# pkexec es el que pide la contraseña en una VENTANA. Sin él, «Algo no
# funciona» no puede reparar nada en un centro: la única forma de dar
# permiso sería abrir una terminal, que es justo lo que no queremos.
# Va en Depends de redhornoma-panel desde 1.0.5, y el 09/08/2026 se
# construyó sin declararlo aquí — lo cazó comprobar-receta.sh.
pkexec
sudo
