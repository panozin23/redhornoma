# 40 · RED DEL CENTRO
# Para que las computadoras del centro se vean, se administren a distancia y
# compartan carpetas con el Windows.

# Administración a distancia — la regla de oro del proyecto
openssh-server
openssh-client

# Que las máquinas se encuentren solas por su nombre
avahi-daemon
avahi-utils
libnss-mdns

# Carpetas compartidas con el Windows virtual
samba
samba-common-bin
smbclient
cifs-utils

# Diagnóstico de red
nmap
traceroute
curl
wget
rsync

# Cortafuegos
ufw
# Unir los centros entre sí — el objetivo 11.
#
# Tailscale NO se declara aquí: viaja como paquete suelto en
# config/packages.chroot, que lo pone construir-iso.sh.
#
# 🔴 Se intentó por el camino normal —su repositorio en config/archives— y
# la ISO falló: el sistema en construcción aún no tiene los certificados
# para hablar por HTTPS, y Tailscale solo sirve por HTTPS. El archivo de su
# repositorio va dentro de redhornoma-red, para que la máquina ya instalada
# sí lo actualice.
# Leer la respuesta de Tailscale, que viene en JSON. Lo usa el vigía para
# saber cuándo se conectó cada centro por última vez. Va en Depends de
# redhornoma-base desde 1.2.1, y aun así se declara: la regla del proyecto
# es que nada entre de arrastre.
jq
# Lo necesita Tailscale para armar sus reglas de red. Viene de arrastre con
# él, y se declara igual: la regla del proyecto es que nada entre solo, y
# menos algo de lo que depende el objetivo 11.
iptables
