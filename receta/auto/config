#!/bin/sh
# receta/auto/config — La receta de RedHornoma.
#
# Este archivo define QUÉ es RedHornoma. Todo lo que hay en la ISO sale de
# aquí y de las listas de config/package-lists/.
#
# Regla del proyecto: nada se instala a mano dentro del sistema construido.
# Si algo hace falta, se escribe en una lista. Así la ISO se puede rehacer
# desde cero en cualquier momento.

set -e

# Por qué estas opciones de apt:
#
#   Retries=5      deb.debian.org es una red de servidores repartidos por el
#                  mundo; alguno falla de vez en cuando. Reintentar sale
#                  gratis y evita perder una construcción entera.
#
#   ForceIPv4      El 2026-08-05 una construcción murió a los 20 minutos con
#                  187 paquetes sin bajar, TODOS por «Network is unreachable»
#                  hacia direcciones IPv6. Aquí no hay IPv6 que funcione, pero
#                  apt lo intenta igual porque el servidor la anuncia. Pedir
#                  IPv4 quita esa lotería. En una red con IPv6 bueno no
#                  estorba: IPv4 funciona en todas partes.
#
# Estaba puesto a mano en config/common, que git ignora: se habría perdido en
# cuanto alguien clonara el proyecto. La receta es esto, no lo que quedó en
# una carpeta de trabajo.
lb config noauto \
  --distribution trixie \
  --parent-distribution trixie \
  --archive-areas "main contrib non-free non-free-firmware" \
  --architectures amd64 \
  --binary-images iso-hybrid \
  --debian-installer none \
  --apt-indices false \
  --apt-recommends true \
  --firmware-chroot true \
  --firmware-binary true \
  --memtest none \
  --win32-loader false \
  --iso-application "RedHornoma" \
  --iso-publisher "RedHornoma; proyecto independiente; https://github.com/panozin23" \
  --iso-volume "RedHornoma" \
  --bootappend-live "boot=live components quiet splash locales=es_BO.UTF-8 keyboard-layouts=es keyboard-model=pc105 timezone=America/La_Paz username=redhornoma hostname=redhornoma" \
  --bootloaders "grub-efi syslinux" \
  --uefi-secure-boot enable \
  --apt-options "--yes -o Acquire::Retries=5 -o Acquire::ForceIPv4=true" \
  --mirror-bootstrap "http://deb.debian.org/debian/" \
  --mirror-chroot "http://deb.debian.org/debian/" \
  --mirror-binary "http://deb.debian.org/debian/" \
  --security true \
  --updates true \
  --backports false \
  "${@}"
