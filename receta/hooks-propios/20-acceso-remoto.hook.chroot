#!/bin/sh
# 20-acceso-remoto.hook.chroot — Que se pueda entrar por red desde el minuto uno.
#
# El 2026-08-02, tras instalar RedHornoma en un centro, hubo que ir físicamente
# a la máquina DOS VECES antes de poder trabajar a distancia:
#
#   · SSH venía instalado pero apagado
#   · y al encenderlo fallaba, porque el sistema no tenía llaves de identidad
#
# Las ISOs en vivo borran esas llaves a propósito —para que no todas las
# instalaciones tengan la misma— y solo live-config las rehace, que en un
# sistema ya instalado no corre. Resultado: ssh.service no arranca y el
# mensaje no dice por qué.
#
# En un centro rural, ir a la máquina significa un viaje de horas. Y la regla
# de trabajo del proyecto es justamente no tener que ir.
set -e

echo "P: RedHornoma — acceso remoto desde el primer arranque"

# 1 · Encendido de fábrica
systemctl enable ssh 2>/dev/null || systemctl enable sshd 2>/dev/null || true

# 2 · Que se cree sus llaves si no las tiene, antes de intentar arrancar.
#     ssh-keygen -A no toca las que ya existan: solo crea las que falten.
mkdir -p /etc/systemd/system/ssh.service.d
cat > /etc/systemd/system/ssh.service.d/10-redhornoma-llaves.conf <<'UNIDAD'
# Crear las llaves de identidad si faltan.
#
# Sin esto, un sistema recién instalado desde la ISO no puede arrancar SSH:
# la imagen en vivo borra las llaves y nadie las vuelve a crear. Hay que ir
# físicamente a la máquina a escribir «ssh-keygen -A», que es justo lo que
# este proyecto quiere evitar.
#
# «-A» solo crea las que falten. Si ya están, no toca nada.
[Service]
ExecStartPre=/usr/bin/ssh-keygen -A
UNIDAD

echo "P: RedHornoma — SSH encendido y con llaves aseguradas"
