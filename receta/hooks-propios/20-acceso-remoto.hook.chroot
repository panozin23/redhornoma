#!/bin/sh
# 20-acceso-remoto.hook.chroot — Que se pueda entrar por red desde el minuto uno.
#
# El 2026-08-02, tras instalar RedHornoma en un centro, hubo que ir físicamente
# a la máquina DOS VECES antes de poder trabajar a distancia:
#
#   · SSH venía instalado pero apagado
#   · y al encenderlo fallaba, porque el sistema no tenía llaves de identidad
#
# Las ISOs en vivo borran esas llaves a propósito —para que no todas las
# instalaciones tengan la misma— y solo live-config las rehace, que en un
# sistema ya instalado no corre. Resultado: ssh.service no arranca.
#
# En un centro rural, ir a la máquina significa un viaje de horas. Y la regla
# de trabajo del proyecto es justamente no tener que ir.
set -e

echo "P: RedHornoma — acceso remoto desde el primer arranque"

# 1 · Encendido de fábrica
systemctl enable ssh 2>/dev/null || systemctl enable sshd 2>/dev/null || true

# 2 · Las llaves, ANTES de que sshd compruebe su configuración.
#
# EL ORDEN ES TODO. La unidad de Debian trae:
#
#     ExecStartPre=/usr/sbin/sshd -t
#
# y systemd AÑADE al final lo que ponga un drop-in. El primer intento puso
# solo «ExecStartPre=/usr/bin/ssh-keygen -A», que quedó DETRÁS: sshd -t
# comprobaba la configuración sin llaves, fallaba, y ssh-keygen nunca
# llegaba a ejecutarse. El servicio quedaba en «failed» y el mensaje no
# decía nada de llaves. Se descubrió el 2026-08-03, en el área rural, con
# la máquina ya instalada y sin poder entrar en ella.
#
# La línea «ExecStartPre=» vacía borra la lista heredada. Después se ponen
# las dos en el orden correcto.
mkdir -p /etc/systemd/system/ssh.service.d
cat > /etc/systemd/system/ssh.service.d/10-redhornoma-llaves.conf <<'UNIDAD'
# Crear las llaves de identidad ANTES de comprobar la configuración.
#
# La primera línea, vacía a propósito, borra la lista que trae Debian. Sin
# ella, esto se añadiría DETRÁS de «sshd -t», que es justo el paso que
# fracasa cuando no hay llaves. Orden equivocado = servicio muerto.
#
# «ssh-keygen -A» solo crea las que falten: si ya están, no toca nada.
[Service]
ExecStartPre=
ExecStartPre=/usr/bin/ssh-keygen -A
ExecStartPre=/usr/sbin/sshd -t
UNIDAD

# 3 · Comprobar aquí mismo que el ajuste dice lo que tiene que decir.
#     Un arreglo que se cuela mal en la ISO no se descubre hasta que alguien
#     está delante de una máquina a tres horas de camino.
#
# Se miran SOLO las líneas que systemd obedece, las que empiezan por
# «ExecStartPre=». La primera versión de esta comprobación buscaba
# «ssh-keygen -A» en todo el archivo y lo encontraba DOS veces: una en el
# comentario de arriba, que lo nombra para explicarlo, y otra en la orden de
# verdad. Dos números donde se esperaba uno, y la construcción entera murió
# con «Illegal number: 7\n10» a los once minutos.
#
# Un comentario que menciona algo no es ese algo.
A=/etc/systemd/system/ssh.service.d/10-redhornoma-llaves.conf
ORDENES=$(grep -n '^ExecStartPre=' "$A" || true)

BORRA=$(echo "$ORDENES" | grep -c ':ExecStartPre=$' || true)
LLAVES=$(echo "$ORDENES" | grep 'ssh-keygen -A' | head -1 | cut -d: -f1)
PRUEBA=$(echo "$ORDENES" | grep 'sshd -t'       | head -1 | cut -d: -f1)

# Cada pieza por separado, para que el mensaje diga cuál falta en vez de un
# «mal orden» que no ayuda a nadie.
FALLO=""
[ "$BORRA" -ge 1 ] 2>/dev/null || FALLO="falta la línea «ExecStartPre=» vacía que borra la lista de Debian"
case "$LLAVES" in ''|*[!0-9]*) FALLO="no aparece ExecStartPre= con ssh-keygen -A" ;; esac
case "$PRUEBA" in ''|*[!0-9]*) FALLO="no aparece ExecStartPre= con sshd -t" ;; esac
if [ -z "$FALLO" ] && [ "$LLAVES" -ge "$PRUEBA" ]; then
  FALLO="ssh-keygen -A (línea $LLAVES) va DESPUÉS de sshd -t (línea $PRUEBA)"
fi

if [ -z "$FALLO" ]; then
  echo "P: RedHornoma — SSH: llaves antes de la comprobación, orden correcto"
else
  echo "E: RedHornoma — el ajuste de SSH no sirve: $FALLO"
  echo "E: esto es lo que quedó escrito en $A —"
  sed 's/^/E:    /' "$A"
  exit 1
fi
