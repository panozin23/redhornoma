#!/bin/bash
# redhornoma-respaldo — Guarda la información del centro, sola, cada día.
#
# La información de un centro de salud no se puede volver a escribir. Si se
# pierde, se perdió. Por eso esta es la pieza más importante del sistema.
#
# Cómo funciona: SALMI guarda todo en tres archivos dentro de Windows. Esta
# herramienta congela un instante el disco de la máquina virtual, saca esos
# archivos SIN QUE NADIE ABRA NADA, comprueba que sirven, y los deja en
# varios sitios.
#
# SOAPS y SNIS no se pueden copiar así: SOAPS vive en un SQL Server con sus
# bases abiertas, y copiar esos archivos da una copia rota. Sus copias las
# hace el propio Windows cada noche y las deja en la carpeta compartida.
# Se pone en marcha con --preparar-programas, y solo hace falta una vez.
#
# Uso:
#   redhornoma-respaldo               qué hay y cuándo fue el último
#   sudo redhornoma-respaldo --ahora
#   sudo redhornoma-respaldo --programar     lo deja hecho cada día
#   sudo redhornoma-respaldo --verificar     comprueba que el último sirve
#   sudo redhornoma-respaldo --rescatar      devuelve un respaldo a Windows
#   sudo redhornoma-respaldo --preparar-programas   SOAPS y SNIS, una vez
#
# Un respaldo que nunca se ha restaurado no es un respaldo: es una esperanza.
set -u

BASE=/var/lib/redhornoma
DESTINO="$BASE/respaldos"
CONF="$BASE/respaldo.conf"
REGISTRO="$BASE/respaldo.log"

# Cuántos se conservan. Son los valores de partida: cada centro puede
# cambiarlos en respaldo.conf, porque no todos trabajan igual.
DIARIOS=7; SEMANALES=4; MENSUALES=12

# Cada cuántos días se hace una copia. El temporizador se dispara todos los
# días; si no ha pasado este tiempo desde la última, la deja para mañana.
#
# Se hace así, y no con un temporizador cada dos días, porque un centro
# apaga las computadoras y se va: con «cada dos días» en el calendario, un
# apagón el día que tocaba salta la copia entera hasta cuatro días después.
# Mirando la fecha de la última, se recupera al primer encendido.
CADA_DIAS=1

VM=""; ACCION="mirar"
while [ $# -gt 0 ]; do
  case "$1" in
    --ahora)     ACCION=ahora; shift ;;
    --programar) ACCION=programar; shift ;;
    --verificar) ACCION=verificar; shift ;;
    --rescatar)  ACCION=rescatar; CUAL="${2:-}"
                 case "$CUAL" in --*|"") CUAL="" ; shift ;; *) shift 2 ;; esac ;;
    --confirmo)  CONFIRMADO=1; shift ;;
    --maquina)   VM="${2:-}"; shift 2 ;;
    --silencioso) ACCION=ahora; SILENCIO=1; shift ;;
    --preparar-programas) ACCION=preparar_programas; shift ;;
    --ayuda|-h)  sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "Opción desconocida: $1"; exit 1 ;;
  esac
done
SILENCIO="${SILENCIO:-0}"; CUAL="${CUAL:-}"; CONFIRMADO="${CONFIRMADO:-0}"

if [ -t 1 ] && [ "$SILENCIO" = "0" ]; then
  V=$'\033[0m'; AZ=$'\033[1;34m'; VE=$'\033[1;32m'; RO=$'\033[1;31m'; AM=$'\033[1;33m'; GR=$'\033[0;90m'
else
  V=""; AZ=""; VE=""; RO=""; AM=""; GR=""
fi
titulo(){ printf "\n${AZ}══════════════════════════════════════════════════════${V}\n"
          printf "${AZ} %s${V}\n" "$1"
          printf "${AZ}══════════════════════════════════════════════════════${V}\n"; }
ok(){  printf "   ${VE}✅${V} %s\n" "$1"; }
mal(){ printf "   ${RO}❌${V} %s\n" "$1"; }
avi(){ printf "   ${AM}⚠️ ${V} %s\n" "$1"; }
nota(){ printf "   ${GR}%s${V}\n" "$1"; }
d(){   printf "   %-28s %s\n" "$1" "$2"; }
anota(){ mkdir -p "$BASE"; printf '%s\t%s\n' "$(date '+%Y-%m-%d %H:%M')" "$1" >> "$REGISTRO"; }

VIRSH="virsh -c qemu:///system"
# Las órdenes al agente llevan tiempo de sobra: congelar el disco en
# Windows tarda varios segundos y virsh, por defecto, se cansa antes y
# devuelve error AUNQUE la orden haya funcionado.
agente(){ $VIRSH qemu-agent-command --timeout 60 "$VM" "$1" 2>/dev/null; }

# ═════════════════════════════════════════════════════════════════════
#  DOS FORMAS DE LLEGAR A LOS ARCHIVOS DE WINDOWS
# ═════════════════════════════════════════════════════════════════════
# «virtual» — Windows es una máquina virtual de este equipo. Se habla con
#             su agente invitado: se puede congelar el disco, mirar qué
#             programas corren y apagarla con orden.
#
# «red»     — Windows es una computadora de verdad que ya estaba en el
#             centro, con SOAPS y SALMI trabajando. No se toca: se entra
#             por la red a una carpeta que ella comparte.
#
# El segundo modo es el que permite proteger un centro SIN cambiar sus
# computadoras. Se pierde poder —no se puede congelar el disco— pero se
# gana no interrumpir a nadie.
leer_conf(){ [ -f "$CONF" ] && grep -oP "^$1=\K.*" "$CONF" 2>/dev/null | head -1; }

WIN_RED=$(leer_conf windows_red)          # //192.168.1.50/SALMI
WIN_CRED=$(leer_conf windows_credenciales) # archivo con usuario y clave
WIN_CRED="${WIN_CRED:-/etc/redhornoma/windows.credenciales}"
if [ -n "$WIN_RED" ]; then MODO=red; else MODO=virtual; fi

# Cuántas copias guarda cada centro, y cada cuánto las hace.
#
# Estaba escrito a fuego en el código, y no todos los centros trabajan igual:
# uno con pocos pacientes puede querer una copia diaria y un año de historia;
# otro, una cada dos días. Ahora se pone en respaldo.conf y punto.
#
# Cada valor se acepta solo si es un número: una errata que dejara «diarios=»
# vacío borraría todas las copias en el siguiente paso.
num_conf(){ V_=$(leer_conf "$1"); case "$V_" in ''|*[!0-9]*) echo "$2";; *) echo "$V_";; esac; }
DIARIOS=$(num_conf   diarios   "$DIARIOS")
SEMANALES=$(num_conf semanales "$SEMANALES")
MENSUALES=$(num_conf mensuales "$MENSUALES")
CADA_DIAS=$(num_conf cada_dias "$CADA_DIAS")

smb(){ smbclient "$WIN_RED" -A "$WIN_CRED" -t 30 -c "$*" 2>&1; }

# ── Congelar y descongelar, con la verdad por delante ─────────────────
# Nunca se cree lo que devuelve el comando: se pregunta el estado. Y el
# descongelado se reintenta hasta confirmarlo, porque un disco que se
# queda congelado deja Windows clavado.
estado_congelado(){
  $VIRSH qemu-agent-command --timeout 30 "$VM" '{"execute":"guest-fsfreeze-status"}' 2>/dev/null \
    | grep -oP '"return":"\K[a-z]+'
}
descongelar_seguro(){
  local i estado
  for i in 1 2 3 4 5; do
    estado=$(estado_congelado)
    [ "$estado" = "thawed" ] && return 0
    $VIRSH qemu-agent-command --timeout 60 "$VM" '{"execute":"guest-fsfreeze-thaw"}' >/dev/null 2>&1
    sleep 2
  done
  [ "$(estado_congelado)" = "thawed" ]
}

# ── Elegir la máquina ─────────────────────────────────────────────────
elegir_maquina(){
  [ -n "$VM" ] && return 0
  local encendidas n
  encendidas=$($VIRSH list --name 2>/dev/null | grep -v '^$')
  n=$(echo "$encendidas" | grep -c .)
  if   [ "$n" = "1" ]; then VM="$encendidas"
  elif [ "$n" = "0" ]; then
    mal "no hay ninguna máquina encendida"
    echo "      El respaldo se saca con la máquina en marcha, sin apagarla."
    return 1
  else
    mal "hay varias máquinas — elige una con --maquina"
    echo "$encendidas" | sed 's/^/         /'
    return 1
  fi
}

# ── Ejecutar un programa de Windows y recoger su salida ───────────────
# Se llama al programa directamente, con cada argumento aparte: al pasar
# por cmd.exe, una ruta con espacios pierde las comillas y falla.
prog_win(){
  local prog="$1"; shift
  local pet pid r
  pet=$(python3 -c '
import json,sys
print(json.dumps({"execute":"guest-exec","arguments":{
  "path":sys.argv[1],"arg":sys.argv[2:],"capture-output":True}}))' "$prog" "$@")
  pid=$(agente "$pet" | grep -oP '"pid":\K[0-9]+')
  [ -z "$pid" ] && return 1
  # Hasta minuto y medio: algunas consultas al registro tardan
  for _ in $(seq 1 90); do
    r=$(agente "{\"execute\":\"guest-exec-status\",\"arguments\":{\"pid\":$pid}}")
    echo "$r" | grep -q '"exited":true' && break
    sleep 1
  done
  python3 -c '
import json,sys,base64
d=json.loads(sys.stdin.read()).get("return",{})
for k in ("out-data","err-data"):
    if d.get(k): print(base64.b64decode(d[k]).decode("cp850","replace"))' <<< "$r" | tr -d '\r'
}

# ── ¿Existe este archivo dentro de Windows? ───────────────────────────
existe_en_win(){
  if [ "$MODO" = "red" ]; then
    # En red la carpeta compartida ES la de SALMI, así que solo interesa
    # el nombre del archivo, no la ruta entera de Windows.
    smb "ls $(basename "${1//\\//}")" | grep -qv 'NT_STATUS_NO_SUCH_FILE'
    return
  fi
  local h
  h=$(agente "$(python3 -c '
import json,sys
print(json.dumps({"execute":"guest-file-open","arguments":{"path":sys.argv[1],"mode":"rb"}}))' "$1")")
  local id; id=$(echo "$h" | grep -oP '"return":\K[0-9]+')
  [ -z "$id" ] && return 1
  agente "{\"execute\":\"guest-file-close\",\"arguments\":{\"handle\":$id}}" >/dev/null 2>&1
  return 0
}

# ── Encontrar dónde vive SALMI dentro de Windows ──────────────────────
# Se le pregunta a Windows dónde lo instaló, que es instantáneo y seguro.
# Rebuscar por todo el disco tarda minutos y el agente se cansa antes.
buscar_salmi(){
  if [ "$MODO" = "red" ]; then
    # La carpeta compartida apunta directamente a donde está SALMI
    smb 'ls bdSalmiDis.mdb' | grep -q 'bdSalmiDis' && { echo "$WIN_RED"; return 0; }
    return 1
  fi
  local ruta
  # 1) Lo que anotó el propio instalador
  ruta=$(prog_win reg.exe query \
         'HKLM\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall' \
         /s /f SALMI 2>/dev/null \
         | grep -i 'InstallLocation' | grep -oP 'REG_SZ\s+\K.*' \
         | sed 's/[[:space:]]*$//;s|\\$||' | head -1)
  if [ -n "$ruta" ] && existe_en_win "$ruta\\bdSalmiDis.mdb"; then
    echo "$ruta"; return 0
  fi
  # 2) Los sitios de siempre
  for r in 'C:\SALMI-PN_Dispensacion_BO' 'C:\SALMI' \
           'C:\Program Files (x86)\SALMI' 'C:\Program Files\SALMI'; do
    existe_en_win "$r\\bdSalmiDis.mdb" && { echo "$r"; return 0; }
  done
  return 1
}

# ── Sacar un archivo de dentro de Windows ─────────────────────────────
# Se lee en trozos y se comprueba el tamaño al final. Si algo se corta a
# medias, el archivo no se da por bueno.
sacar_archivo(){  # ruta_en_windows  destino_en_linux
  if [ "$MODO" = "red" ]; then
    local nombre; nombre=$(basename "${1//\\//}")
    rm -f "$2"
    smb "get $nombre \"$2\"" >/dev/null 2>&1
    [ -s "$2" ] && stat -c%s "$2" || return 1
    return 0
  fi
  python3 - "$VM" "$1" "$2" leer <<'PY'
import base64, json, sys, libvirt, libvirt_qemu

# Se habla con libvirt directamente, no llamando a «virsh» por cada
# trozo. Escribir así fallaba: el dato viajaba como argumento de un
# comando, y medio mega en texto supera con creces el límite del sistema
# para un solo argumento. Leer funcionaba porque el dato vuelve como
# salida, no como argumento — por eso el fallo solo se veía al escribir.
# Los tamaños NO son arbitrarios, están medidos contra este canal:
#   leer    512 KB  →  bien
#   escribir 64 KB  →  bien
#   escribir 256 KB →  el agente no contesta a tiempo y se cae
# El canal entre Linux y Windows es estrecho, y al escribir se llena
# antes. Subirlos «para ir más rápido» rompe el rescate.
vm, origen, destino, modo = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
con = libvirt.open("qemu:///system")
dom = con.lookupByName(vm)

def agente(orden):
    r = json.loads(libvirt_qemu.qemuAgentCommand(dom, json.dumps(orden), 60, 0))
    if "error" in r:
        raise RuntimeError(str(r["error"])[:150])
    return r["return"]

if modo == "leer":
    h = agente({"execute": "guest-file-open",
                "arguments": {"path": origen, "mode": "rb"}})
    try:
        total = 0
        with open(destino, "wb") as f:
            while True:
                r = agente({"execute": "guest-file-read",
                            "arguments": {"handle": h, "count": 524288}})
                datos = base64.b64decode(r.get("buf-b64", ""))
                if datos:
                    f.write(datos); total += len(datos)
                if r.get("eof") or not datos:
                    break
        print(total)
    finally:
        try: agente({"execute": "guest-file-close", "arguments": {"handle": h}})
        except Exception: pass
else:
    # origen es el archivo de Linux, destino la ruta dentro de Windows
    h = agente({"execute": "guest-file-open",
                "arguments": {"path": destino, "mode": "wb"}})
    try:
        total = 0
        with open(origen, "rb") as f:
            while True:
                trozo = f.read(65536)
                if not trozo:
                    break
                r = agente({"execute": "guest-file-write",
                            "arguments": {"handle": h,
                                          "buf-b64": base64.b64encode(trozo).decode()}})
                total += r.get("count", 0)
        print(total)
    finally:
        try: agente({"execute": "guest-file-close", "arguments": {"handle": h}})
        except Exception: pass
PY
}

# ── Abrir la base y contar lo que hay dentro ──────────────────────────
# Que el archivo exista y pese algo no significa nada. Aquí se abre de
# verdad, se cuentan las tablas y los registros, y se mira lo que a un
# centro de salud le importa: cuántos pacientes y cuántas prestaciones.
#
# Tarda un segundo. Por eso se hace después de CADA respaldo y no una vez
# por semana: sale gratis.
HISTORIAL="$BASE/verificacion.tsv"

# ¿Esto es el equipo del centro, o una instalación limpia?
#
# Un centro en funcionamiento no tiene menos de diez pacientes y menos de
# diez prestaciones. Cuando aparece eso, casi siempre se está respaldando
# la máquina equivocada: una recién instalada, o una de pruebas.
#
# Vive aquí, en una función, y no suelta dentro del respaldo, porque el
# 09/08/2026 se descubrió que solo la hacía «--ahora» y NO «--verificar».
# El registro del portátil lo enseñaba entero:
#
#     07:01   SIN CONFIRMAR: 2026-08-09_0701
#     07:05   verificado correcto: 2026-08-09_0701     ← la misma carpeta
#
# Un respaldo rechazado al hacerlo quedaba APROBADO al verificarlo. Y
# «--verificar» era justo lo que el panel mandaba escribir, así que el
# propio consejo del panel blanqueaba respaldos malos. Con la marca puesta,
# el panel lo enseña en verde y --rescatar restauraría desde él.
#
# Una comprobación que no está en todos los caminos no es una comprobación.
base_casi_vacia(){  # pacientes prestaciones → 0 si lo está
  [ "${1:-0}" -lt 10 ] && [ "${2:-0}" -lt 10 ]
}

avisar_base_vacia(){  # pacientes prestaciones
  mal "ESTA BASE ESTÁ PRÁCTICAMENTE VACÍA: $1 pacientes, $2 prestaciones"
  echo "      Un centro en funcionamiento tiene miles de los dos."
  echo "      Lo más probable es que esta máquina no sea la que guarda"
  echo "      la información del centro, sino una instalación limpia."
}

analizar_base(){  # archivo  →  "tablas registros pacientes prestaciones"
  local f="$1" tablas=0 total=0 pac=0 pres=0 n
  command -v mdb-tables >/dev/null 2>&1 || { echo "0 0 0 0"; return 1; }
  while read -r t; do
    [ -z "$t" ] && continue
    tablas=$((tablas+1))
    n=$(timeout 30 mdb-count "$f" "$t" 2>/dev/null | grep -oP '^\s*\K[0-9]+' | head -1)
    n=${n:-0}
    total=$((total+n))
    case "$t" in
      TblPacientes)     pac=$n ;;
      TblPrestaciones)  pres=$n ;;
    esac
  done < <(timeout 60 mdb-tables -1 "$f" 2>/dev/null)
  echo "$tablas $total $pac $pres"
}

# ── Comparar con la vez anterior ──────────────────────────────────────
# La información de un centro solo crece. Si baja, algo pasó: alguien
# borró, una restauración salió mal, o el archivo se está corrompiendo.
# Enterarse el mismo día es la diferencia entre un susto y un desastre.
comparar_con_anterior(){  # tablas registros pacientes prestaciones
  local t="$1" r="$2" p="$3" pr="$4"
  local ant_t ant_r ant_p ant_pr linea
  [ -f "$HISTORIAL" ] || return 0
  linea=$(grep -v '^#' "$HISTORIAL" | tail -1)
  [ -n "$linea" ] || return 0
  read -r _ _ ant_t ant_r ant_p ant_pr <<< "$linea"
  local aviso=0
  if [ "${ant_p:-0}" -gt 0 ] && [ "$p" -lt "$ant_p" ]; then
    mal "HAY MENOS PACIENTES QUE LA VEZ ANTERIOR: $p, antes $ant_p"; aviso=1
  fi
  if [ "${ant_pr:-0}" -gt 0 ] && [ "$pr" -lt "$ant_pr" ]; then
    mal "HAY MENOS PRESTACIONES QUE LA VEZ ANTERIOR: $pr, antes $ant_pr"; aviso=1
  fi
  if [ "${ant_t:-0}" -gt 0 ] && [ "$t" -lt "$ant_t" ]; then
    mal "FALTAN TABLAS: $t, antes $ant_t"; aviso=1
  fi
  if [ "$aviso" = "1" ]; then
    echo
    echo "      Esto NO es un fallo del respaldo: el respaldo copió bien lo"
    echo "      que había. Es la información la que tiene menos que antes."
    echo
    echo "      Alguien pudo borrar registros, o una restauración pudo"
    echo "      devolver una versión vieja. ${AM}Míralo hoy mismo${V}: los"
    echo "      respaldos anteriores siguen guardados y aún se puede volver."
    echo
    anota "ALERTA: la información bajó — pacientes $ant_p→$p, prestaciones $ant_pr→$pr"
    return 1
  fi
  return 0
}

# ── Meter un archivo DENTRO de Windows ────────────────────────────────
# El camino de vuelta: se escribe por trozos a través del agente, igual
# que se saca. Sin pendrives, sin que nadie abra nada.
meter_archivo(){  # origen_en_linux  ruta_en_windows
  if [ "$MODO" = "red" ]; then
    local nombre; nombre=$(basename "${2//\\//}")
    smb "put \"$1\" $nombre" | grep -qiE 'putting file|kb/s' && stat -c%s "$1" || return 1
    return 0
  fi
  # Misma maquinaria que sacar_archivo, en sentido contrario
  python3 - "$VM" "$1" "$2" escribir <<'PY'
import base64, json, sys, libvirt, libvirt_qemu
vm, origen, destino, modo = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
con = libvirt.open("qemu:///system")
dom = con.lookupByName(vm)

def agente(orden):
    r = json.loads(libvirt_qemu.qemuAgentCommand(dom, json.dumps(orden), 60, 0))
    if "error" in r:
        raise RuntimeError(str(r["error"])[:150])
    return r["return"]

h = agente({"execute": "guest-file-open",
            "arguments": {"path": destino, "mode": "wb"}})
try:
    total = 0
    with open(origen, "rb") as f:
        while True:
            trozo = f.read(65536)
            if not trozo:
                break
            r = agente({"execute": "guest-file-write",
                        "arguments": {"handle": h,
                                      "buf-b64": base64.b64encode(trozo).decode()}})
            total += r.get("count", 0)
    print(total)
finally:
    try: agente({"execute": "guest-file-close", "arguments": {"handle": h}})
    except Exception: pass
PY
}

# ── ¿Está SALMI abierto en este momento? ──────────────────────────────
# Escribir sobre su base de datos mientras la tiene abierta la corrompe.
salmi_abierto(){
  if [ "$MODO" = "red" ]; then
    # Sin agente no se puede mirar qué programas corren. Pero Access deja
    # un archivo .ldb junto a la base mientras alguien la tiene abierta:
    # eso dice lo mismo y basta.
    smb 'ls *.ldb' | grep -qi '\.ldb'
    return
  fi
  prog_win tasklist.exe /fi "imagename eq SalmiDis.exe" 2>/dev/null \
    | grep -qi 'SalmiDis.exe'
}

# ── ¿Es un archivo de Access de verdad? ───────────────────────────────
# No basta con que exista y pese algo: se mira su firma. Un archivo
# cortado a medias tiene el tamaño casi bien y no sirve para nada.
# ── ¿Este paquete abre de verdad? ─────────────────────────────────────
# Un .zip a medio escribir ocupa sitio, tiene fecha de hoy y parece un
# respaldo. Solo se distingue de uno bueno intentando abrirlo. Se prueba
# con «unzip» si está, y si no con Python, que ya hace falta para hablar
# con el agente invitado.
zip_entero(){  # archivo
  [ -s "$1" ] || return 1
  if command -v unzip >/dev/null 2>&1; then
    unzip -t -q "$1" >/dev/null 2>&1
  else
    python3 - "$1" <<'PY' >/dev/null 2>&1
import sys, zipfile
try:
    with zipfile.ZipFile(sys.argv[1]) as z:
        sys.exit(1 if z.testzip() is not None else 0)
except Exception:
    sys.exit(1)
PY
  fi
}

es_base_valida(){
  [ -s "$1" ] || return 1
  head -c 30 "$1" | grep -q 'Standard Jet DB\|Standard ACE DB'
}

# ═════════════════════════════════════════════════════════════════════
#  MIRAR
# ═════════════════════════════════════════════════════════════════════
if [ "$ACCION" = "mirar" ]; then
  titulo "RESPALDOS DE LA INFORMACIÓN DEL CENTRO"

  if [ ! -d "$DESTINO" ] || [ -z "$(ls -A "$DESTINO" 2>/dev/null)" ]; then
    avi "todavía no hay ningún respaldo"
    echo
    echo "      La información de un centro de salud no se puede volver a"
    echo "      escribir. Si se pierde, se perdió."
    echo
    printf "      ${AZ}sudo redhornoma-respaldo --ahora${V}       hacer uno ahora\n"
    printf "      ${AZ}sudo redhornoma-respaldo --programar${V}   cada noche, solo\n\n"
    exit 0
  fi

  N=$(find "$DESTINO" -maxdepth 1 -type d -name '20*' | wc -l)
  ULT=$(find "$DESTINO" -maxdepth 1 -type d -name '20*' | sort | tail -1)
  d "Respaldos guardados:" "$N"
  if [ -n "$ULT" ]; then
    d "El último:" "$(basename "$ULT")"
    d "Ocupa:" "$(du -sh "$ULT" 2>/dev/null | cut -f1)"
    HORAS=$(( ( $(date +%s) - $(stat -c %Y "$ULT") ) / 3600 ))
    if   [ "$HORAS" -lt 26 ]; then ok "hecho hace $HORAS horas"
    elif [ "$HORAS" -lt 72 ]; then avi "hecho hace $HORAS horas"
    else mal "hecho hace $((HORAS/24)) días — demasiado tiempo"; fi
  fi
  d "Ocupan en total:" "$(du -sh "$DESTINO" 2>/dev/null | cut -f1)"

  echo
  printf "   ${AZ}Los últimos${V}\n"
  find "$DESTINO" -maxdepth 1 -type d -name '20*' | sort -r | head -6 | while read -r c; do
    printf "      %-22s %8s   %s\n" "$(basename "$c")" \
      "$(du -sh "$c" 2>/dev/null | cut -f1)" \
      "$([ -f "$c/CORRECTO" ] && echo '✅ verificado' || echo '')"
  done

  echo
  if systemctl is-enabled redhornoma-respaldo.timer >/dev/null 2>&1 ||
     [ -f /etc/cron.d/redhornoma-respaldo ]; then
    ok "programado: se hace solo, y se recupera si el equipo estaba apagado"
  else
    avi "NO está programado — hay que acordarse a mano"
    printf "         ${AZ}sudo redhornoma-respaldo --programar${V}\n"
  fi
  echo
  exit 0
fi

# ═════════════════════════════════════════════════════════════════════
#  QUE EL WINDOWS SE HAGA SUS PROPIAS COPIAS DE SOAPS Y SNIS
# ═════════════════════════════════════════════════════════════════════
# SALMI lo saca este guion desde fuera, porque sus archivos están siempre
# en el mismo sitio y se pueden copiar con el disco congelado. SOAPS no:
# vive en un SQL Server que tiene sus bases abiertas, y copiar esos
# archivos da una copia rota. Hay que PEDIRLE al motor que haga el
# respaldo, y eso solo se puede hacer desde dentro de Windows.
#
# Así que se deja allí un guion y una tarea que lo ejecuta cada día. El
# paquete que genera cae en la carpeta compartida, que ya es un directorio
# de este Linux: recogerlo no cuesta ni una transferencia.
if [ "$ACCION" = "preparar_programas" ]; then
  titulo "QUE EL WINDOWS RESPALDE SOAPS Y SNIS SOLO"
  [ "$(id -u)" = "0" ] || { mal "hace falta sudo"; exit 1; }

  GUION_LOCAL=/usr/share/redhornoma/windows/respaldo-programas.ps1
  [ -f "$GUION_LOCAL" ] || { mal "falta $GUION_LOCAL"; exit 1; }

  # Un Windows que ya estaba en el centro no es una máquina virtual: no
  # tiene agente invitado, y desde aquí no se le puede pedir nada. Ahí hay
  # que ir una vez con el ratón. Decirlo claro es mejor que fallar raro.
  if [ "$MODO" = "red" ]; then
    avi "ese Windows no es una máquina virtual de este equipo"
    echo "      Sin agente invitado no se puede preparar desde fuera."
    echo
    echo "      Hay que hacerlo UNA VEZ en esa computadora:"
    echo
    echo "      1) Copiar allí este archivo, a C:\\ProgramData\\RedHornoma\\ :"
    echo "            $GUION_LOCAL"
    echo "      2) Abrir el Símbolo del sistema COMO ADMINISTRADOR y pegar:"
    echo
    echo "            schtasks /Create /F /TN \"RedHornoma - Respaldo de programas\" ^"
    echo "              /SC DAILY /ST 02:00 /RU SYSTEM /RL HIGHEST ^"
    echo "              /TR \"powershell.exe -ExecutionPolicy Bypass -NonInteractive -File C:\\ProgramData\\RedHornoma\\respaldo-programas.ps1\""
    echo
    echo "      3) Probarla sin esperar a mañana:"
    echo "            schtasks /Run /TN \"RedHornoma - Respaldo de programas\""
    echo
    echo "      El paquete queda en C:\\RESPALDOS. Para que este equipo lo"
    echo "      recoja, en /var/lib/redhornoma/respaldo.conf:"
    echo "            windows_extra=$WIN_RED"
    echo "            windows_extra_carpeta=RESPALDOS"
    echo
    exit 1
  fi

  elegir_maquina || exit 1
  ok "máquina: $VM"
  agente '{"execute":"guest-ping"}' | grep -q "return" \
    || { mal "el agente invitado de «$VM» no contesta"
         echo "      Sin él no se puede preparar nada desde fuera."; exit 1; }
  ok "el agente invitado contesta"

  DESTINO_WIN='C:\ProgramData\RedHornoma'
  TAREA="RedHornoma - Respaldo de programas"

  printf "   %-30s " "dejando el guion dentro"
  prog_win powershell.exe -NoProfile -Command \
    "New-Item -ItemType Directory -Path '$DESTINO_WIN' -Force | Out-Null" >/dev/null 2>&1
  if meter_archivo "$GUION_LOCAL" "$DESTINO_WIN\\respaldo-programas.ps1" >/dev/null 2>&1; then
    printf "${VE}hecho${V}\n"
  else
    printf "${RO}falló${V}\n"; mal "no se pudo escribir dentro de Windows"; exit 1
  fi

  # A las 2 de la madrugada: el centro está cerrado, nadie tiene SOAPS ni
  # SNIS abiertos, y a esa hora la copia de Access sale entera.
  # SYSTEM puede pedirle el respaldo a SQL Server, que es lo que hace falta.
  printf "   %-30s " "programando la tarea diaria"
  SALIDA=$(prog_win schtasks.exe /Create /F /TN "$TAREA" /SC DAILY /ST 02:00 \
             /RU SYSTEM /RL HIGHEST \
             /TR "powershell.exe -ExecutionPolicy Bypass -NonInteractive -File $DESTINO_WIN\\respaldo-programas.ps1" 2>&1)
  if printf '%s' "$SALIDA" | grep -qiE "correctamente|SUCCESS"; then
    printf "${VE}hecho${V}\n"
  else
    printf "${RO}falló${V}\n"
    printf '%s\n' "$SALIDA" | sed 's/^/      /'
    mal "no se pudo programar la tarea"; exit 1
  fi

  # ── Que se recupere de un apagón ────────────────────────────────────
  # Un centro de salud APAGA las computadoras por la noche. Si a las 2 de
  # la madrugada el servidor está apagado, una tarea diaria normal se salta
  # esa copia y no vuelve a intentarlo: al día siguiente espera otra vez a
  # las 2, y así.
  #
  # El respaldo de Linux ya tenía esto resuelto desde el principio —mira
  # arriba, donde se explica CADA_DIAS— y al programar la de Windows se me
  # pasó aplicar la misma lección. Se vio el 08/08/2026, con el servidor
  # apagado un sábado por la tarde.
  #
  # «StartWhenAvailable» le dice a Windows: si te perdiste la hora, hazlo
  # en cuanto puedas. Con eso, la copia se hace al primer encendido.
  #
  # schtasks no sabe poner esa opción; hay que tocarla después. Y se
  # COMPRUEBA leyéndola de vuelta: dar por hecho que se aplicó sería
  # exactamente el verde falso que este proyecto no se permite.
  printf "   %-30s " "que se recupere de un apagón"
  AJUSTE=$(prog_win powershell.exe -NoProfile -Command \
    "\$t = Get-ScheduledTask -TaskName '$TAREA' -ErrorAction Stop;
     \$t.Settings.StartWhenAvailable = \$true;
     Set-ScheduledTask -InputObject \$t | Out-Null;
     (Get-ScheduledTask -TaskName '$TAREA').Settings.StartWhenAvailable" 2>&1)
  if printf '%s' "$AJUSTE" | grep -qi "true"; then
    printf "${VE}hecho${V}\n"
    nota "si el servidor está apagado a las 2, la copia se hará al encenderlo"
  else
    printf "${AM}no se pudo${V}\n"
    avi "la tarea quedó puesta, pero SIN recuperarse de un apagón"
    echo "      Si el servidor está apagado a las 2 de la madrugada, esa noche"
    echo "      no habrá copia de SOAPS ni de SNIS. El respaldo diario avisa"
    echo "      cuando el paquete pasa de dos días, así que no será silencioso."
    echo "      Para ponerlo a mano, dentro de Windows y como administrador:"
    echo "         Programador de tareas → «$TAREA» → Propiedades →"
    echo "         Condiciones → «Ejecutar la tarea lo antes posible tras un"
    echo "         inicio programado que no se realizó»"
    anota "AVISO: la tarea de respaldo de programas no se recupera de un apagón"
  fi

  # Probarla ahora mismo. Programar algo y no verlo funcionar es
  # exactamente el error que nos trajo hasta aquí.
  printf "\n   ${AZ}Probándola ahora, sin esperar a mañana${V}\n"
  prog_win schtasks.exe /Run /TN "$TAREA" >/dev/null 2>&1
  printf "   %-30s " "esperando a que termine"
  CARP=$(leer_conf programas_carpeta)
  [ -z "$CARP" ] && CARP=/var/lib/libvirt/compartido/RESPALDOS
  DESDE=$(date +%s)
  LOGRADO=0
  for _ in $(seq 1 40); do   # hasta 10 minutos
    sleep 15
    NUEVO=$(ls -1t "$CARP"/programas-*.zip 2>/dev/null | head -1)
    # Tiene que ser NUEVO, no el de ayer: si no, diríamos que funcionó
    # enseñando el paquete de otro día. Eso es un verde falso.
    [ -n "$NUEVO" ] && [ "$(stat -c %Y "$NUEVO")" -ge "$DESDE" ] || continue

    # Y tiene que estar TERMINADO. La primera versión de esto anunciaba
    # «14M» cuando el archivo acabó pesando 36: lo pilló a medio comprimir
    # y dio por bueno un paquete que aún se estaba escribiendo. Se espera a
    # que el tamaño deje de crecer, y luego se comprueba que abre.
    T1=$(stat -c %s "$NUEVO"); sleep 5; T2=$(stat -c %s "$NUEVO")
    [ "$T1" = "$T2" ] || continue
    LOGRADO=1; break
  done
  if [ "$LOGRADO" = "1" ] && zip_entero "$NUEVO"; then
    printf "${VE}hecho${V}\n"
    ok "generó $(basename "$NUEVO") ($(du -h "$NUEVO" | cut -f1)), y abre bien"
  elif [ "$LOGRADO" = "1" ]; then
    printf "${RO}a medias${V}\n"
    mal "el paquete $(basename "$NUEVO") NO abre: está incompleto o roto"
    echo "      No cuentes con esa copia. Vuelve a lanzarla con:"
    echo "         schtasks /Run /TN \"$TAREA\"   (dentro de Windows)"
    anota "FALLÓ: el paquete de SOAPS/SNIS no abre"
    echo; exit 1
  fi
  if [ "$LOGRADO" = "1" ]; then
    case "$(basename "$NUEVO")" in
      *CON-AVISOS*) avi "pero lo marcó CON AVISOS: mira el PARTE.txt de dentro" ;;
    esac
    echo
    ok "listo: cada noche a las 2 el Windows dejará su copia de SOAPS y SNIS"
    echo "      y este guion la recogerá en el respaldo del día."
  else
    printf "${RO}sin señales${V}\n"
    avi "la tarea quedó programada, pero no vi aparecer el paquete"
    echo "      Míralo mañana con: redhornoma-respaldo --verificar"
    echo "      O a mano, dentro de Windows:"
    echo "         schtasks /Run /TN \"RedHornoma - Respaldo de programas\""
  fi
  echo
  exit 0
fi

# ═════════════════════════════════════════════════════════════════════
#  PROGRAMAR
# ═════════════════════════════════════════════════════════════════════
if [ "$ACCION" = "programar" ]; then
  titulo "QUE EL RESPALDO SE HAGA SOLO"
  [ "$(id -u)" = "0" ] || { mal "hace falta sudo"; exit 1; }

  # Un centro de salud atiende de 8 a 14 y después apaga las computadoras.
  # Programarlo de madrugada —lo que se hace en una oficina— significa que
  # NO SE HACE NUNCA, y nadie se entera durante meses.
  #
  # Por eso: poco antes de cerrar, cuando el día ya está registrado. Y si
  # ese día la computadora se apagó antes, se hace en cuanto se encienda
  # la próxima vez. Ningún día se queda sin copia.
  HORA=${HORA:-13:30}

  # El servicio tiene que llamar al programa que EXISTE, no a uno supuesto.
  #
  # El 2026-07-30 se programó aquí una unidad con la ruta /usr/bin escrita a
  # mano, mientras el programa vivía en la carpeta del proyecto. El
  # temporizador se disparaba cada día, el servicio no encontraba nada y no
  # pasaba nada. Dos días sin respaldo y ni un solo aviso.
  PROGRAMA=$(readlink -f "$0")
  [ -x "$PROGRAMA" ] || { mal "no encuentro el propio programa en «$PROGRAMA»"; exit 1; }

  if [ "$PROGRAMA" != "/usr/bin/redhornoma-respaldo" ]; then
    avi "se programará «$PROGRAMA»"
    echo "      No es la ruta del paquete. Funciona, pero si esa carpeta se"
    echo "      mueve o se borra, el respaldo deja de hacerse EN SILENCIO."
    echo
    echo "      Lo correcto es instalar el paquete y programar desde ahí:"
    printf "         ${AZ}sudo apt install ./redhornoma-respaldo_*.deb${V}\n"
    echo
  fi

  cat > /etc/systemd/system/redhornoma-respaldo.service <<UNIDAD
[Unit]
Description=Respaldo de la información del centro
After=libvirtd.service network-online.target

[Service]
Type=oneshot
ExecStart=$PROGRAMA --silencioso
UNIDAD

  cat > /etc/systemd/system/redhornoma-respaldo.timer <<UNIDAD
[Unit]
Description=Respaldo diario, antes de cerrar el centro

[Timer]
# Poco antes de terminar la jornada, con el día ya registrado
OnCalendar=*-*-* $HORA:00
# Si ese día la computadora estaba apagada a esa hora, se hace en
# cuanto se encienda. Esto es lo que salva a un centro que cierra a las 14.
Persistent=true
# Un rato después de arrancar, para dar tiempo a que Windows despierte
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
UNIDAD

  rm -f /etc/cron.d/redhornoma-respaldo 2>/dev/null
  systemctl daemon-reload
  systemctl enable --now redhornoma-respaldo.timer >/dev/null 2>&1

  if systemctl is-enabled redhornoma-respaldo.timer >/dev/null 2>&1; then
    ok "programado para las $HORA de cada día"
    ok "y si ese día estaba apagada, se hace al encenderla"
  else
    mal "no se pudo programar"; exit 1
  fi

  # Preguntarle a systemd qué va a ejecutar de verdad, en vez de dar por
  # hecho que escribió lo que le pedimos. Programar algo que no se puede
  # ejecutar es peor que no programar nada: parece resuelto y no lo está.
  EXEC=$(systemctl show -p ExecStart --value redhornoma-respaldo.service 2>/dev/null \
         | grep -oP 'path=\K[^ ;]+' | head -1)
  if [ -n "$EXEC" ] && [ -x "$EXEC" ]; then
    ok "systemd ejecutará: $EXEC"
  else
    mal "systemd no puede ejecutar «${EXEC:-nada}» — el respaldo NO se hará"
    echo "      Esto es exactamente el fallo que dejó dos días sin copia."
    exit 1
  fi

  echo
  printf "   ${AZ}Por qué a las %s y no de madrugada${V}\n\n" "$HORA"
  cat <<POR
      El centro atiende de 8 a 14 y después se apagan las máquinas.
      Un respaldo de madrugada no se haría nunca, y nadie lo notaría
      hasta el día que hiciera falta.

      A las $HORA el día ya está registrado y la computadora sigue
      encendida. Y si algún día se apaga antes, la copia se hace en
      cuanto vuelva a encenderse.

POR
  printf "   Próxima vez:  %s\n" "$(systemctl list-timers redhornoma-respaldo.timer --no-pager 2>/dev/null | awk 'NR==2{print $1" "$2" "$3}')"
  echo
  printf "      Cambiar la hora:  ${AZ}sudo HORA=12:45 redhornoma-respaldo --programar${V}\n"
  printf "      Quitarlo:         ${AM}sudo systemctl disable --now redhornoma-respaldo.timer${V}\n\n"
  anota "programado a las $HORA, con recuperación al encender"
  exit 0
fi

# ═════════════════════════════════════════════════════════════════════
#  VERIFICAR
# ═════════════════════════════════════════════════════════════════════
if [ "$ACCION" = "verificar" ]; then
  titulo "COMPROBAR QUE EL ÚLTIMO RESPALDO SIRVE"
  ULT=$(find "$DESTINO" -maxdepth 1 -type d -name '20*' 2>/dev/null | sort | tail -1)
  [ -n "$ULT" ] || { mal "no hay ningún respaldo que comprobar"; exit 1; }
  d "Comprobando:" "$(basename "$ULT")"
  echo
  BIEN=1
  for f in "$ULT"/*.sal "$ULT"/*.mdb; do
    [ -e "$f" ] || continue
    if es_base_valida "$f"; then
      ok "$(basename "$f")  —  $(du -h "$f" | cut -f1)"
    else
      mal "$(basename "$f")  —  no es una base de datos válida"
      BIEN=0
    fi
  done

  PRINCIPAL=$(ls "$ULT"/*.sal 2>/dev/null | head -1)
  if [ -n "$PRINCIPAL" ] && command -v mdb-tables >/dev/null 2>&1; then
    printf "\n   ${AZ}Abriendo la base de datos${V}\n"
    read -r N_TABLAS N_REG N_PAC N_PRES <<< "$(analizar_base "$PRINCIPAL")"
    if [ "${N_TABLAS:-0}" -gt 0 ]; then
      ok "se abre correctamente"
      d "Tablas:" "$N_TABLAS"
      d "Registros en total:" "$N_REG"
      d "Pacientes:" "$N_PAC"
      d "Prestaciones:" "$N_PRES"
      echo
      # La misma comprobación que al hacer el respaldo, y por el mismo
      # motivo. Sin esto, verificar era una segunda oportunidad para que
      # colara lo que ya se había rechazado una vez.
      if base_casi_vacia "${N_PAC:-0}" "${N_PRES:-0}"; then
        avisar_base_vacia "$N_PAC" "$N_PRES"
        BIEN=0
      fi
      comparar_con_anterior "$N_TABLAS" "$N_REG" "$N_PAC" "$N_PRES" \
        && ok "la información no ha menguado desde la vez anterior" || BIEN=0
    else
      mal "no se pudo abrir como base de datos"; BIEN=0
    fi
  else
    avi "falta mdbtools: solo se pudo comprobar la firma"
    echo "         sudo apt install mdbtools"
  fi

  # Cómo ha ido creciendo la información del centro
  if [ -f "$HISTORIAL" ] && [ "$(grep -cv '^#' "$HISTORIAL")" -gt 1 ]; then
    printf "\n   ${AZ}Cómo ha ido creciendo${V}\n\n"
    printf "      %-18s %10s %14s\n" "FECHA" "PACIENTES" "PRESTACIONES"
    grep -v '^#' "$HISTORIAL" | tail -6 | while read -r f _ _ _ p pr; do
      printf "      %-18s %10s %14s\n" "$f" "$p" "$pr"
    done
  fi

  echo
  if [ "$BIEN" = "1" ]; then
    touch "$ULT/CORRECTO"
    ok "EL RESPALDO SIRVE"
    anota "verificado correcto: $(basename "$ULT")"
  else
    mal "ESTE RESPALDO NO ESTÁ CONFIRMADO"
    anota "VERIFICACIÓN FALLIDA: $(basename "$ULT")"
    exit 1
  fi
  exit 0
fi

# ═════════════════════════════════════════════════════════════════════
#  RESCATAR — devolver un respaldo a Windows
# ═════════════════════════════════════════════════════════════════════
if [ "$ACCION" = "rescatar" ]; then
  titulo "DEVOLVER UN RESPALDO A WINDOWS"
  [ "$(id -u)" = "0" ] || { mal "hace falta sudo"; exit 1; }

  # ── Cuál ────────────────────────────────────────────────────────────
  if [ -z "$CUAL" ]; then
    echo
    echo "   Respaldos guardados, del más nuevo al más viejo:"
    echo
    printf "      %-20s %10s %10s %14s\n" "CUÁNDO" "TAMAÑO" "PACIENTES" "PRESTACIONES"
    find "$DESTINO" -maxdepth 1 -type d -name '20*' 2>/dev/null | sort -r | head -12 | while read -r c; do
      N=$(basename "$c")
      DAT=$(grep -P "\t$N\t" "$HISTORIAL" 2>/dev/null | tail -1)
      P=$(echo "$DAT" | cut -f5); PR=$(echo "$DAT" | cut -f6)
      printf "      %-20s %10s %10s %14s  %s\n" "$N" \
        "$(du -sh "$c" 2>/dev/null | cut -f1)" "${P:-?}" "${PR:-?}" \
        "$([ -f "$c/CORRECTO" ] && echo '✅')"
    done
    echo
    printf "   Escribe la fecha del que quieres devolver: "
    read -r CUAL
  fi

  ORIGEN="$DESTINO/$CUAL"
  [ -d "$ORIGEN" ] || { mal "no encuentro el respaldo «$CUAL»"; exit 1; }
  SAL=$(ls "$ORIGEN"/*.sal 2>/dev/null | head -1)
  [ -n "$SAL" ] || { mal "ese respaldo no tiene el archivo principal"; exit 1; }

  # ── Comprobarlo ANTES de tocar nada ─────────────────────────────────
  printf "\n   ${AZ}Comprobando el respaldo antes de usarlo${V}\n"
  es_base_valida "$SAL" || { mal "ese respaldo no es una base de datos válida"; exit 1; }
  read -r R_TAB R_REG R_PAC R_PRES <<< "$(analizar_base "$SAL")"
  [ "${R_TAB:-0}" -gt 0 ] || { mal "ese respaldo no se puede abrir"; exit 1; }
  ok "se abre: $R_TAB tablas, $R_PAC pacientes, $R_PRES prestaciones"

  elegir_maquina || exit 1
  agente '{"execute":"guest-info"}' >/dev/null 2>&1 || { mal "el agente no responde"; exit 1; }
  CARPETA=$(buscar_salmi) || { mal "no encuentro SALMI en esa máquina"; exit 1; }
  ok "SALMI está en: $CARPETA"

  # ── Qué hay ahora, para que se vea lo que se pierde ─────────────────
  printf "\n   ${AZ}Comparando con lo que hay ahora${V}\n"
  AHORA="/tmp/redhornoma-actual-$$.mdb"
  if sacar_archivo "$CARPETA\\bdSalmiDis.mdb" "$AHORA" >/dev/null 2>&1 \
     && es_base_valida "$AHORA"; then
    read -r A_TAB A_REG A_PAC A_PRES <<< "$(analizar_base "$AHORA")"
    printf "\n      %-16s %12s %14s\n" "" "PACIENTES" "PRESTACIONES"
    printf "      %-16s %12s %14s\n" "ahora en Windows" "$A_PAC" "$A_PRES"
    printf "      %-16s %12s %14s\n" "el respaldo" "$R_PAC" "$R_PRES"
    echo
    if [ "${A_PAC:-0}" -gt "${R_PAC:-0}" ]; then
      avi "el respaldo tiene MENOS pacientes que lo que hay ahora"
      echo "         Se perderían $(( A_PAC - R_PAC )) pacientes y"
      echo "         $(( A_PRES - R_PRES )) prestaciones registradas después."
    else
      ok "el respaldo está igual o más completo que lo que hay ahora"
    fi
  else
    avi "no se pudo leer lo que hay ahora en Windows para comparar"
  fi
  rm -f "$AHORA"

  # ── SALMI no puede estar abierto ────────────────────────────────────
  if salmi_abierto; then
    echo
    mal "SALMI ESTÁ ABIERTO en ese Windows"
    echo "      Escribir sobre su base de datos mientras la tiene abierta"
    echo "      la corrompe. Ciérralo y vuelve a intentarlo."
    exit 1
  fi
  ok "SALMI está cerrado"

  # ── Confirmación explícita ──────────────────────────────────────────
  if [ "$CONFIRMADO" != "1" ]; then
    cat <<AVISO

   ${RO}════════════════════════════════════════════════${V}
   ${RO} ESTO REEMPLAZA LA INFORMACIÓN QUE HAY AHORA${V}
   ${RO}════════════════════════════════════════════════${V}

      Se va a escribir el respaldo del ${AZ}$CUAL${V} sobre la base de
      datos que Windows está usando.

      Antes se guardará una copia de lo actual, así que se puede
      volver atrás. Pero conviene estar seguro.

AVISO
    printf "   Para continuar escribe exactamente  ${AZ}RESCATAR${V}  y pulsa Enter: "
    read -r R
    [ "$R" = "RESCATAR" ] || { echo; echo "   Cancelado. No se tocó nada."; exit 0; }
  fi

  # ── Guardar lo actual antes de pisarlo ──────────────────────────────
  printf "\n   ${AZ}Guardando lo que hay ahora, por si acaso${V}\n"
  SEGURO="$DESTINO/antes-del-rescate-$(date '+%Y-%m-%d_%H%M')"
  mkdir -p "$SEGURO"
  for a in bdSalmiDis.mdb bdPrescripcion.mdb bdExterna.mdb; do
    sacar_archivo "$CARPETA\\$a" "$SEGURO/$a" >/dev/null 2>&1 && printf "      %s\n" "$a"
  done
  ok "guardado en $SEGURO"

  # ── Devolver los archivos ───────────────────────────────────────────
  printf "\n   ${AZ}Devolviendo el respaldo a Windows${V}\n"
  PUESTOS=0
  for par in "$SAL:bdSalmiDis.mdb" \
             "$ORIGEN/bdPrescripcion.mdb:bdPrescripcion.mdb" \
             "$ORIGEN/bdExterna.mdb:bdExterna.mdb"; do
    F="${par%%:*}"; DEST="${par##*:}"
    [ -f "$F" ] || continue
    printf "      %-22s " "$DEST"
    if meter_archivo "$F" "$CARPETA\\$DEST" >/dev/null 2>&1; then
      printf "${VE}hecho${V}\n"; PUESTOS=$((PUESTOS+1))
    else
      printf "${RO}falló${V}\n"
    fi
  done

  # ── Comprobar que quedó bien ────────────────────────────────────────
  printf "\n   ${AZ}Comprobando lo que quedó dentro${V}\n"
  COMP="/tmp/redhornoma-comp-$$.mdb"
  if sacar_archivo "$CARPETA\\bdSalmiDis.mdb" "$COMP" >/dev/null 2>&1 \
     && es_base_valida "$COMP"; then
    read -r C_TAB C_REG C_PAC C_PRES <<< "$(analizar_base "$COMP")"
    if [ "$C_PAC" = "$R_PAC" ] && [ "$C_PRES" = "$R_PRES" ]; then
      ok "coincide con el respaldo: $C_PAC pacientes, $C_PRES prestaciones"
    else
      mal "lo que quedó dentro NO coincide con el respaldo"
      echo "      dentro: $C_PAC pacientes / respaldo: $R_PAC"
      echo "      Vuelve a intentarlo, o restaura desde $SEGURO"
    fi
  else
    mal "no se pudo comprobar el resultado"
  fi
  rm -f "$COMP"

  # Si no se escribió nada, NO se puede decir que fue bien. Que los
  # números coincidan puede significar solo que los datos ya eran los
  # mismos: no prueba que la escritura ocurriera.
  if [ "$PUESTOS" = "0" ]; then
    titulo "❌ EL RESCATE NO SE HIZO"
    cat <<FIN

   No se pudo escribir ningún archivo dentro de Windows.

   ${AM}Tus datos NO se han tocado.${V} Lo que había sigue estando, y
   además hay una copia en:
      $SEGURO

   Si arriba salieron números que coincidían, era porque los datos ya
   eran los mismos — no porque se escribiera nada.

FIN
    anota "RESCATE FALLIDO: no se escribió ningún archivo en $VM"
    exit 1
  fi

  titulo "✅ RESCATE TERMINADO"
  cat <<FIN

   Se devolvieron $PUESTOS archivos. Abre SALMI y compruébalo.

   ${AM}Si algo no cuadra${V}, lo de antes está guardado en:
      $SEGURO

FIN
  anota "rescate: $CUAL devuelto a $VM ($PUESTOS archivos)"
  exit 0
fi

# ═════════════════════════════════════════════════════════════════════
#  HACER EL RESPALDO
# ═════════════════════════════════════════════════════════════════════
titulo "RESPALDO DE LA INFORMACIÓN DEL CENTRO"
[ "$(id -u)" = "0" ] || { mal "hace falta sudo"; exit 1; }

# ── ¿Toca hoy? ────────────────────────────────────────────────────────
# Solo cuando la copia la pide el temporizador. Si alguien escribe --ahora
# es porque la quiere ahora, y ahí no se discute.
#
# El temporizador se dispara todos los días y aquí se mira la fecha de la
# última copia. Así, si el centro estuvo cerrado el día que tocaba, la copia
# se hace al encender y no se pierde el turno.
if [ "$SILENCIO" = "1" ] && [ "${CADA_DIAS:-1}" -gt 1 ]; then
  ULTIMA=$(find "$DESTINO" -maxdepth 1 -type d -name '20*' -printf '%f\n' 2>/dev/null | sort -r | head -1)
  if [ -n "$ULTIMA" ]; then
    SEG_ULT=$(date -d "$(echo "$ULTIMA" | cut -d_ -f1)" +%s 2>/dev/null || echo 0)
    DIAS=$(( ( $(date +%s) - SEG_ULT ) / 86400 ))
    if [ "$SEG_ULT" -gt 0 ] && [ "$DIAS" -lt "$CADA_DIAS" ]; then
      ok "la última copia fue hace $DIAS día(s); toca cada $CADA_DIAS"
      echo "      No se hace nada. La próxima, en $(( CADA_DIAS - DIAS )) día(s)."
      anota "saltada: última hace $DIAS días, se hace cada $CADA_DIAS"
      exit 0
    fi
  fi
fi

if [ "$MODO" = "red" ]; then
  # Windows es una computadora del centro, no una máquina virtual
  d "Modo:" "por red, sin tocar esa computadora"
  d "Carpeta compartida:" "$WIN_RED"
  command -v smbclient >/dev/null 2>&1 || {
    mal "falta smbclient para hablar con esa computadora"
    echo "      sudo apt install smbclient"
    anota "FALLÓ: falta smbclient"; exit 1; }
  [ -r "$WIN_CRED" ] || {
    mal "no encuentro el archivo con el usuario y la clave"
    echo "      Debería estar en: $WIN_CRED"
    echo "      con estas tres líneas y permisos 600:"
    echo "         username = salmired"
    echo "         password = LACLAVE"
    echo "         domain   = WORKGROUP"
    anota "FALLÓ: sin credenciales para $WIN_RED"; exit 1; }
  smb 'ls' >/dev/null 2>&1 || {
    mal "no se llega a esa computadora"
    echo "      Comprueba que esté encendida y que comparta la carpeta."
    smb 'ls' | head -2 | sed 's/^/      /'
    anota "FALLÓ: no se llega a $WIN_RED"; exit 1; }
  ok "se llega a la computadora del centro"
else

elegir_maquina || { anota "FALLÓ: no se pudo elegir la máquina"; exit 1; }
ok "máquina: $VM"

# Cuando el respaldo se hace al encender la computadora, Windows todavía
# está arrancando y su agente tarda un par de minutos en responder. Se le
# da tiempo en vez de darlo por muerto.
if ! agente '{"execute":"guest-info"}' >/dev/null 2>&1; then
  printf "   esperando a que Windows despierte"
  for _ in $(seq 1 30); do
    printf "."
    sleep 10
    agente '{"execute":"guest-info"}' >/dev/null 2>&1 && break
  done
  echo
fi
agente '{"execute":"guest-info"}' >/dev/null 2>&1 || {
  mal "el agente invitado no responde después de cinco minutos"
  echo "      Sin él no se puede sacar nada sin apagar la máquina."
  echo "      Instálalo dentro de Windows: guest-agent\\qemu-ga-x86_64.msi"
  anota "FALLÓ: el agente no responde en $VM"; exit 1; }
ok "el agente responde"
fi

CARPETA=$(buscar_salmi)
[ -n "$CARPETA" ] || {
  mal "no encuentro SALMI dentro de esa máquina"
  echo "      Se buscó bdSalmiDis.mdb por todo el disco C:"
  anota "FALLÓ: no se encontró SALMI en $VM"; exit 1; }
ok "SALMI está en: $CARPETA"

FECHA=$(date '+%Y-%m-%d_%H%M')
CARPETA_DEST="$DESTINO/$FECHA"
mkdir -p "$CARPETA_DEST"

# ── Congelar el disco un instante ─────────────────────────────────────
# Windows termina lo que estaba escribiendo y se detiene. La copia sale
# entera en vez de a medio escribir. Dura menos de un segundo.
# Pase lo que pase a partir de aquí —error, corte, Ctrl+C— el disco se
# descongela. Un disco congelado deja Windows clavado y a la gente sin
# poder trabajar.
if [ "$MODO" = "red" ]; then
  # Sin agente no se puede pausar Windows. Se mira en su lugar si alguien
  # tiene la base abierta: Access deja un archivo de bloqueo mientras se
  # usa, y copiar en ese momento puede dar una copia a medias.
  if salmi_abierto; then
    avi "ALGUIEN ESTÁ USANDO SALMI EN ESE MOMENTO"
    echo "      La copia podría salir a medias. Conviene esperar a que"
    echo "      cierren el programa, o hacerlo al terminar la jornada."
    echo
    if [ "${CONFIRMADO:-0}" != "1" ] && [ "$SILENCIO" = "0" ]; then
      printf "   ¿Copiar de todos modos? Escribe SI para seguir: "
      read -r R; [ "$R" = "SI" ] || { echo "   Cancelado."; exit 0; }
    else
      anota "AVISO: se copió con SALMI abierto en $WIN_RED"
    fi
  else
    ok "nadie está usando SALMI ahora mismo"
  fi
  CONGELADO=no
else

trap 'descongelar_seguro >/dev/null 2>&1' EXIT INT TERM

agente '{"execute":"guest-fsfreeze-freeze"}' >/dev/null 2>&1
CONGELADO=$(estado_congelado)
if [ "$CONGELADO" = "frozen" ]; then
  ok "disco congelado un instante — la copia saldrá entera"
else
  avi "no se pudo congelar el disco; se copia igual"
  echo "      Si alguien está usando SALMI en este momento, la copia"
  echo "      podría salir a medias. A las 3 de la madrugada no pasa."
fi

# Mientras está congelado, el agente bloquea leer archivos. Hay que
# descongelar ANTES de sacarlos: la copia sigue siendo buena porque
# Windows ya volcó al disco todo lo que tenía pendiente.
#
# 🔴 SE DESCONGELA SIEMPRE, DIGA LO QUE DIGA EL ESTADO.
#
# Aquí ponía «if [ "$CONGELADO" = "frozen" ]», o sea: descongelar solo si
# habíamos podido CONFIRMAR que estaba congelado. Y el 15/08/2026 en Hornoma
# pasó lo que tenía que pasar: la orden de congelar salió, el estado no se
# pudo leer a tiempo, el guion dijo «no se pudo congelar; se copia igual»…
# y el disco SÍ estaba congelado. Las tres bases fallaron una detrás de otra
# y el respaldo se fue en blanco:
#
#     bdSalmiDis.mdb         falló
#     bdPrescripcion.mdb     falló
#     bdExterna.mdb          falló
#     ❌ no se pudo copiar nada
#
# El fallo no es no saber: es DECIDIR SOBRE LO QUE NO SE SABE. Y para colmo
# decidiendo lo cómodo —«si no me consta, no hago nada»— cuando lo que no
# consta es justo lo peligroso: un disco congelado deja Windows clavado.
#
# Descongelar algo que ya está descongelado no cuesta nada y no rompe nada.
# Así que se hace siempre y se comprueba después.
if true; then
  if descongelar_seguro; then
    [ "$CONGELADO" = "frozen" ] && ok "disco descongelado — todo lo pendiente quedó escrito"
  else
    mal "EL DISCO SIGUE CONGELADO — Windows se quedará clavado"
    echo "      Descongélalo a mano ahora mismo:"
    echo "         sudo virsh qemu-agent-command --timeout 60 $VM '{\"execute\":\"guest-fsfreeze-thaw\"}'"
    anota "GRAVE: el disco de $VM quedó congelado"
    exit 1
  fi
fi
fi

# ── Sacar los archivos ────────────────────────────────────────────────
printf "\n   ${AZ}Sacando los archivos${V}\n"
COPIADOS=0; FALLIDOS=0
for archivo in bdSalmiDis.mdb bdPrescripcion.mdb bdExterna.mdb; do
  # El principal se guarda como .sal: así SALMI lo restaura tal cual
  case "$archivo" in
    bdSalmiDis.mdb) SALIDA="$CARPETA_DEST/${FECHA}_respaldo.sal" ;;
    *)              SALIDA="$CARPETA_DEST/$archivo" ;;
  esac
  printf "      %-22s " "$archivo"
  if BYTES=$(sacar_archivo "$CARPETA\\$archivo" "$SALIDA" 2>/dev/null) && es_base_valida "$SALIDA"; then
    printf "${VE}%s${V}\n" "$(numfmt --to=iec "$BYTES" 2>/dev/null || echo "$BYTES bytes")"
    COPIADOS=$((COPIADOS+1))
  else
    printf "${RO}falló${V}\n"; rm -f "$SALIDA"; FALLIDOS=$((FALLIDOS+1))
  fi
done

trap - EXIT INT TERM

# ── Las copias de SOAPS y SNIS, que se hace el propio Windows ─────────
# Hasta el 08/08/2026 estas dos copias las tenía que generar una persona a
# mano, una vez al mes, desde cada programa. Al mirarlo de verdad, el
# último respaldo de SOAPS era del 1 de julio: cinco semanas. **Un
# respaldo que depende de que alguien se acuerde es un respaldo que no
# ocurre.**
#
# Ahora las genera el propio Windows cada día (respaldo-programas.ps1) y
# las deja en la carpeta compartida, que ES un directorio de este Linux:
# recogerlas no cuesta ni una transferencia. Se instala con
# «redhornoma-respaldo --preparar-programas».
#
# Aquí NO se comprueba si la copia es buena —eso ya lo hizo SQL Server al
# generarla— pero sí si es VIEJA. Meter en el respaldo de hoy una copia de
# SOAPS de hace tres semanas sin decirlo sería un verde falso.
PROG_CARP=$(leer_conf programas_carpeta)
[ -z "$PROG_CARP" ] && [ -d /var/lib/libvirt/compartido/RESPALDOS ] \
  && PROG_CARP=/var/lib/libvirt/compartido/RESPALDOS

if [ -n "$PROG_CARP" ] && [ -d "$PROG_CARP" ]; then
  printf "\n   ${AZ}Copias de SOAPS y SNIS${V}\n"
  ULTIMO=$(ls -1t "$PROG_CARP"/programas-*.zip 2>/dev/null | head -1)
  if [ -z "$ULTIMO" ]; then
    avi "no hay ninguna copia de SOAPS ni de SNIS"
    echo "      Las genera el propio Windows. Para ponerlo en marcha:"
    echo "         sudo redhornoma-respaldo --preparar-programas"
    anota "AVISO: sin copias de SOAPS/SNIS en $PROG_CARP"
  else
    DIAS=$(( ( $(date +%s) - $(stat -c %Y "$ULTIMO") ) / 86400 ))
    # Que abra. Si el Windows estaba escribiéndolo justo ahora, o se quedó
    # a medias anoche, el archivo existe y pesa — pero no sirve para nada.
    if ! zip_entero "$ULTIMO"; then
      mal "$(basename "$ULTIMO") NO abre: incompleto o roto"
      echo "      No se incluye. SOAPS y SNIS se quedan SIN copia hoy."
      anota "FALLÓ: el paquete de SOAPS/SNIS no abre"
    elif cp -f "$ULTIMO" "$CARPETA_DEST/"; then
      printf "      %-34s %s\n" "$(basename "$ULTIMO")" "$(du -h "$ULTIMO" | cut -f1)"
      # Un día de retraso es normal: el Windows la hace por la noche.
      if [ "$DIAS" -gt 2 ]; then
        avi "esa copia tiene $DIAS días — el Windows no la está generando"
        echo "      Compruébalo con: sudo redhornoma-respaldo --preparar-programas"
        anota "AVISO: copia de SOAPS/SNIS con $DIAS días"
      else
        ok "SOAPS y SNIS incluidos (copia de hace $DIAS día(s))"
      fi
      # El propio Windows marca el paquete cuando algo no fue redondo.
      case "$(basename "$ULTIMO")" in
        *CON-AVISOS*)
          avi "el Windows marcó esa copia CON AVISOS — mira su PARTE.txt"
          anota "AVISO: copia de SOAPS/SNIS marcada con avisos" ;;
      esac
    else
      mal "no se pudo copiar $(basename "$ULTIMO")"
      anota "FALLÓ: no se pudo recoger la copia de SOAPS/SNIS"
    fi
  fi
fi

# ── Los documentos que se pasan entre consultorios ────────────────────
# La carpeta que crea «redhornoma-carpeta-compartida --documentos». Ahí
# acaban informes, formularios y plantillas que los médicos se dejan unos
# a otros. No es la base de datos de nadie, pero es trabajo hecho: si el
# disco del servidor muere, se pierde igual que lo demás.
#
# Se avisa del tamaño, porque esta carpeta la llena la gente y puede
# crecer sin freno. Todo lo que entre aquí viaja también a la nube, y la
# nube de un centro rural no es infinita.
DOCS=/var/lib/redhornoma/documentos
if [ -d "$DOCS" ] && [ -n "$(ls -A "$DOCS" 2>/dev/null)" ]; then
  printf "\n   ${AZ}Documentos del centro${V}\n"
  TAM_KB=$(du -sk "$DOCS" 2>/dev/null | cut -f1)
  TAM=$(du -sh "$DOCS" 2>/dev/null | cut -f1)
  if cp -a "$DOCS" "$CARPETA_DEST/documentos-del-centro" 2>/dev/null; then
    N_DOC=$(find "$CARPETA_DEST/documentos-del-centro" -type f 2>/dev/null | wc -l)
    ok "$N_DOC archivo(s), $TAM"
    # 500 MB: a partir de ahí el respaldo diario empieza a pesar de verdad
    # en la subida a la nube, y conviene que alguien lo mire.
    if [ "${TAM_KB:-0}" -gt 512000 ]; then
      avi "esa carpeta ya ocupa $TAM y va entera en cada respaldo"
      echo "      Conviene revisar si hay cosas que ya no hacen falta:"
      echo "         $DOCS"
      anota "AVISO: documentos del centro ocupan $TAM"
    fi
  else
    mal "no se pudieron copiar los documentos del centro"
    anota "FALLÓ: no se copió $DOCS"
  fi
fi

# ── Lo que el centro deja en la carpeta compartida ────────────────────
# SALMI se saca solo porque sus archivos están siempre ahí. Esto de aquí
# abajo es el camino ANTIGUO, para lo que alguien deje a mano: sigue
# valiendo para un centro donde el Windows no sea de RedHornoma y no pueda
# generarse sus copias solo.
#
# Aquí se recogen. Solo los archivos pequeños que sirven para recuperar
# —el .wak de SOAPS, el .sal de SALMI, los formularios del SNIS— y nunca
# los .bak de SQL Server, que pesan cientos de megas y no caben en la nube
# de un centro con internet rural.
EXTRA_RED=$(leer_conf windows_extra)
EXTRA_CARP=$(leer_conf windows_extra_carpeta); EXTRA_CARP="${EXTRA_CARP:-RESPALDOS}"
if [ -n "$EXTRA_RED" ]; then
  printf "\n   ${AZ}Recogiendo lo que dejó el centro${V}\n"
  mkdir -p "$CARPETA_DEST/del-centro"
  N_EXTRA=0
  # El .zip entra desde la 1.0.10: es el paquete que se genera solo el
  # Windows con SOAPS y SNIS dentro. Comprimido baja de 330 MB a unos 35,
  # y por eso ahora sí cabe donde antes no cabía.
  for PATRON in '*.zip' '*.wak' '*.sal' '*.ves' '*.xlsx' '*.xls'; do
    LISTA=$(smbclient "$EXTRA_RED" -A "$WIN_CRED" -t 60 \
              -c "recurse ON; prompt OFF; cd \"$EXTRA_CARP\"; ls $PATRON" 2>/dev/null \
            | awk '$2=="A"{print $1}')
    for f in $LISTA; do
      smbclient "$EXTRA_RED" -A "$WIN_CRED" -t 60 \
        -c "recurse ON; prompt OFF; cd \"$EXTRA_CARP\"; mget \"$f\"" \
        >/dev/null 2>&1 || continue
      [ -f "$f" ] && mv -f "$f" "$CARPETA_DEST/del-centro/" 2>/dev/null && {
        printf "      %-34s %s\n" "$f" "$(du -h "$CARPETA_DEST/del-centro/$f" | cut -f1)"
        N_EXTRA=$((N_EXTRA+1)); }
    done
  done
  if [ "$N_EXTRA" -gt 0 ]; then
    ok "$N_EXTRA archivo(s) del centro recogidos"
  else
    avi "no había nada que recoger en $EXTRA_CARP"
    echo "      Ahí van las copias que se generan a mano: el .wak de SOAPS"
    echo "      al cerrar el mes, y los formularios del SNIS."
    rmdir "$CARPETA_DEST/del-centro" 2>/dev/null
  fi
fi

if [ "$COPIADOS" = "0" ]; then
  mal "no se pudo copiar nada"
  rmdir "$CARPETA_DEST" 2>/dev/null
  anota "FALLÓ: no se copió ningún archivo de $VM"
  exit 1
fi

# ── Dejar constancia ──────────────────────────────────────────────────
{
  printf 'Respaldo de RedHornoma\n'
  printf 'Fecha:    %s\n' "$(date '+%d de %B de %Y, %H:%M')"
  printf 'Equipo:   %s\n' "$(cat /proc/sys/kernel/hostname)"
  printf 'Centro:   %s\n' "$(grep -oP '^centro=\K.*' /etc/redhornoma/centro.conf 2>/dev/null || echo '?')"
  printf 'Máquina:  %s\n' "$VM"
  printf 'Origen:   %s\n\n' "$CARPETA"
  printf 'Para restaurarlo: dentro de SALMI, Administración -> Restaurar,\n'
  printf 'y apuntar al archivo terminado en .sal\n'
} > "$CARPETA_DEST/LEEME.txt"

# ── Guardar también la MÁQUINA, no solo la información ────────────────
# El disco qcow2 guarda Windows entero, pero la máquina —chipset, memoria,
# firmware, TPM— vive en libvirt, no en el disco. Al reinstalar un equipo,
# el disco sobrevive y la máquina no.
#
# Esto lo aprendimos reinstalando el portátil el 2026-08-01: hubo que
# reconstruir la máquina a mano abriendo el disco para adivinar qué
# Windows era. Son 4 KB los que lo habrían evitado.
#
# Se guarda:
#   maquina.xml    cómo está armada la máquina        ~4 KB
#   nvram.fd       dónde apunta UEFI para arrancar    ~540 KB
#   tpm.tar        el TPM emulado, si lo tiene        pocos KB
#
# El TPM importa cuando dentro de Windows hay BitLocker: sin él, el disco
# pide la clave de recuperación de 48 dígitos.
if [ "$MODO" = "virtual" ] && [ -n "${VM:-}" ]; then
  printf "\n   ${AZ}Guardando también la máquina${V}\n"

  if virsh -c qemu:///system dumpxml "$VM" > "$CARPETA_DEST/maquina.xml" 2>/dev/null \
     && [ -s "$CARPETA_DEST/maquina.xml" ]; then
    ok "maquina.xml — con esto se vuelve a crear sin adivinar nada"
  else
    rm -f "$CARPETA_DEST/maquina.xml"
    avi "no se pudo guardar la configuración de la máquina"
  fi

  # La NVRAM es la memoria del firmware: sin ella, UEFI no sabe qué
  # arrancar y hay que indicárselo a mano la primera vez.
  NVRAM=$(grep -oP '<nvram[^>]*>\K[^<]+' "$CARPETA_DEST/maquina.xml" 2>/dev/null | head -1)
  if [ -n "$NVRAM" ] && [ -r "$NVRAM" ]; then
    if cp -f "$NVRAM" "$CARPETA_DEST/nvram.fd" 2>/dev/null; then
      # El original solo lo puede leer root, y la copia hereda ese permiso.
      # Eso hacía que al llevarse el respaldo a otro disco desde el portátil
      # llegara todo MENOS este archivo, y sin él la máquina restaurada no
      # encuentra qué arrancar. Se iguala al resto de la carpeta —que ya es
      # legible— porque aquí dentro no guarda ningún secreto: son las
      # variables de arranque de UEFI. Descubierto el 09/08/2026.
      chmod 644 "$CARPETA_DEST/nvram.fd" 2>/dev/null
      ok "nvram.fd — arrancará sin la pantalla azul de UEFI"
    else
      avi "no se pudo guardar la NVRAM"
    fi
  fi

  # El estado del TPM emulado. Se guarda por UUID de la máquina.
  UUID=$(virsh -c qemu:///system domuuid "$VM" 2>/dev/null | tr -d '[:space:]')
  if [ -n "$UUID" ] && [ -d "/var/lib/libvirt/swtpm/$UUID" ]; then
    if tar -cf "$CARPETA_DEST/tpm.tar" -C /var/lib/libvirt/swtpm "$UUID" 2>/dev/null; then
      ok "tpm.tar — hace falta si dentro de Windows hay BitLocker"
    else
      rm -f "$CARPETA_DEST/tpm.tar"
      avi "no se pudo guardar el estado del TPM"
    fi
  fi

  # Quien abra esta carpeta dentro de dos años tiene que entender qué son
  # estos archivos sin preguntarle a nadie.
  if [ -f "$CARPETA_DEST/maquina.xml" ]; then
    {
      printf '\n--- La máquina, no solo la información ---\n\n'
      printf 'maquina.xml   cómo está armada la máquina virtual\n'
      [ -f "$CARPETA_DEST/nvram.fd" ] && printf 'nvram.fd      la memoria del firmware UEFI\n'
      [ -f "$CARPETA_DEST/tpm.tar"  ] && printf 'tpm.tar       el TPM emulado (hace falta si hay BitLocker)\n'
      printf '\nEl disco .qcow2 NO esta aqui: son decenas de GB y se respalda\n'
      printf 'aparte. Estos archivos son lo que ese disco no lleva dentro.\n\n'
      printf 'Si hay que rehacer la maquina y el disco se conserva:\n'
      printf '   sudo virsh define maquina.xml\n'
      printf 'o, si el disco esta pero no se sabe como estaba armada:\n'
      printf '   sudo redhornoma-importar --mirar /ruta/al/disco.qcow2\n'
    } >> "$CARPETA_DEST/LEEME.txt"
  fi
fi

# ── Comprobar que sirve ───────────────────────────────────────────────
# Esto va ANTES de repartir, y no es un detalle de orden.
#
# La nube conserva un número fijo de copias: cada subida empuja fuera a la
# más antigua. Si se subiera una copia mala, al cabo de unos días habría
# empujado fuera todas las buenas y en la nube solo quedaría basura.
#
# Por eso: primero se abre la base y se cuenta lo que hay dentro. Si no
# convence, no se reparte a ningún sitio y no se borra ningún respaldo
# antiguo —los de antes pueden ser los únicos buenos que quedan—.
printf "\n   ${AZ}Comprobando que sirve${V}\n"
BIEN=1
for f in "$CARPETA_DEST"/*.sal "$CARPETA_DEST"/*.mdb; do
  [ -e "$f" ] || continue
  es_base_valida "$f" || { mal "$(basename "$f") no es una base de datos válida"; BIEN=0; }
done
[ "$BIEN" = "1" ] && ok "los archivos son bases de datos de verdad, no copias a medias"

# Abrir la base y contar lo que hay dentro. Esto es lo que distingue un
# respaldo comprobado de una carpeta con archivos dentro.
PRINCIPAL="$CARPETA_DEST/${FECHA}_respaldo.sal"
if [ -f "$PRINCIPAL" ] && command -v mdb-tables >/dev/null 2>&1; then
  read -r N_TABLAS N_REG N_PAC N_PRES <<< "$(analizar_base "$PRINCIPAL")"
  if [ "${N_TABLAS:-0}" -gt 0 ]; then
    ok "se abre y tiene $N_TABLAS tablas con $N_REG registros"
    d "Pacientes:" "$N_PAC"
    d "Prestaciones:" "$N_PRES"

    # Comparar con el respaldo anterior no basta: no detecta nada cuando
    # ESTE es el primero —que es justo cuando más fácil es equivocarse de
    # máquina— ni cuando el anterior estaba igual de vacío.
    if base_casi_vacia "${N_PAC:-0}" "${N_PRES:-0}"; then
      avisar_base_vacia "$N_PAC" "$N_PRES"
      BIEN=0
    fi

    comparar_con_anterior "$N_TABLAS" "$N_REG" "$N_PAC" "$N_PRES" || BIEN=0
    # El encabezado se escribe FUERA del bloque que añade. Antes iban
    # juntos: el bloque abría el historial para AÑADIR y por dentro había
    # un «>» que lo VACÍA. Hoy funciona porque el vaciado solo ocurre la
    # primera vez, con el archivo aún vacío — pero es leer y escribir el
    # mismo archivo a la vez, y basta un cambio pequeño para que se lleve
    # por delante el historial entero.
    #
    # Y ese archivo importa: guarda con cuántos pacientes venía cada
    # respaldo. Es lo que permite decir «esta copia trae menos que la
    # anterior». Sin él, la comprobación se queda ciega.
    [ -f "$HISTORIAL" ] \
      || printf '#fecha\tarchivo\ttablas\tregistros\tpacientes\tprestaciones\n' > "$HISTORIAL"
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$(date '+%Y-%m-%d_%H%M')" "$FECHA" \
           "$N_TABLAS" "$N_REG" "$N_PAC" "$N_PRES" >> "$HISTORIAL"
  else
    mal "el archivo no se pudo abrir como base de datos"
    BIEN=0
  fi
else
  avi "sin mdbtools solo se comprueba la firma del archivo"
  echo "         sudo apt install mdbtools    ← comprueba también el contenido"
fi

if [ "$BIEN" = "1" ]; then
  touch "$CARPETA_DEST/CORRECTO"
else
  # Parar aquí es lo que protege lo que ya había guardado.
  mal "ESTE RESPALDO NO ESTÁ CONFIRMADO"
  anota "SIN CONFIRMAR: $FECHA — no se repartió ni se borró nada"
  titulo "⚠️  RESPALDO HECHO, PERO NO ES DE FIAR"
  printf "\n"
  d "Quedó en:" "$CARPETA_DEST"
  cat <<PARADA

   ${AM}No se ha copiado a ningún sitio y no se ha borrado ningún respaldo
   antiguo.${V} Los de antes pueden ser los únicos buenos que quedan.

   Míralo antes de hacer nada:

      sudo redhornoma-respaldo              qué hay guardado
      No restaures desde este respaldo.

PARADA
  exit 1
fi

# ── Repartir las copias ───────────────────────────────────────────────
# Cada sitio protege de algo distinto. Ninguno sobra:
#   otra carpeta de este equipo  → si se estropea el disco del sistema
#   disco externo                → si se estropea o roban la computadora
#   otra computadora del centro  → lo mismo, y sin depender de nadie
#   la nube                      → si arde o se inunda el edificio
printf "\n   ${AZ}Repartiendo las copias${V}\n"
CERCA=0; FUERA=0
leer_conf(){ [ -f "$CONF" ] && grep -oP "^$1=\K.*" "$CONF" 2>/dev/null | head -1; }

# 1) Otra carpeta de este mismo equipo (el «disco D» de toda la vida)
EXTRA=$(leer_conf carpeta_extra)
if [ -n "$EXTRA" ]; then
  if mkdir -p "$EXTRA" 2>/dev/null && cp -r "$CARPETA_DEST" "$EXTRA/" 2>/dev/null; then
    ok "copiado a $EXTRA"; CERCA=$((CERCA+1))
  else
    avi "no se pudo copiar a $EXTRA"
  fi
fi

# 2) Cualquier disco externo que esté enchufado
#
# 🔴 EL 15/08/2026 ESTA COPIA SE ESTABA GUARDANDO EN EL MISMO SERVIDOR.
#
# Aquí solo se preguntaba «¿existe la carpeta y puedo escribir en ella?». Y
# una carpeta vacía que quedó de un disco que ya no está —el punto donde se
# montaba— contesta que sí a las dos cosas. Es una carpeta del disco del
# sistema con nombre de disco externo.
#
# En Hornoma había tres: SANSUNG1, SANSUNG2 y el Toshiba. Solo el Toshiba
# estaba de verdad. El bucle se paraba en el PRIMERO que le servía —SANSUNG1,
# por orden alfabético— y dejaba 53 MB dentro del propio servidor, contándolos
# como «copia fuera». El disco externo de verdad se quedó con la copia del 12.
#
# O sea: el registro decía «3 copias fuera» y una de las tres era mentira. Si
# ese disco muere, se lleva por delante lo que creíamos protegido de eso mismo.
#
# Ahora se exige que la carpeta SEA un punto de montaje y que su disco no sea
# el mismo del sistema. Una carpeta suelta ya no puede hacerse pasar por disco.
# Se hace en DOS pasadas, y no es capricho: la copia se detiene en cuanto
# encuentra un disco bueno, así que si el aviso fuera dentro del mismo bucle
# se lo saltaría justo cuando hay un disco de verdad — es decir, callaría
# precisamente el día en que todo parece ir bien.
RAIZ_DEV=$(findmnt -nro SOURCE / 2>/dev/null | head -1)

# Primera pasada: decir en voz alta lo que NO es un disco.
for m in /media/*/* /run/media/*/*; do
  [ -d "$m" ] || continue
  DEV=$(findmnt -nro SOURCE "$m" 2>/dev/null | head -1)
  if [ -z "$DEV" ]; then
    avi "«$(basename "$m")» parece un disco y NO hay ninguno montado ahí"
    avi "   es una carpeta del servidor: lo que se copie ahí NO sale de la máquina"
  elif [ "$DEV" = "$RAIZ_DEV" ]; then
    avi "«$(basename "$m")» está en el disco del sistema: no cuenta como copia fuera"
  fi
done

# Segunda pasada: copiar a TODOS los discos de verdad que haya.
#
# Antes se paraba en el primero. Y en Hornoma, el 15/08/2026, había dos
# enchufados —el Toshiba y el Samsung— y solo uno recibía copia. Son 53 MB:
# no copiar al segundo no ahorra nada que merezca la pena, y los dos discos
# tienen sectores dañados anotados. Dos copias en dos discos gastados
# protegen mucho más que una en uno.
for m in /media/*/* /run/media/*/*; do
  [ -d "$m" ] && [ -w "$m" ] || continue
  DEV=$(findmnt -nro SOURCE "$m" 2>/dev/null | head -1)
  [ -n "$DEV" ] && [ "$DEV" != "$RAIZ_DEV" ] || continue
  RUTA="$m/B-SALMI26"
  if mkdir -p "$RUTA" 2>/dev/null && cp -r "$CARPETA_DEST" "$RUTA/" 2>/dev/null; then
    ok "copiado al disco externo: $m"; FUERA=$((FUERA+1))
  else
    avi "no se pudo copiar a $m"
  fi
done

# 3) Otra computadora — puede estar en el mismo centro o en OTRO
#
# Desde el 11/08/2026 los centros están unidos por un enlace que da la vuelta
# por un servidor de reenvío en Brasil, porque los dos están detrás del
# operador y no consiguen hablarse directos. Ese camino es gratis pero lento,
# y eso cambia dos cosas:
#
# 1 · NO cruza el zip de los programas. Son SOAPS y SNIS, 44 MB que se
#     reinstalan desde su instalador. Lo irreemplazable —el .sal y las bases—
#     son 8 MB. Cruzar 44 MB de programas cada dos días por un enlace lento es
#     gastar horas para proteger lo que no hace falta proteger.
#
#     Con «otra_computadora_todo=si» se manda entero, para cuando el destino
#     esté en la misma red del centro y la velocidad no importe.
#
# 2 · La espera pasa de 60 segundos a 10 minutos. Con 60, un archivo grande
#     por ese rodeo se queda callado más de eso y rsync aborta: el 11/08 se
#     cortó justo en el zip, tras haber pasado bien los 8,7 MB de datos.
OTRA=$(leer_conf otra_computadora)
if [ -n "$OTRA" ]; then
  ARG_OTRA=(-a --partial --timeout=600)
  QUE="entero"
  if [ "$(leer_conf otra_computadora_todo)" != "si" ]; then
    ARG_OTRA+=(--exclude='programas-*.zip')
    QUE="solo los datos"
  fi

  # El error NO se tira a la basura, y el mensaje no manda a mirar donde no
  # es. El anterior decía «¿está encendida?» y la máquina estaba encendida:
  # lo que fallaba era el tamaño contra la espera.
  SALIDA_OTRA=$(rsync "${ARG_OTRA[@]}" "$CARPETA_DEST" "$OTRA/" 2>&1)
  if [ $? -eq 0 ]; then
    ok "copiado a $OTRA ($QUE)"; FUERA=$((FUERA+1))
  else
    avi "no se pudo copiar a $OTRA"
    printf '%s\n' "$SALIDA_OTRA" | grep -iE "error|timeout|refused|denied" | head -2 | sed 's/^/         /'
    nota "si tarda demasiado, mira que no esté cruzando archivos grandes"
  fi
fi

# 4) La nube, cada tantos días
NUBE=$(leer_conf nube)
NUBE_CADA=$(leer_conf nube_cada_dias); NUBE_CADA=${NUBE_CADA:-3}
NUBE_GUARDA=$(leer_conf nube_conservar); NUBE_GUARDA=${NUBE_GUARDA:-10}
if [ -n "$NUBE" ]; then
  if ! command -v rclone >/dev/null 2>&1; then
    avi "la nube está configurada pero falta rclone"
    echo "         sudo apt install rclone"
  else
    # El permiso de la nube lo guarda rclone en la carpeta personal de
    # quien lo configuró. De noche esto corre como administrador del
    # sistema, que no tiene esa carpeta: hay que decirle dónde mirar.
    RCONF=$(leer_conf nube_permiso)
    if [ -z "$RCONF" ]; then
      for posible in /etc/redhornoma/rclone.conf \
                     "/home/${SUDO_USER:-nadie}/.config/rclone/rclone.conf" \
                     /root/.config/rclone/rclone.conf; do
        [ -r "$posible" ] && RCONF="$posible" && break
      done
    fi
    if [ -n "$RCONF" ]; then
      export RCLONE_CONFIG="$RCONF"
    else
      avi "no encuentro el permiso de la nube"
      echo "         Guárdalo donde el sistema lo vea:"
      echo "            sudo install -m 600 -D ~/.config/rclone/rclone.conf \\"
      echo "                /etc/redhornoma/rclone.conf"
      NUBE=""
    fi
  fi
  if [ -n "$NUBE" ]; then
    MARCA="$BASE/ultima-subida-nube"
    TOCA=1
    if [ -f "$MARCA" ]; then
      DIAS=$(( ( $(date +%s) - $(stat -c %Y "$MARCA") ) / 86400 ))
      if [ "$DIAS" -lt "$NUBE_CADA" ]; then
        TOCA=0
        # La copia de la nube sigue siendo reciente: eso protege igual,
        # así que no se debe avisar como si no hubiera nada fuera.
        PROTEGIDO_NUBE=1
        if [ "$DIAS" = "0" ]; then
          d "Nube:" "ya hay copia de hoy; la próxima en $NUBE_CADA días"
        else
          d "Nube:" "última copia hace $DIAS día(s); la próxima en $((NUBE_CADA - DIAS))"
        fi
      fi
    fi
    if [ "$TOCA" = "1" ]; then
      printf "      subiendo a la nube… "
      if rclone copy --transfers 2 --retries 3 \
           "$CARPETA_DEST" "$NUBE/$FECHA" >/dev/null 2>&1; then
        printf "${VE}hecho${V}\n"; touch "$MARCA"; FUERA=$((FUERA+1))
        # Dejar solo las últimas: en la nube el sitio se paga
        VIEJAS=$(rclone lsf --dirs-only "$NUBE" 2>/dev/null | sort -r | tail -n +$((NUBE_GUARDA+1)))
        BORR=0
        for v in $VIEJAS; do
          rclone purge "$NUBE/$v" >/dev/null 2>&1 && BORR=$((BORR+1))
        done
        [ "$BORR" -gt 0 ] && ok "$BORR respaldos antiguos borrados de la nube"
      else
        printf "${RO}falló${V}\n"
        avi "revisa la conexión, o prueba: rclone lsd ${NUBE%%:*}:"
      fi
    fi
  fi
fi

echo
PROTEGIDO_NUBE="${PROTEGIDO_NUBE:-0}"
if [ "$FUERA" -gt 0 ]; then
  if [ "$CERCA" -gt 0 ]; then
    ok "$FUERA copia(s) fuera del equipo, más $CERCA en otro disco de aquí"
  else
    ok "$FUERA copia(s) fuera de este equipo"
  fi
elif [ "$PROTEGIDO_NUBE" = "1" ]; then
  # Este respaldo no ha salido, pero hay uno reciente en la nube. La
  # información está protegida: decir lo contrario asusta sin motivo.
  ok "hay copia reciente en la nube — la información está fuera del edificio"
  [ "$CERCA" -gt 0 ] && ok "y $CERCA copia(s) en otro disco de este equipo"
else
  avi "NINGUNA copia salió de esta computadora"
  echo "      Si se estropea o la roban, la información se va con ella."
  echo
  echo "      Configura los destinos en:  $CONF"
  echo "         carpeta_extra=/ruta/de/otro/disco"
  echo "         otra_computadora=usuario@equipo.local:/ruta"
  echo "         otra_computadora_todo=si   (manda tambien los programas, 44 MB)"
  echo "         nube=drive:B-SALMI26"
fi

# ── Tirar los viejos ──────────────────────────────────────────────────
# Se conservan los últimos días, las últimas semanas y los últimos meses.
# Así se puede volver a ayer, a hace un mes o a hace un año.
printf "\n   ${AZ}Limpiando los antiguos${V}\n"
BORRADOS=0
mapfile -t TODOS < <(find "$DESTINO" -maxdepth 1 -type d -name '20*' | sort -r)
declare -A GUARDAR
i=0
for c in "${TODOS[@]}"; do
  i=$((i+1)); [ "$i" -le "$DIARIOS" ] && GUARDAR["$c"]=1
done
# Se lleva la cuenta con variables normales en vez de preguntarle el
# tamaño a la lista: con «set -u», una lista declarada y todavía vacía
# se toma por variable sin asignar y el guion se queja.
declare -A VISTA_SEM=() VISTA_MES=()
N_SEM=0; N_MES=0
for c in "${TODOS[@]}"; do
  F=$(basename "$c" | cut -d_ -f1)
  SEM=$(date -d "$F" '+%G-%V' 2>/dev/null); MES=$(date -d "$F" '+%Y-%m' 2>/dev/null)
  if [ -n "$SEM" ] && [ -z "${VISTA_SEM[$SEM]:-}" ] && [ "$N_SEM" -lt "$SEMANALES" ]; then
    VISTA_SEM[$SEM]=1; N_SEM=$((N_SEM+1)); GUARDAR["$c"]=1; fi
  if [ -n "$MES" ] && [ -z "${VISTA_MES[$MES]:-}" ] && [ "$N_MES" -lt "$MENSUALES" ]; then
    VISTA_MES[$MES]=1; N_MES=$((N_MES+1)); GUARDAR["$c"]=1; fi
done
for c in "${TODOS[@]}"; do
  [ -n "${GUARDAR[$c]:-}" ] || { rm -rf "$c"; BORRADOS=$((BORRADOS+1)); }
done
[ "$BORRADOS" -gt 0 ] && ok "$BORRADOS respaldos antiguos borrados" \
                      || ok "no había ninguno que sobrara"

# ═════════════════════════════════════════════════════════════════════
#  LA SEÑAL — para que se sepa desde fuera que este centro sigue vivo
# ═════════════════════════════════════════════════════════════════════
#
# El problema que resuelve: cuando un respaldo falla, o cuando la máquina
# lleva días apagada, NADIE se entera. El .101 de Hornoma estuvo un día
# entero caído y se supo por casualidad, yendo a mirar.
#
# Un aviso por correo no sirve para eso: una máquina apagada no manda
# correos. Lo único que funciona con una máquina muerta es que se note su
# SILENCIO.
#
# Por eso cada respaldo deja una señal fechada en la nube. Quien la mire
# —desde el portátil, desde el teléfono, desde otra ciudad— ve cuándo
# respaldó cada centro por última vez. Si una señal deja de actualizarse,
# eso ES la alarma, y llega igual aunque la máquina esté sin luz.
#
# Pesa menos de 300 bytes: se sube SIEMPRE, aunque el respaldo entero solo
# viaje a la nube cada dos o tres días.
if [ -n "${NUBE:-}" ] && command -v rclone >/dev/null 2>&1; then
  SENAL="$BASE/senal.txt"
  MI_CENTRO=$(grep -oP '^centro=\K.*' /etc/redhornoma/centro.conf 2>/dev/null | head -1)
  MI_NOMBRE=$(grep -oP '^nombre=\K.*' /etc/redhornoma/centro.conf 2>/dev/null | head -1)
  MI_CENTRO="${MI_CENTRO:-sin-centro}"
  MI_NOMBRE="${MI_NOMBRE:-$(cat /proc/sys/kernel/hostname 2>/dev/null || echo equipo)}"

  {
    printf 'centro=%s\n'        "$MI_CENTRO"
    printf 'maquina=%s\n'       "$MI_NOMBRE"
    printf 'fecha=%s\n'         "$(date '+%Y-%m-%d %H:%M')"
    printf 'segundos=%s\n'      "$(date +%s)"
    printf 'confirmado=%s\n'    "$([ "$BIEN" = 1 ] && echo si || echo NO)"
    printf 'pacientes=%s\n'     "${N_PAC:-0}"
    printf 'prestaciones=%s\n'  "${N_PRES:-0}"
    printf 'cada_dias=%s\n'     "$CADA_DIAS"
    printf 'copias_fuera=%s\n'  "${FUERA:-0}"
  } > "$SENAL"

  # El nombre lleva centro y máquina: dos servidores del mismo centro no
  # deben pisarse la señal el uno al otro.
  SENALERO="${NUBE%%:*}:SENALES-REDHORNOMA"
  if rclone copyto "$SENAL" "$SENALERO/${MI_CENTRO}--${MI_NOMBRE}.txt" \
       --retries 2 >/dev/null 2>&1; then
    ok "señal dejada en la nube — desde fuera se sabe que este centro respaldó"
  else
    avi "no se pudo dejar la señal en la nube"
    echo "         Sin ella, nadie sabrá desde fuera si este centro sigue respaldando."
  fi
fi

# ═════════════════════════════════════════════════════════════════════
# El titular tiene que decir la verdad. Antes ponía «RESPALDO HECHO»
# pasara lo que pasara, y quien lo lee de un vistazo se queda con eso.
if [ "$BIEN" = "1" ]; then
  titulo "✅ RESPALDO HECHO Y COMPROBADO"
else
  titulo "⚠️  RESPALDO HECHO, PERO NO ES DE FIAR"
fi
printf "\n"
d "Guardado en:" "$CARPETA_DEST"
d "Archivos:" "$COPIADOS de 3"
d "Ocupa:" "$(du -sh "$CARPETA_DEST" | cut -f1)"
d "Copias fuera del equipo:" "$FUERA"
d "Se conservan:" "$(find "$DESTINO" -maxdepth 1 -type d -name '20*' | wc -l) respaldos"
printf "\n"
cat <<FIN
   ${AZ}Para devolverlo a Windows${V}

      Dentro de SALMI:  Administración → Restaurar
      y apuntar al archivo terminado en ${AZ}.sal${V}

FIN
# El registro dice si la información está protegida FUERA, no cuántas
# copias se hicieron hoy. No es lo mismo: la nube sube cada 3 días, así que
# un día normal salen «0 copias fuera» y sin embargo la de ayer protege
# igual. Leído a secas, ese renglón parece un centro desprotegido — y el
# 09/08/2026 costó cinco minutos de susto y de revisar código.
if [ "$FUERA" -gt 0 ]; then
  anota "OK: $FECHA, $COPIADOS archivos, $FUERA copias fuera"
elif [ "${PROTEGIDO_NUBE:-0}" = "1" ]; then
  anota "OK: $FECHA, $COPIADOS archivos, protegida por la copia de la nube"
else
  anota "OK: $FECHA, $COPIADOS archivos, SIN NINGUNA COPIA FUERA"
fi
