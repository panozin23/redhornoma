#!/bin/bash
# redhornoma-centros — Los centros que atiendes, en una pantalla.
#
# EL PORQUÉ
#
# Es el objetivo 11: «que se puedan atender varios centros desde un solo
# sitio». Las piezas existían desde el 11/08 —el enlace, el panel, entrar
# a la pantalla del Windows— pero había que saberse las direcciones de
# memoria y escribirlas:
#
#     redhornoma-entrar --en hornoma@100.81.234.58
#
# Eso va contra el objetivo 6 —nada de escribir órdenes— y contra la
# realidad: quien atiende un centro a 100 km no debería tener que
# acordarse de un número.
#
# Y hay un uso concreto que lo vuelve importante, decidido el 13/08:
# euflo mete sus recibos recetarios EN EL SERVIDOR DE HORNOMA, desde
# Cochabamba, abriendo su pantalla. Así hay UNA SOLA BASE y no existe el
# cruce de información. Se acabaron el pendrive y las fotos de los
# recibos. Esa forma de trabajar merece un botón, no un comando.
#
# LO QUE MIRA ANTES DE ABRIR NADA
#
#   · si el centro está despierto — una máquina apagada no tiene red, y
#     ya nos costó una mañana entera descubrirlo a base de intentos
#   · si su Windows está encendido
#   · cuánto tarda el enlace, porque de eso depende que trabajar allá sea
#     cómodo o desesperante
#
# Uso:
#   redhornoma-centros            la ventana
#   redhornoma-centros --texto    lo mismo escrito, para trabajar por SSH
#   redhornoma-centros --entrar CENTRO
set -u

# 🔴 Sin esto, en Wayland «yad» no abre y el guion se cerraba MUDO.
# El escritorio de este proyecto es KDE sobre Wayland; yad es de GTK y ahí
# necesita hablar por XWayland. Todas las demás herramientas del proyecto
# lo ponen; a esta se le olvidó, y el 13/08 euflo la ejecutó y no pasó
# absolutamente nada.
export GDK_BACKEND=x11

CONF=/etc/redhornoma/centros.conf
V=$'\033[0m'; AZ=$'\033[1;34m'; VE=$'\033[1;32m'; RO=$'\033[1;31m'; AM=$'\033[1;33m'; GR=$'\033[0;90m'

MODO=ventana; CUAL=""
while [ $# -gt 0 ]; do
  case "$1" in
    --texto)  MODO=texto; shift ;;
    --entrar) MODO=entrar; CUAL="${2:-}"; shift 2 ;;
    -h|--ayuda) sed -n '2,30p' "$0" | sed 's/^# \?//'; exit 0 ;;
    *) echo "No entiendo «$1»"; exit 1 ;;
  esac
done
[ -t 1 ] || MODO=$([ "$MODO" = "ventana" ] && echo ventana || echo "$MODO")

# ── De dónde salen los centros ────────────────────────────────────────
# De un archivo si lo hay; y si no, del propio enlace. Así funciona sin
# configurar nada el primer día, y se puede afinar después.
listar_centros(){
  if [ -r "$CONF" ]; then
    grep -vE '^\s*(#|$)' "$CONF"
    return
  fi
  command -v tailscale >/dev/null 2>&1 || return
  # El propio equipo no es un centro al que entrar.
  MI=$(tailscale status --json 2>/dev/null | grep -oP '"HostName":\s*"\K[^"]+' | head -1)
  tailscale status 2>/dev/null | awk -v mi="$MI" '
    NF>=2 && $2 != mi && $2 != "" {print $2 "|" $1}' | while IFS='|' read -r nom ip; do
    case "$nom" in ""|"$MI") continue ;; esac
    # El usuario se adivina del nombre; se puede fijar en centros.conf.
    case "$nom" in
      respaldo-hornoma) printf '%s|%s@%s\n' "CS Hornoma" "hornoma" "$ip" ;;
      servidor-ciudad)  printf '%s|%s@%s\n' "Cochabamba" "flora" "$ip" ;;
      *)                printf '%s|%s@%s\n' "$nom" "${SUDO_USER:-$(id -un)}" "$ip" ;;
    esac
  done
}

# ── Mirar un centro, deprisa ──────────────────────────────────────────
# Todo con poco tiempo de espera: una pantalla que tarda no la abre nadie.
mirar(){
  local destino="$1" ip="${1#*@}"
  local t0 t1 ms
  t0=$(date +%s%N)

  # 🔴 UN SOLO PING NO BASTA, y el 13/08 dio un «dormido» falso sobre una
  # máquina que llevaba 53 minutos encendida.
  #
  # El enlace entre centros no está levantado hasta que alguien lo usa:
  # el primer paquete se pierde mientras las dos puntas se encuentran, y
  # más aún si tienen que pasar por el relé. Declarar «apagado» con ese
  # primer fallo es exactamente el verde falso al revés.
  #
  # Se insiste, y por el camino del propio enlace, que es quien sabe
  # despertarlo.
  vivo(){
    timeout 5 ping -c1 -W3 "$ip" >/dev/null 2>&1 && return 0
    case "$ip" in
      100.*) command -v tailscale >/dev/null 2>&1 \
             && timeout 12 tailscale ping --timeout 4s -c 2 "$ip" >/dev/null 2>&1 && return 0 ;;
    esac
    timeout 6 ping -c2 -W3 "$ip" >/dev/null 2>&1
  }
  if ! vivo; then
    echo "no contesta|—|—"; return
  fi
  t1=$(date +%s%N); ms=$(( (t1 - t0) / 1000000 ))

  # Una sola conexión que lo pregunta todo: ir y venir cuesta caro.
  local r
  r=$(timeout 20 ssh -o BatchMode=yes -o ConnectTimeout=10 "$destino" \
        'V=$(LC_ALL=C virsh -c qemu:///system list --name --state-running 2>/dev/null | grep -v "^$" | head -1)
         echo "${V:-ninguno}|$(uptime -p 2>/dev/null | sed "s/^up //")"' 2>/dev/null)
  [ -n "$r" ] || { echo "sin entrada|—|${ms} ms"; return; }
  printf 'despierto|%s|%s ms\n' "${r%%|*}" "$ms"
}

# ── Entrar a la pantalla de su Windows ────────────────────────────────
entrar(){
  local destino="$1" nombre="$2"
  command -v redhornoma-entrar >/dev/null 2>&1 || {
    echo "Falta «redhornoma-entrar» — se instala con el paquete de virtualización"; return 1; }
  echo "   Abriendo la pantalla de $nombre…"
  echo "   (si tarda, es el enlace: solo viajan imágenes, ten paciencia)"
  redhornoma-entrar --en "$destino"
}


# ── Apagar un centro desde aquí ───────────────────────────────────────
#
# EL PORQUÉ — 19/08/2026
#
# El objetivo 6 dice «sin usar código, todo en un entorno gráfico». Y ese
# día hubo que escribirle a euflo un manual entero de comandos de terminal
# para algo tan corriente como apagar un servidor. Ese manual era la
# prueba de que a esta pantalla le faltaba un botón.
#
# 🔴 SE ABRE UNA TERMINAL A PROPÓSITO, y no es pereza.
#
# Apagar pide la contraseña de la otra máquina. Se podría pedir en una
# ventana y mandársela al otro lado, pero entonces la contraseña pasa por
# nuestras manos y por la lista de procesos. Abriendo una terminal, la
# escribe la persona directamente donde va, y además VE lo que contesta el
# servidor — que dice a qué hora volverá. Eso último vale por sí solo.
apagar(){
  local destino="$1" nombre="$2"

  # Se pregunta con lo que va a pasar de verdad, no con un «¿seguro?».
  yad --question --center --width=460 --title="Apagar $nombre" \
    --text="<b>¿Apagar $nombre?</b>\n\nSe hará con orden:\n  · se cierra su Windows sin perder nada\n  · se arma el despertador y se COMPRUEBA\n  · deja dicho en la nube a qué hora vuelve\n\n<small>Se abrirá una terminal para que escribas la contraseña de esa máquina.</small>" \
    --button="No, dejarla:1" --button="Sí, apagar:0" 2>/dev/null || return 1

  # El centro de apoyo no tiene horario ni guion de apagado, así que se
  # mira ALLÁ cuál de los dos caminos existe, en vez de suponerlo desde
  # aquí. Suponerlo es como se apagó mal un servidor la primera vez.
  local ORDEN='if [ -x /usr/local/sbin/redhornoma-apagar-noche ]; then
                  sudo /usr/local/sbin/redhornoma-apagar-noche --ahora
                else
                  echo "   Esta maquina no tiene horario de noche."
                  echo "   Se apaga sin despertador: habra que encenderla a mano."
                  echo
                  sudo systemctl poweroff
                fi'

  local TERM_
  for t in x-terminal-emulator konsole gnome-terminal xfce4-terminal; do
    command -v "$t" >/dev/null 2>&1 && { TERM_="$t"; break; }
  done
  if [ -z "${TERM_:-}" ]; then
    yad --error --center --width=420 --title="Falta la terminal" \
      --text="No encuentro con qué abrir una terminal.\n\nHazlo a mano:\n<tt>ssh -t $destino 'sudo /usr/local/sbin/redhornoma-apagar-noche --ahora'</tt>" \
      --button="Entendido:0" 2>/dev/null
    return 1
  fi

  # El «--hold»/«-hold» mantiene la ventana abierta al terminar: si se
  # cerrara sola, el mensaje con la hora de vuelta se perdería justo
  # cuando más falta hace leerlo.
  case "$TERM_" in
    konsole|x-terminal-emulator)
      "$TERM_" --hold -e bash -c "ssh -t '$destino' '$ORDEN'" 2>/dev/null & ;;
    *)
      "$TERM_" -- bash -c "ssh -t '$destino' '$ORDEN'; echo; read -p 'Pulsa Intro para cerrar'" 2>/dev/null & ;;
  esac
}

# ── Modo entrar directo ───────────────────────────────────────────────
if [ "$MODO" = "entrar" ]; then
  D=$(listar_centros | awk -F'|' -v c="$CUAL" 'tolower($1) ~ tolower(c) || $2 ~ c {print $2; exit}')
  [ -n "$D" ] || { echo "No encuentro el centro «$CUAL»"; listar_centros | awk -F'|' '{print "   " $1}'; exit 1; }
  # Mirar ANTES de intentar. Sin esto, con el centro apagado el visor se
  # queda esperando sin decir nada y parece que la orden no hizo efecto.
  E=$(mirar "$D"); EST="${E%%|*}"
  if [ "$EST" != "despierto" ]; then
    printf "   ${RO}✗${V} %s NO CONTESTA — no se puede entrar.\n" "$CUAL"
    printf "      Puede estar apagada, o encendida pero sin internet: desde\n"
    printf "      aquí las dos cosas se ven igual. Lo que sí es seguro es que\n"
    printf "      no se puede encender desde fuera.\n\n"
    exit 1
  fi
  entrar "$D" "$CUAL"; exit $?
fi

# ── Recoger el estado de todos ────────────────────────────────────────
FILAS=""
while IFS='|' read -r NOMBRE DESTINO; do
  [ -n "$DESTINO" ] || continue
  EST=$(mirar "$DESTINO")
  FILAS="$FILAS$NOMBRE|$DESTINO|$EST"$'\n'
done < <(listar_centros)

# ── Escrito ───────────────────────────────────────────────────────────
if [ "$MODO" = "texto" ] || ! command -v yad >/dev/null 2>&1 || [ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
  printf "\n${AZ}══════════════════════════════════════════════════════${V}\n"
  printf "${AZ} LOS CENTROS QUE ATIENDES${V}\n"
  printf "${AZ}══════════════════════════════════════════════════════${V}\n\n"
  [ -n "$FILAS" ] || { printf "   ${GR}no hay ningún centro configurado${V}\n\n"; exit 0; }
  printf "   %-16s %-12s %-18s %s\n" "CENTRO" "ESTADO" "SU WINDOWS" "ENLACE"
  printf "   %s\n" "────────────────────────────────────────────────────────────────"
  printf '%s' "$FILAS" | while IFS='|' read -r N D E W T; do
    case "$E" in
      despierto) C="${VE}●${V}" ;;
      "no contesta") C="${GR}○${V}" ;;
      *)         C="${AM}?${V}" ;;
    esac
    printf "   %b %-14s %-12s %-18s %s\n" "$C" "$N" "$E" "$W" "$T"
  done
  printf "\n   ${GR}Para entrar a la pantalla de su Windows:${V}\n"
  printf "   ${GR}   redhornoma-centros --entrar hornoma${V}\n\n"
  exit 0
fi

# ── Ventana ───────────────────────────────────────────────────────────
DATOS=""
while IFS='|' read -r N D E W T; do
  [ -n "$N" ] || continue
  case "$E" in
    despierto) ICO="🟢"; DET="listo para entrar" ;;
    "no contesta") ICO="⚪"; DET="no contesta — apagada o sin internet" ;;
    *)         ICO="🟡"; DET="responde, pero no deja entrar" ;;
  esac
  [ "$W" = "ninguno" ] && [ "$E" = "despierto" ] && DET="encendido, pero su Windows está apagado"
  DATOS="$DATOS$ICO|$N|$DET|$W|$T|$D"$'\n'
done < <(printf '%s' "$FILAS")

# Si la ventana no llega a abrirse, NO se sale en silencio: se enseña la
# lista escrita y se dice por qué. Una herramienta muda es lo peor que le
# puede pasar a quien no sabe si está rota o si se equivocó él.
ERRYAD=$(mktemp)
SEL=$(printf '%s' "$DATOS" | yad --list --title="Los centros que atiendes" \
  --width=760 --height=320 --center \
  --text="<b>Elige un centro y pulsa «Entrar a su Windows».</b>\n<small>Ahí puedes usar SALMI y SOAPS como si estuvieras sentado allá: los datos no viajan, solo la pantalla.</small>" \
  --column=" " --column="Centro" --column="Cómo está" --column="Su Windows" --column="Enlace" --column="destino:HD" \
  --print-column=6 --separator="" \
  --button="Actualizar:2" --button="Cerrar:1" --button="Apagar este centro:3" --button="Entrar a su Windows:0" 2>"$ERRYAD")
CODIGO=$?

if [ "$CODIGO" -ge 250 ] && [ -s "$ERRYAD" ]; then
  printf "\n   ${AM}No se pudo abrir la ventana. Lo que dijo el sistema:${V}\n"
  head -3 "$ERRYAD" | sed 's/^/      /'
  printf "\n   ${GR}Te enseño la lista escrita:${V}\n"
  rm -f "$ERRYAD"
  exec "$0" --texto
fi
rm -f "$ERRYAD"

case "$CODIGO" in
  2) exec "$0" ;;                      # actualizar: mirarlo todo otra vez
  3) [ -n "$SEL" ] || exit 0
     NOM=$(printf '%s' "$DATOS" | awk -F'|' -v d="$SEL" '$6==d{print $2; exit}')
     EST=$(printf '%s' "$FILAS" | awk -F'|' -v d="$SEL" '$2==d{print $3; exit}')
     if [ "$EST" != "despierto" ]; then
       yad --info --center --width=420 --title="Ya está apagada" \
         --text="<b>$NOM no contesta.</b>\n\nO ya está apagada, o no llega su internet. De cualquier forma, no hay nada que apagar." \
         --button="Entendido:0" 2>/dev/null
       exit 0
     fi
     apagar "$SEL" "$NOM" ;;
  0) [ -n "$SEL" ] || exit 0
     NOM=$(printf '%s' "$DATOS" | awk -F'|' -v d="$SEL" '$6==d{print $2; exit}')
     EST=$(printf '%s' "$FILAS" | awk -F'|' -v d="$SEL" '$2==d{print $3; exit}')
     if [ "$EST" != "despierto" ]; then
       yad --error --center --width=420 --title="No se puede entrar" \
         --text="<b>$NOM no contesta.</b>\n\nPuede estar apagada, o encendida pero sin internet: desde aquí las dos cosas se ven igual.\n\nPara encenderla desde lejos, con el enchufe inteligente: apaga su toma, espera 10 segundos y vuelve a encenderla." \
         --button="Entendido:0" 2>/dev/null
       exit 1
     fi
     entrar "$SEL" "$NOM" ;;
esac
exit 0
