#!/bin/bash
# redhornoma-centros — Los centros que atiendes, en una pantalla.
#
# EL PORQUÉ
#
# Es el objetivo 11: «que se puedan atender varios centros desde un solo
# sitio». Las piezas existían desde el 11/08 —el enlace, el panel, entrar
# a la pantalla del Windows— pero había que saberse las direcciones de
# memoria y escribirlas:
#
#     redhornoma-entrar --en hornoma@100.81.234.58
#
# Eso va contra el objetivo 6 —nada de escribir órdenes— y contra la
# realidad: quien atiende un centro a 100 km no debería tener que
# acordarse de un número.
#
# Y hay un uso concreto que lo vuelve importante, decidido el 13/08:
# euflo mete sus recibos recetarios EN EL SERVIDOR DE HORNOMA, desde
# Cochabamba, abriendo su pantalla. Así hay UNA SOLA BASE y no existe el
# cruce de información. Se acabaron el pendrive y las fotos de los
# recibos. Esa forma de trabajar merece un botón, no un comando.
#
# LO QUE MIRA ANTES DE ABRIR NADA
#
#   · si el centro está despierto — una máquina apagada no tiene red, y
#     ya nos costó una mañana entera descubrirlo a base de intentos
#   · si su Windows está encendido
#   · cuánto tarda el enlace, porque de eso depende que trabajar allá sea
#     cómodo o desesperante
#
# Uso:
#   redhornoma-centros            la ventana
#   redhornoma-centros --texto    lo mismo escrito, para trabajar por SSH
#   redhornoma-centros --entrar CENTRO
set -u

# 🔴 Sin esto, en Wayland «yad» no abre y el guion se cerraba MUDO.
# El escritorio de este proyecto es KDE sobre Wayland; yad es de GTK y ahí
# necesita hablar por XWayland. Todas las demás herramientas del proyecto
# lo ponen; a esta se le olvidó, y el 13/08 euflo la ejecutó y no pasó
# absolutamente nada.
export GDK_BACKEND=x11

CONF=/etc/redhornoma/centros.conf
V=$'\033[0m'; AZ=$'\033[1;34m'; VE=$'\033[1;32m'; RO=$'\033[1;31m'; AM=$'\033[1;33m'; GR=$'\033[0;90m'

MODO=ventana; CUAL=""
while [ $# -gt 0 ]; do
  case "$1" in
    --texto)  MODO=texto; shift ;;
    --entrar) MODO=entrar; CUAL="${2:-}"; shift 2 ;;
    -h|--ayuda) sed -n '2,30p' "$0" | sed 's/^# \?//'; exit 0 ;;
    *) echo "No entiendo «$1»"; exit 1 ;;
  esac
done
[ -t 1 ] || MODO=$([ "$MODO" = "ventana" ] && echo ventana || echo "$MODO")

# ── De dónde salen los centros ────────────────────────────────────────
# De un archivo si lo hay; y si no, del propio enlace. Así funciona sin
# configurar nada el primer día, y se puede afinar después.
listar_centros(){
  if [ -r "$CONF" ]; then
    grep -vE '^\s*(#|$)' "$CONF"
    return
  fi
  command -v tailscale >/dev/null 2>&1 || return
  # El propio equipo no es un centro al que entrar.
  MI=$(tailscale status --json 2>/dev/null | grep -oP '"HostName":\s*"\K[^"]+' | head -1)
  # 🔴 SOLO LAS LÍNEAS QUE EMPIEZAN POR UNA DIRECCIÓN.
  #
  # «tailscale status» no solo lista máquinas: al final suelta sus avisos
  # de salud, y esas líneas también tienen dos palabras. Con la regla
  # anterior —«dos campos o más»— entraban en la lista y aparecían dos
  # centros fantasma llamados «Health» y «-», que por supuesto no
  # contestaban nunca.
  #
  # Se exige que el primer campo sea una dirección de verdad. Un aviso no
  # tiene forma de dirección; una máquina, siempre.
  tailscale status 2>/dev/null | awk -v mi="$MI" '
    $1 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ && $2 != mi && $2 != "" {print $2 "|" $1}' \
  | while IFS='|' read -r nom ip; do
    case "$nom" in ""|"$MI") continue ;; esac
    # El usuario se adivina del nombre; se puede fijar en centros.conf.
    case "$nom" in
      respaldo-hornoma) printf '%s|%s@%s\n' "CS Hornoma" "hornoma" "$ip" ;;
      servidor-ciudad)  printf '%s|%s@%s\n' "Cochabamba" "flora" "$ip" ;;
      *)                printf '%s|%s@%s\n' "$nom" "${SUDO_USER:-$(id -un)}" "$ip" ;;
    esac
  done
}

# ── Mirar un centro, deprisa ──────────────────────────────────────────
# Todo con poco tiempo de espera: una pantalla que tarda no la abre nadie.
mirar(){
  local destino="$1" ip="${1#*@}"
  local t0 t1 ms
  t0=$(date +%s%N)

  # 🔴 UN SOLO PING NO BASTA, y el 13/08 dio un «dormido» falso sobre una
  # máquina que llevaba 53 minutos encendida.
  #
  # El enlace entre centros no está levantado hasta que alguien lo usa:
  # el primer paquete se pierde mientras las dos puntas se encuentran, y
  # más aún si tienen que pasar por el relé. Declarar «apagado» con ese
  # primer fallo es exactamente el verde falso al revés.
  #
  # Se insiste, y por el camino del propio enlace, que es quien sabe
  # despertarlo.
  vivo(){
    timeout 5 ping -c1 -W3 "$ip" >/dev/null 2>&1 && return 0
    case "$ip" in
      100.*) command -v tailscale >/dev/null 2>&1 \
             && timeout 12 tailscale ping --timeout 4s -c 2 "$ip" >/dev/null 2>&1 && return 0 ;;
    esac
    timeout 6 ping -c2 -W3 "$ip" >/dev/null 2>&1
  }
  if ! vivo; then
    echo "no contesta|—|—"; return
  fi
  t1=$(date +%s%N); ms=$(( (t1 - t0) / 1000000 ))

  # Una sola conexión que lo pregunta todo: ir y venir cuesta caro.
  local r
  # 🔴 EL «-n» NO SOBRA, Y SIN ÉL SE PIERDEN CENTROS — 19/08/2026
  #
  # A esta función la llama un bucle «while read» que va recorriendo la
  # lista de centros. Y ssh, si nadie se lo impide, LEE DE LA MISMA
  # ENTRADA que ese bucle: se traga de un bocado todo lo que quedaba por
  # leer, y el bucle termina creyendo que ya no hay más centros.
  #
  # Resultado: solo se miraba el PRIMERO. Cochabamba desapareció de la
  # pantalla y parecía que se había borrado.
  #
  # Y lo peor es cómo se disfrazaba: mientras Hornoma estuvo apagada, esta
  # función volvía antes de llegar al ssh, no se comía nada, y los dos
  # centros salían bien. El fallo aparecía SOLO cuando el primer centro
  # estaba encendido. Un fallo que se esconde justo cuando todo va bien.
  #
  # El «-n» le dice a ssh que no lea nada de la entrada.
  r=$(timeout 20 ssh -n -o BatchMode=yes -o ConnectTimeout=10 "$destino" \
        'V=$(LC_ALL=C virsh -c qemu:///system list --name --state-running 2>/dev/null | grep -v "^$" | head -1)
         echo "${V:-ninguno}|$(uptime -p 2>/dev/null | sed "s/^up //")"' 2>/dev/null)
  [ -n "$r" ] || { echo "sin entrada|—|${ms} ms"; return; }
  printf 'despierto|%s|%s ms\n' "${r%%|*}" "$ms"
}

# ── Entrar a la pantalla de su Windows ────────────────────────────────
entrar(){
  local destino="$1" nombre="$2"
  command -v redhornoma-entrar >/dev/null 2>&1 || {
    echo "Falta «redhornoma-entrar» — se instala con el paquete de virtualización"; return 1; }
  echo "   Abriendo la pantalla de $nombre…"
  echo "   (si tarda, es el enlace: solo viajan imágenes, ten paciencia)"
  redhornoma-entrar --en "$destino"
}


# ── Apagar un centro desde aquí ───────────────────────────────────────
#
# EL PORQUÉ — 19/08/2026
#
# El objetivo 6 dice «sin usar código, todo en un entorno gráfico». Y ese
# día hubo que escribirle a euflo un manual entero de comandos de terminal
# para algo tan corriente como apagar un servidor. Ese manual era la
# prueba de que a esta pantalla le faltaba un botón.
#
# 🔴 SE ABRE UNA TERMINAL A PROPÓSITO, y no es pereza.
#
# Apagar pide la contraseña de la otra máquina. Se podría pedir en una
# ventana y mandársela al otro lado, pero entonces la contraseña pasa por
# nuestras manos y por la lista de procesos. Abriendo una terminal, la
# escribe la persona directamente donde va, y además VE lo que contesta el
# servidor — que dice a qué hora volverá. Eso último vale por sí solo.
apagar(){
  local destino="$1" nombre="$2"

  # Se pregunta con lo que va a pasar de verdad, no con un «¿seguro?».
  yad --question --center --width=460 --title="Apagar $nombre" \
    --text="<b>¿Apagar $nombre?</b>\n\nSe hará con orden:\n  · se cierra su Windows sin perder nada\n  · se arma el despertador y se COMPRUEBA\n  · deja dicho en la nube a qué hora vuelve\n\n<small>Se abrirá una terminal para que escribas la contraseña de esa máquina.</small>" \
    --button="No, dejarla:1" --button="Sí, apagar:0" 2>/dev/null || return 1

  # El centro de apoyo no tiene horario ni guion de apagado, así que se
  # mira ALLÁ cuál de los dos caminos existe, en vez de suponerlo desde
  # aquí. Suponerlo es como se apagó mal un servidor la primera vez.
  local ORDEN='if [ -x /usr/local/sbin/redhornoma-apagar-noche ]; then
                  sudo /usr/local/sbin/redhornoma-apagar-noche --ahora
                else
                  echo "   Esta maquina no tiene horario de noche."
                  echo "   Se apaga sin despertador: habra que encenderla a mano."
                  echo
                  sudo systemctl poweroff
                fi'

  local TERM_
  for t in x-terminal-emulator konsole gnome-terminal xfce4-terminal; do
    command -v "$t" >/dev/null 2>&1 && { TERM_="$t"; break; }
  done
  if [ -z "${TERM_:-}" ]; then
    yad --error --center --width=420 --title="Falta la terminal" \
      --text="No encuentro con qué abrir una terminal.\n\nHazlo a mano:\n<tt>ssh -t $destino 'sudo /usr/local/sbin/redhornoma-apagar-noche --ahora'</tt>" \
      --button="Entendido:0" 2>/dev/null
    return 1
  fi

  # El «--hold»/«-hold» mantiene la ventana abierta al terminar: si se
  # cerrara sola, el mensaje con la hora de vuelta se perdería justo
  # cuando más falta hace leerlo.
  case "$TERM_" in
    konsole|x-terminal-emulator)
      "$TERM_" --hold -e bash -c "ssh -t '$destino' '$ORDEN'" 2>/dev/null & ;;
    *)
      "$TERM_" -- bash -c "ssh -t '$destino' '$ORDEN'; echo; read -p 'Pulsa Intro para cerrar'" 2>/dev/null & ;;
  esac
}


nadie_marcado(){
  # 🔴 EL 20/08/2026, ESTO LE HIZO PERDER MEDIA HORA A euflo.
  #
  # Pulsó «Poner al día», la tabla se cerró, y no volvió nunca. Estuvimos
  # buscando el fallo en el código que reabre la pantalla —que funcionaba
  # perfectamente— cuando la causa era otra: había pulsado el botón SIN
  # MARCAR UN CENTRO ANTES, y el programa se cerraba en silencio.
  #
  # Con seis botones y una fila que no salta a la vista al marcarla, eso
  # va a pasar muchas veces. Y cerrarse sin decir nada es lo peor que
  # puede hacer: quien lo ve no sabe si el programa está roto, si no ha
  # entendido, o si se equivocó él.
  #
  # Ahora lo dice y vuelve a abrir la tabla.
  yad --info --center --width=440 --borders=20 --title="Elige un centro" \
    --image=dialog-information \
    --text="<span size='x-large'><b>Primero marca un centro</b></span>\n\nHaz clic en la fila del centro —que se quede resaltada— y después pulsa el botón." \
    --button="Entendido:0" 2>/dev/null
  exec "$0"
}

# ── Encender, que son DOS escalones ───────────────────────────────────
#
# EL PORQUÉ — lo vio euflo el 20/08/2026 mirando la pantalla:
#
#   «En el caso de Hornoma debería ver dos cosas: encender la distro y
#    después encender Windows. Porque Windows está DENTRO de RedHornoma:
#    si RedHornoma está apagada, va a ser difícil entrar a su Windows.»
#
# Tenía razón, y era un botón que mentía: con el centro apagado, «Entrar a
# su Windows» no podía funcionar de ninguna manera.
#
# Son dos escalones, y hay que subirlos en orden:
#
#     1 · la computadora del centro (RedHornoma)
#     2 · el Windows que vive dentro
#
# El 2 se puede hacer desde aquí. El 1 NO: una máquina apagada no escucha
# por la red, y en el centro no queda nadie despierto que le pueda avisar.
# Para ese se dan los pasos del enchufe inteligente, que es lo único que
# funciona de verdad — y se dice claro que hay que hacerlo con el teléfono,
# en vez de fingir un botón que no puede hacer nada.
encender(){
  local destino="$1" nombre="$2" estado="$3" windows="$4"

  # ── Escalón 1: la computadora está apagada ──
  if [ "$estado" != "despierto" ]; then
    yad --center --width=560 --borders=20 --title="Encender $nombre" \
      --image=system-shutdown \
      --text="<span size='x-large'><b>$nombre está apagada</b></span>\n\nNo se puede encender por la red: una computadora apagada no escucha.\n\n<b>Se hace con el teléfono</b>, en la aplicación <b>Smart Life</b>, y funciona con datos móviles:\n\n   1 · busca la toma donde está esa computadora\n   2 · <b>apágala</b>\n   3 · espera 10 segundos\n   4 · <b>enciéndela</b>\n\n<i>El apagar-y-encender es lo que la arranca. Si la toma ya estaba encendida, darle a «encender» no hace nada.</i>\n\nTarda un par de minutos. Después pulsa «Actualizar»." \
      --button="Entendido:0" 2>/dev/null
    return 0
  fi

  # ── Escalón 2: la computadora está viva; ¿y su Windows? ──
  if [ "$windows" != "ninguno" ] && [ -n "$windows" ] && [ "$windows" != "—" ]; then
    yad --info --center --width=460 --borders=20 --title="$nombre" \
      --text="<b>Ya está todo encendido.</b>\n\nSu Windows «$windows» está en marcha.\n\nPulsa «Entrar a su Windows»." \
      --button="Entendido:0" 2>/dev/null
    return 0
  fi

  yad --question --center --width=480 --borders=20 --title="Encender el Windows de $nombre" \
    --text="<span size='x-large'><b>$nombre está encendida</b></span>\n\nPero su Windows no está en marcha, y es ahí donde están SOAPS, SALMI y SNIS.\n\n¿Lo enciendo?" \
    --button="Ahora no:1" --button="Sí, encenderlo:0" 2>/dev/null || return 0

  # Se arranca la primera máquina que ese centro tenga definida. Y se
  # COMPRUEBA que arrancó, en vez de dar por hecho que la orden bastó.
  ( yad --progress --pulsate --auto-close --no-buttons --undecorated --center \
        --width=460 --title="Encendiendo" \
        --text="\n<b>Encendiendo el Windows de $nombre…</b>\n\n<i>Tarda entre medio minuto y un minuto.</i>\n" 2>/dev/null ) &
  local ESP=$!
  timeout 60 ssh -n -o BatchMode=yes -o ConnectTimeout=15 "$destino" \
    'V=$(LC_ALL=C virsh -c qemu:///system list --all --name 2>/dev/null | grep -v "^$" | head -1)
     [ -n "$V" ] && virsh -c qemu:///system start "$V" >/dev/null 2>&1' >/dev/null 2>&1

  local T=0 VIVO=""
  while [ "$T" -lt 75 ]; do
    VIVO=$(timeout 20 ssh -n -o BatchMode=yes -o ConnectTimeout=8 "$destino" \
             'LC_ALL=C virsh -c qemu:///system list --name --state-running 2>/dev/null | grep -v "^$" | head -1' 2>/dev/null)
    [ -n "$VIVO" ] && break
    sleep 5; T=$((T+5))
  done
  kill "$ESP" 2>/dev/null

  if [ -n "$VIVO" ]; then
    yad --info --center --width=460 --borders=20 --title="$nombre" \
      --text="<span size='large'><b>Listo: «$VIVO» está en marcha.</b></span>\n\nDale un minuto a Windows para terminar de arrancar y pulsa «Entrar a su Windows»." \
      --button="Entendido:0" 2>/dev/null
  else
    yad --error --center --width=500 --borders=20 --title="$nombre" \
      --text="<b>No se pudo encender su Windows.</b>\n\nLa computadora del centro sí responde, así que se puede entrar a ella para mirar qué pasa." \
      --button="Entendido:0" 2>/dev/null
  fi
}


# ── Poner un centro al día, desde aquí ────────────────────────────────
#
# EL PORQUÉ — 20/08/2026
#
# Es el objetivo 11 —atender varios centros desde un solo sitio— y era el
# hueco más evidente, porque saltaba a la vista en cada sesión de trabajo:
# cada vez que salía una mejora, había que escribir a mano
#
#     ssh -t hornoma 'sudo apt update && sudo apt install -y redhornoma-…'
#
# y acordarse de QUÉ paquetes nombrar. En dos días eso se escribió más de
# diez veces. Una herramienta que existe para no ir de una máquina a otra
# no puede obligar a escribir un comando por máquina.
#
# 🔴 Se actualiza SOLO lo de RedHornoma, y no todo el sistema.
#
# Un «full-upgrade» en el servidor de un centro puede traerse por delante
# el núcleo o los programas de virtualización, y eso pide reiniciar en un
# sitio donde reiniciar cuesta un viaje de 100 km. Aquí se pregunta a la
# propia máquina qué paquetes de RedHornoma tiene puestos y se actualizan
# esos. Lo demás se deja como está, a propósito.
#
# Y va en una terminal por lo mismo que el apagado: la contraseña la
# escribe la persona donde va, y de paso VE lo que dice cada paquete al
# instalarse — que es donde aparecen los avisos que importan.
al_dia(){
  local destino="$1" nombre="$2" estado="$3"

  if [ "$estado" != "despierto" ]; then
    yad --info --center --width=440 --borders=20 --title="$nombre" \
      --text="<b>$nombre no contesta.</b>\n\nPara ponerla al día tiene que estar encendida." \
      --button="Entendido:0" 2>/dev/null
    return 0
  fi

  yad --question --center --width=500 --borders=20 --title="Poner al día $nombre" \
    --text="<span size='x-large'><b>Poner al día $nombre</b></span>\n\nSe actualizarán <b>solo los programas de RedHornoma</b>. El resto del sistema se queda como está.\n\n<small>Se abrirá una terminal para que escribas la contraseña de esa máquina.</small>" \
    --button="Ahora no:1" --button="Sí, ponerla al día:0" 2>/dev/null || return 0

  # Los paquetes se los pregunta a ELLA, no se escriben aquí: cada centro
  # puede tener puestos unos u otros, y una lista escrita a mano envejece.
  local ORDEN='P=$(dpkg-query -W -f="\${Package} " "redhornoma-*" 2>/dev/null)
               if [ -z "$P" ]; then echo "   Esta maquina no tiene programas de RedHornoma."; exit 1; fi
               echo "   Poniendo al dia: $P"; echo
               sudo apt update -qq && sudo apt install -y --only-upgrade $P'

  local TERM_
  for t in x-terminal-emulator konsole gnome-terminal xfce4-terminal; do
    command -v "$t" >/dev/null 2>&1 && { TERM_="$t"; break; }
  done
  [ -n "${TERM_:-}" ] || { yad --error --center --width=440 \
      --text="No encuentro con qué abrir una terminal." --button="Entendido:0" 2>/dev/null; return 1; }

  case "$TERM_" in
    konsole|x-terminal-emulator)
      "$TERM_" --hold -e bash -c "ssh -t '$destino' '$ORDEN'" 2>/dev/null & ;;
    *)
      "$TERM_" -- bash -c "ssh -t '$destino' '$ORDEN'; echo; read -p 'Pulsa Intro para cerrar'" 2>/dev/null & ;;
  esac
}

# ── Modo entrar directo ───────────────────────────────────────────────
if [ "$MODO" = "entrar" ]; then
  D=$(listar_centros | awk -F'|' -v c="$CUAL" 'tolower($1) ~ tolower(c) || $2 ~ c {print $2; exit}')
  [ -n "$D" ] || { echo "No encuentro el centro «$CUAL»"; listar_centros | awk -F'|' '{print "   " $1}'; exit 1; }
  # Mirar ANTES de intentar. Sin esto, con el centro apagado el visor se
  # queda esperando sin decir nada y parece que la orden no hizo efecto.
  E=$(mirar "$D"); EST="${E%%|*}"
  if [ "$EST" != "despierto" ]; then
    printf "   ${RO}✗${V} %s NO CONTESTA — no se puede entrar.\n" "$CUAL"
    printf "      Puede estar apagada, o encendida pero sin internet: desde\n"
    printf "      aquí las dos cosas se ven igual. Lo que sí es seguro es que\n"
    printf "      no se puede encender desde fuera.\n\n"
    exit 1
  fi
  entrar "$D" "$CUAL"; exit $?
fi

# ── Recoger el estado de todos ────────────────────────────────────────
FILAS=""
while IFS='|' read -r NOMBRE DESTINO; do
  [ -n "$DESTINO" ] || continue
  EST=$(mirar "$DESTINO")
  FILAS="$FILAS$NOMBRE|$DESTINO|$EST"$'\n'
done < <(listar_centros)

# ── Escrito ───────────────────────────────────────────────────────────
if [ "$MODO" = "texto" ] || ! command -v yad >/dev/null 2>&1 || [ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
  printf "\n${AZ}══════════════════════════════════════════════════════${V}\n"
  printf "${AZ} LOS CENTROS QUE ATIENDES${V}\n"
  printf "${AZ}══════════════════════════════════════════════════════${V}\n\n"
  [ -n "$FILAS" ] || { printf "   ${GR}no hay ningún centro configurado${V}\n\n"; exit 0; }
  printf "   %-16s %-12s %-18s %s\n" "CENTRO" "ESTADO" "SU WINDOWS" "ENLACE"
  printf "   %s\n" "────────────────────────────────────────────────────────────────"
  printf '%s' "$FILAS" | while IFS='|' read -r N D E W T; do
    case "$E" in
      despierto) C="${VE}●${V}" ;;
      "no contesta") C="${GR}○${V}" ;;
      *)         C="${AM}?${V}" ;;
    esac
    printf "   %b %-14s %-12s %-18s %s\n" "$C" "$N" "$E" "$W" "$T"
  done
  printf "\n   ${GR}Para entrar a la pantalla de su Windows:${V}\n"
  printf "   ${GR}   redhornoma-centros --entrar hornoma${V}\n\n"
  exit 0
fi

# ── Ventana ───────────────────────────────────────────────────────────
DATOS=""
while IFS='|' read -r N D E W T; do
  [ -n "$N" ] || continue
  case "$E" in
    despierto) ICO="🟢"; DET="listo para entrar" ;;
    "no contesta") ICO="⚪"; DET="no contesta — apagada o sin internet" ;;
    *)         ICO="🟡"; DET="responde, pero no deja entrar" ;;
  esac
  [ "$W" = "ninguno" ] && [ "$E" = "despierto" ] && DET="encendido, pero su Windows está apagado"
  # 🔴 UN DATO POR LÍNEA, no una fila por línea — 19/08/2026
  #
  # yad --list lee la lista de la entrada A RAZÓN DE UN DATO POR LÍNEA, y
  # va llenando las columnas de izquierda a derecha. No entiende filas
  # separadas por «|», y tampoco sirve «--item-separator», que es para
  # otra cosa.
  #
  # Aquí se le pasaba una fila entera por línea. Resultado: TODA la fila
  # caía en la primera casilla, y la fila siguiente en la segunda. La
  # ventana se abría, tenía sus columnas y sus botones, y era mentira.
  #
  # Y encima el fallo no se veía como un fallo: al pulsar «Entrar», el
  # programa recibía un texto que no era ninguna dirección, no encontraba
  # el centro, y contestaba «$NOM no contesta» —con el nombre vacío—
  # sobre una máquina que estaba perfectamente despierta.
  #
  # Se descubrió fotografiando la ventana. Leyendo el código no se ve.
  DATOS="$DATOS$ICO"$'\n'"$N"$'\n'"$DET"$'\n'"$W"$'\n'"$T"$'\n'"$D"$'\n'
done < <(printf '%s' "$FILAS")

# Si la ventana no llega a abrirse, NO se sale en silencio: se enseña la
# lista escrita y se dice por qué. Una herramienta muda es lo peor que le
# puede pasar a quien no sabe si está rota o si se equivocó él.
ERRYAD=$(mktemp)
# 🔴 El «--on-top» es de euflo, 20/08/2026: «no vuelve».
#
# Sí volvía — pero DETRÁS de la terminal que se acababa de abrir para
# actualizar el centro. Desde su lado eso es exactamente igual que no
# volver: la tabla desaparece y no pasa nada más.
#
# Una ventana que vuelve donde no se ve no ha vuelto.
# 🔴 LOS NÚMEROS DE LOS BOTONES SON PARES A PROPÓSITO — 20/08/2026
#
# Está en el manual de yad, en «EXIT STATUS», y cuesta media hora de
# trabajo perdido no haberlo leído antes:
#
#     «Even exit code mean to print result, odd just return exit code»
#     (código PAR devuelve lo seleccionado; IMPAR no devuelve nada)
#
# Los números se habían elegido a ojo: 5 para «Poner al día» y 3 para
# «Apagar». Los dos IMPARES. Resultado: esos dos botones recibían la
# selección VACÍA aunque euflo hubiera marcado el centro, y contestaban
# «primero marca un centro». Y como después reabrían la tabla, veía dos
# ventanas seguidas y ningún efecto.
#
# «Entrar a su Windows» (0) y «Encender» (4) son pares, y por eso esos dos
# sí funcionaban. Esa diferencia era la pista, y tardé en verla.
#
# ⚠️ Si alguien añade un botón que necesite saber QUÉ centro está marcado,
# tiene que llevar número PAR. Los impares valen solo para botones que no
# miran la selección, como «Cerrar».
SEL=$(printf '%s' "$DATOS" | yad --list --title="Los centros que atiendes" \
  --width=900 --height=330 --center --on-top \
  --text="<b>1 · Haz clic en un centro para marcarlo.   2 · Pulsa un botón de abajo.</b>\n<small>Los botones no hacen nada si no hay un centro marcado. En «Entrar a su Windows» puedes usar SALMI y SOAPS como si estuvieras sentado allá: los datos no viajan, solo la pantalla.</small>" \
  --column=" " --column="Centro" --column="Cómo está" --column="Su Windows" --column="Enlace" --column="destino:HD" \
  --print-column=2 --separator="" \
  --button="Volver a mirar:2" --button="Cerrar:1" --button="Poner al día:6" --button="Apagar este centro:8" --button="Encender:4" --button="Entrar a su Windows:0" 2>"$ERRYAD")
CODIGO=$?

# 🔴 SE PIDE EL NOMBRE DEL CENTRO, NO UNA COLUMNA OCULTA — 20/08/2026
#
# Antes se pedía la columna 6, que lleva escondida la dirección
# («hornoma@100.81.234.58»). Cómodo… salvo que esta versión de yad NO
# DEVUELVE las columnas ocultas: contestaba vacío SIEMPRE.
#
# El resultado era desconcertante: euflo marcaba el centro, pulsaba el
# botón, y le salía «primero marca un centro». Había marcado. Lo que
# fallaba era que el programa no se enteraba.
#
# Ahora se pide la columna 2 —el nombre, el que se ve— y la dirección se
# busca aquí. Lo que se ve es lo que se puede comprobar.
if [ -n "${SEL:-}" ]; then
  # El nombre puede venir con espacios de más o restos del separador.
  SEL=$(printf '%s' "$SEL" | sed 's/|*$//; s/^[[:space:]]*//; s/[[:space:]]*$//')
  D=$(printf '%s' "$FILAS" | awk -F'|' -v n="$SEL" '$1==n{print $2; exit}')
  # Si no se encuentra por nombre exacto, se prueba por el principio: yad
  # puede recortar un nombre largo, y quedarse callado por eso sería
  # repetir el mismo fallo con otra cara.
  [ -n "$D" ] || D=$(printf '%s' "$FILAS" | awk -F'|' -v n="$SEL" 'index($1,n)==1{print $2; exit}')
  SEL="$D"
fi

if [ "$CODIGO" -ge 250 ] && [ -s "$ERRYAD" ]; then
  printf "\n   ${AM}No se pudo abrir la ventana. Lo que dijo el sistema:${V}\n"
  head -3 "$ERRYAD" | sed 's/^/      /'
  printf "\n   ${GR}Te enseño la lista escrita:${V}\n"
  rm -f "$ERRYAD"
  exec "$0" --texto
fi
rm -f "$ERRYAD"

case "$CODIGO" in
  2) exec "$0" ;;                      # actualizar: mirarlo todo otra vez
  6) [ -n "$SEL" ] || nadie_marcado
     NOM=$(printf '%s' "$FILAS" | awk -F'|' -v d="$SEL" '$2==d{print $1; exit}')
     EST=$(printf '%s' "$FILAS" | awk -F'|' -v d="$SEL" '$2==d{print $3; exit}')
     [ "$EST" = "despierto" ] || EST=$(mirar "$SEL" | cut -d'|' -f1)
     al_dia "$SEL" "${NOM:-ese centro}" "$EST"
     # 🔴 La pantalla VUELVE, y no es un capricho — 20/08/2026.
     #
     # Esta clase de ventana se cierra en cuanto se pulsa cualquier botón.
     # euflo lo dijo enseguida: «cuando hago clic en poner al día, la
     # tabla se elimina». Y tiene razón en que molesta: acaba de mandar
     # una orden a UN centro y se queda sin la lista de los demás, justo
     # cuando lo normal es seguir con el siguiente.
     #
     # Poner al día un centro no termina el trabajo: lo empieza. Así que
     # la pantalla se vuelve a abrir, ya con el estado de ahora.
     exec "$0" ;;
  4) [ -n "$SEL" ] || nadie_marcado
     NOM=$(printf '%s' "$FILAS" | awk -F'|' -v d="$SEL" '$2==d{print $1; exit}')
     EST=$(printf '%s' "$FILAS" | awk -F'|' -v d="$SEL" '$2==d{print $3; exit}')
     WIN=$(printf '%s' "$FILAS" | awk -F'|' -v d="$SEL" '$2==d{print $4; exit}')
     # Igual que en los otros botones: la foto envejece, así que antes de
     # decirle a nadie que su centro está apagado, se vuelve a mirar.
     [ "$EST" = "despierto" ] || { R=$(mirar "$SEL"); EST=${R%%|*}; WIN=$(printf '%s' "$R" | cut -d'|' -f2); }
     encender "$SEL" "${NOM:-ese centro}" "$EST" "$WIN"
     exec "$0" ;;
  8) [ -n "$SEL" ] || nadie_marcado
     NOM=$(printf '%s' "$FILAS" | awk -F'|' -v d="$SEL" '$2==d{print $1; exit}')
     EST=$(printf '%s' "$FILAS" | awk -F'|' -v d="$SEL" '$2==d{print $3; exit}')
     [ "$EST" = "despierto" ] || EST=$(mirar "$SEL" | cut -d'|' -f1)
     if [ "$EST" != "despierto" ]; then
       yad --info --center --width=420 --title="Ya está apagada" \
         --text="<b>$NOM no contesta.</b>\n\nO ya está apagada, o no llega su internet. De cualquier forma, no hay nada que apagar." \
         --button="Entendido:0" 2>/dev/null
       exit 0
     fi
     apagar "$SEL" "$NOM"
     exec "$0" ;;
  0) [ -n "$SEL" ] || nadie_marcado
     NOM=$(printf '%s' "$FILAS" | awk -F'|' -v d="$SEL" '$2==d{print $1; exit}')
     EST=$(printf '%s' "$FILAS" | awk -F'|' -v d="$SEL" '$2==d{print $3; exit}')
     # 🔴 SE VUELVE A MIRAR ANTES DE DAR EL ERROR — 19/08/2026
     #
     # Lo que se ve en la lista es una FOTO del momento en que se abrió la
     # ventana, y el enlace entre centros no está levantado hasta que
     # alguien lo usa: el primer intento se pierde mientras las dos puntas
     # se encuentran.
     #
     # El 19/08 euflo abrió la pantalla con Hornoma recién encendida, la
     # lista dijo «no contesta», y al pulsar «Entrar» le salió que podía
     # estar apagada. La máquina llevaba rato despierta. La foto era vieja,
     # no la máquina.
     #
     # Antes de decirle a nadie que su centro no está, se pregunta otra
     # vez. Cuesta unos segundos y ahorra un susto.
     if [ "$EST" != "despierto" ]; then
       EST=$(mirar "$SEL" | cut -d'|' -f1)
     fi
     if [ "$EST" != "despierto" ]; then
       yad --error --center --width=440 --title="No se puede entrar" \
         --text="<b>$NOM no contesta.</b>\n\nSe ha comprobado dos veces.\n\nPuede estar apagada, o encendida pero sin internet: desde aquí las dos cosas se ven igual.\n\nPara encenderla desde lejos, con el enchufe inteligente: apaga su toma, espera 10 segundos y vuelve a encenderla." \
         --button="Entendido:0" 2>/dev/null
       exit 1
     fi
     # 🔴 El centro responde, pero ¿está su Windows en marcha? Sin él no
     # hay pantalla que abrir, y el visor se quedaría esperando sin
     # explicar nada. Se manda al mismo sitio que el botón «Encender»,
     # que sí sabe qué hacer.
     WIN=$(printf '%s' "$FILAS" | awk -F'|' -v d="$SEL" '$2==d{print $4; exit}')
     case "${WIN:-ninguno}" in
       ninguno|""|—)
         encender "$SEL" "$NOM" "$EST" "ninguno"
         # Después de encenderlo, se vuelve a mirar: si ya está en marcha,
         # se entra sin obligar a dar otra vuelta por la pantalla.
         WIN=$(mirar "$SEL" | cut -d'|' -f2)
         case "${WIN:-ninguno}" in ninguno|""|—) exit 0 ;; esac ;;
     esac
     entrar "$SEL" "$NOM" ;;
esac
exit 0
