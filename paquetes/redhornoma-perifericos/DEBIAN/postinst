#!/bin/sh
# La carpeta compartida se crea sola en el primer arranque.
#
# El enlace que enciende el servicio va DENTRO del paquete, en
# /usr/lib/systemd/system/multi-user.target.wants/. No se crea aquí a
# propósito: «systemctl enable» no funciona dentro del chroot donde se
# construye la ISO, y al fallar en silencio dejaba el servicio apagado.
# Pasó el 2026-08-02 y solo se vio revisando el sistema construido.
set -e

case "$1" in
  configure)
    # El driver oficial de Epson para la L380/L382 es un binario viejo (LSB
    # 3.2) que espera encontrar el cargador dinámico en /lib64/ld-lsb-x86-64.so.3.
    # Debian dejó de traer ese enlace hace años; sin él, el filtro de
    # impresión ni siquiera arranca. El enlace apunta al cargador normal
    # del sistema, así que no cambia nada más.
    if [ ! -e /lib64/ld-lsb-x86-64.so.3 ] && [ -e /lib/x86_64-linux-gnu/ld-linux-x86-64.so.2 ]; then
      ln -s /lib/x86_64-linux-gnu/ld-linux-x86-64.so.2 /lib64/ld-lsb-x86-64.so.3
    fi

    # /run/systemd/system solo existe en una máquina encendida de verdad.
    # Dentro del chroot de la ISO no está, y por eso ahí no se hace nada:
    # allí basta con el enlace, que systemd leerá al arrancar.
    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload >/dev/null 2>&1 || true

      # Ponerlo en marcha AHORA, no en el próximo reinicio.
      #
      # Sin esto, un centro que se actualiza con «apt upgrade» se queda con
      # el servicio instalado y parado hasta que alguien apague la máquina.
      # Y el servidor de un centro de salud no se apaga: está justamente
      # para no apagarse.
      #
      # Se vio el 2026-08-05 en servidor-ciudad: el servicio llevaba tres
      # días instalado sin haberse ejecutado NUNCA. La carpeta compartida
      # funcionaba solo porque alguien corrió la herramienta a mano.
      #
      # Repetirlo no hace daño: la herramienta borra su propio bloque de
      # smb.conf antes de volver a escribirlo, comprueba el resultado con
      # testparm, y si queda mal restaura la configuración anterior.
      systemctl start redhornoma-carpeta-compartida.service >/dev/null 2>&1 || true
    fi
    ;;
esac

exit 0
