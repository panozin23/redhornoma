#!/bin/bash
# redhornoma-discos — Los discos externos, abiertos en Linux Y dentro de
#                     su Windows.
#
# EL PORQUÉ
#
# Un centro mueve información con discos externos: los respaldos que se
# guardan, los instaladores que llegan, lo que se lleva al SEDES. Y el
# Windows de dentro no ve un disco que se enchufa al Linux de fuera: son
# dos mundos distintos.
#
# Hasta el 13/08/2026 esto se hacía con guiones escritos para UN disco
# concreto de UN centro. Aquí no hay ningún modelo escrito dentro: se
# busca lo que haya.
#
# LAS TRAMPAS QUE YA COSTARON UNA NOCHE, Y CÓMO SE EVITAN
#
#   · Buscar el disco por su letra. «sdb» hoy puede ser «sdc» mañana según
#     el orden en que se enchufen las cosas. Se busca por lo que ES:
#     extraíble o por USB.
#
#   · El /etc/fstab solo se lee AL ARRANCAR. Un disco enchufado después no
#     lo monta nadie, y parece que el disco está roto. Aquí se monta en el
#     momento.
#
#   · «nofail» en el fstab no es un adorno: sin él, arrancar con el disco
#     desenchufado deja la máquina parada pidiendo auxilio, en un centro
#     donde no hay quien la atienda.
#
#   · Windows deja el disco marcado como EN USO cuando lo apagan con el
#     «inicio rápido». Desde el 15/08/2026 ESO SE ARREGLA SOLO: quitar esa
#     marca no toca ningún archivo, es un bit. Antes había que volver a
#     escribir el comando con «--forzar», y euflo lo dijo con razón: «en
#     Windows lo colocas y se abre, así de sencillo; en Linux nos hacemos
#     mucho lío». Un disco que no se abre solo es un disco roto para quien
#     lo usa.
#
#     Lo que NO se arregla solo es un Windows HIBERNADO: ahí hay escrituras
#     a medio terminar y tocarlas pierde archivos de verdad. Se distingue
#     por el mensaje y se para.
#
#   · Windows 10 y 11 BLOQUEAN de fábrica entrar a carpetas de red sin
#     contraseña. Samba las sirve bien y Windows se niega sin explicar
#     nada. Se abre solo para su propia máquina virtual.
#
# Uso:
#   redhornoma-discos              qué discos hay y cómo están
#   sudo redhornoma-discos --abrir       montarlos y dárselos a Windows
#   sudo redhornoma-discos --abrir --forzar   insistir cuando ni así se abre
#   sudo redhornoma-discos --soltar      soltarlos para desenchufar
#   sudo redhornoma-discos --siempre     que se abran SOLOS de aquí en adelante
set -u

CONF_SMB=/etc/samba/smb.conf
MARCA_INI='# >>> RedHornoma discos externos'
MARCA_FIN='# <<< RedHornoma discos externos'
MARCA="$(date '+%Y%m%d-%H%M')"

V=$'\033[0m'; AZ=$'\033[1;34m'; VE=$'\033[1;32m'; RO=$'\033[1;31m'; AM=$'\033[1;33m'; GR=$'\033[0;90m'
ok(){  printf "   ${VE}✅${V} %s\n" "$1"; }
mal(){ printf "   ${RO}❌${V} %s\n" "$1"; }
avi(){ printf "   ${AM}⚠️ ${V} %s\n" "$1"; }
nota(){ printf "   ${GR}%s${V}\n" "$1"; }
titulo(){ printf "\n${AZ}══════════════════════════════════════════════════════${V}\n"
          printf "${AZ} %s${V}\n" "$1"
          printf "${AZ}══════════════════════════════════════════════════════${V}\n"; }

ACCION=mirar; FORZAR=no; ESPERAR=0
while [ $# -gt 0 ]; do
  case "$1" in
    --abrir)  ACCION=abrir; shift ;;
    --soltar) ACCION=soltar; shift ;;
    --siempre) ACCION=siempre; shift ;;
    --forzar) FORZAR=si; shift ;;
    --esperar) ESPERAR="${2:-60}"; case "$ESPERAR" in ''|*[!0-9]*) ESPERAR=60 ;; *) shift ;; esac; shift ;;
    -h|--ayuda) sed -n '2,45p' "$0" | sed 's/^# \?//'; exit 0 ;;
    *) echo "No entiendo «$1»"; exit 1 ;;
  esac
done

USUARIO="${SUDO_USER:-$(getent passwd 1000 2>/dev/null | cut -d: -f1)}"
USUARIO="${USUARIO:-$(id -un)}"
BASE="/media/$USUARIO"

# ── Qué discos hay ────────────────────────────────────────────────────
# Se busca por lo que el disco ES, no por su letra: extraíble, o conectado
# por USB y sin el sistema dentro. El disco del sistema NUNCA aparece.
discos_externos(){
  lsblk -dnro NAME,TRAN,RM,TYPE 2>/dev/null | while read -r n tran rm tipo; do
    [ "$tipo" = "disk" ] || continue
    [ "$rm" = "1" ] || [ "$tran" = "usb" ] || continue
    # Y el que tenga montado «/» queda fuera, pase lo que pase.
    lsblk -nro MOUNTPOINT "/dev/$n" 2>/dev/null | grep -qx '/' && continue
    echo "$n"
  done
}

# 🔴 Aquí ponía «lsblk -lnro», y «-l» y «-r» NO se pueden usar juntos:
# lsblk contesta «argumentos mutuamente excluyentes» y no devuelve NADA.
# El guion enseñaba el disco y ninguna partición, como si estuviera vacío.
# «-r» ya da la lista plana; «-l» sobra.
particiones(){ lsblk -nro NAME,FSTYPE "/dev/$1" 2>/dev/null | awk '$2!=""&&$2!="swap"{print $1"|"$2}'; }

# ══ QUE SE ABRAN SOLOS, PARA SIEMPRE ══════════════════════════════════
#
# Sin esto hay que ejecutar «--abrir» a mano cada vez: al reiniciar el
# servidor, y cada vez que se enchufa un disco. Un centro de salud no
# puede depender de que alguien se acuerde de escribir un comando.
#
# Se resuelve con dos piezas:
#   · una regla que avisa cuando aparece un disco por USB
#   · un servicio que entonces ejecuta «--abrir»
#
# Vale para las dos situaciones —arrancar con el disco puesto, y
# enchufarlo después— sin tocar el /etc/fstab, que solo se lee al
# arrancar y por eso no cubre la segunda.
if [ "$ACCION" = "siempre" ]; then
  [ "$(id -u)" = "0" ] || { echo; mal "hace falta sudo"; exit 1; }
  titulo "QUE LOS DISCOS SE ABRAN SOLOS"

  cat > /etc/systemd/system/redhornoma-discos.service <<'FIN'
[Unit]
Description=Abrir los discos externos y dárselos al Windows
# Después de Samba y de la virtualización: hacen falta las dos para
# publicar el disco y poner el icono dentro de Windows.
After=smbd.service libvirtd.service
Wants=smbd.service

[Service]
Type=oneshot
# Un respiro: al enchufar un disco, el sistema tarda un momento en
# reconocer sus particiones. Sin esta espera se intenta abrir lo que
# todavía no está.
# Espera A QUE APAREZCA el disco, no un número fijo de segundos: al
# arrancar tardan, y al enchufarlos ya están.
ExecStart=/usr/bin/redhornoma-discos --abrir --esperar 60
# Sin «SuccessExitStatus=0 1»: eso hacía que systemd diera por bueno un
# fallo. Si no hay discos, la herramienta ya termina con 0 por su cuenta.
RemainAfterExit=no

# 🔴 SIN ESTO, systemd DESMONTA los discos al terminar el servicio.
#
# Un disco NTFS no se monta «y ya está»: deja vivo un programa en segundo
# plano —ntfs-3g— que atiende el disco mientras esté montado. Y systemd,
# cuando un servicio acaba, mata todo lo que ese servicio hubiera dejado
# corriendo. Buena idea en general; aquí se lleva por delante justo lo que
# mantiene el disco abierto.
#
# Se vio en el diario del 13/08/2026, y explica por qué a mano funcionaba
# y por el servicio no:
#     18:58:25  SANSUNG2 abierta
#     18:58:57  ntfs-3g: Unmounting /dev/sdb2 (SANSUNG2)
#     18:58:57  systemd: Deactivated successfully
#
# «process» le dice: mata solo el guion, y deja en paz lo que dejó puesto.
KillMode=process

[Install]
WantedBy=multi-user.target
FIN

  cat > /etc/udev/rules.d/99-redhornoma-discos.rules <<'FIN'
# Cuando aparece una partición en un disco por USB, abrirla y dársela al
# Windows. Puesto por «redhornoma-discos --siempre».
#
# El disco del sistema no entra aquí: va por SATA o NVMe, no por USB. Y
# aunque entrara, la propia herramienta descarta el que tenga «/» montado.
# 🔴 Aquí ponía ENV{ID_BUS}=="usb" y NO ENCAJABA NUNCA: muchos adaptadores
# USB le pasan al sistema la identidad del disco tal cual, y udev dice
# «ID_BUS=ata» aunque esté enchufado por USB. Comprobado el 13/08/2026.
#
# Así que no se filtra aquí: se avisa por cualquier partición que aparezca,
# y es la herramienta la que decide cuál es externa. Ella descarta siempre
# el disco del sistema, así que dispararse de más no hace daño.
ACTION=="add", SUBSYSTEM=="block", ENV{DEVTYPE}=="partition", \
  TAG+="systemd", ENV{SYSTEMD_WANTS}="redhornoma-discos.service"
FIN

  systemctl daemon-reload
  udevadm control --reload-rules 2>/dev/null

  printf "\n   ${AZ}Comprobando que quedó puesto${V}\n"
  if systemctl enable redhornoma-discos.service >/dev/null 2>&1; then
    ok "al arrancar el equipo, se abrirán solos"
  else mal "no se pudo programar para el arranque"; fi
  if [ -f /etc/udev/rules.d/99-redhornoma-discos.rules ]; then
    ok "al enchufar un disco, se abrirá solo"
  else mal "no quedó la regla de los discos"; fi
  # Que systemd entienda el servicio, no solo que el archivo exista.
  if systemd-analyze verify /etc/systemd/system/redhornoma-discos.service >/dev/null 2>&1; then
    ok "el servicio es correcto"
  else avi "systemd puso alguna pega al servicio:"
       systemd-analyze verify /etc/systemd/system/redhornoma-discos.service 2>&1 | head -3 | sed 's/^/      /'; fi

  printf "\n   ${GR}Los discos que ya estén enchufados se abren ahora:${V}\n\n"
  # La ruta entera: si se lanza como «bash redhornoma-discos», «$0» no está
  # en el camino de búsqueda y el exec falla justo al final.
  exec "$(readlink -f "$0")" --abrir
fi

# ── Quitar de Samba lo que ya no está ─────────────────────────────────
#
# 🔴 EL FALLO MÁS PELIGROSO DE TODOS, visto el 13/08/2026.
#
# Si el disco no se monta, la carpeta donde iba a montarse existe y está
# VACÍA. Samba la seguía publicando, y desde Windows se veían dos carpetas
# vacías donde deberían estar los respaldos.
#
# Y lo grave no es el susto: es que si alguien COPIA algo ahí creyendo que
# va al disco externo, va al disco del servidor. Cuando el disco se monte
# encima, esos archivos desaparecen de la vista. Habría guardado sus datos
# en un sitio que no existe, y sin un solo aviso.
#
# Por eso, cada vez que se ejecuta, los recursos se rehacen desde CERO con
# lo que de verdad está montado. Si no hay nada montado, no se publica
# nada: Windows dará un error honesto en vez de enseñar una carpeta vacía.
limpiar_samba(){
  [ -f "$CONF_SMB" ] || return 0
  grep -q "^$MARCA_INI" "$CONF_SMB" 2>/dev/null || return 0
  cp -f "$CONF_SMB" "$CONF_SMB.antes-de-discos-$MARCA" 2>/dev/null
  awk -v a="$MARCA_INI" -v b="$MARCA_FIN" '
    $0==a {d=1; next} $0==b {d=0; next} !d {print}' "$CONF_SMB" > /tmp/smb.limpio
  if ! cmp -s /tmp/smb.limpio "$CONF_SMB"; then
    cp -f /tmp/smb.limpio "$CONF_SMB"
    systemctl restart smbd 2>/dev/null
    avi "quitados de Samba los discos que no están montados"
    nota "mejor un error honesto en Windows que una carpeta vacía"
  fi
  rm -f /tmp/smb.limpio
}

titulo "LOS DISCOS EXTERNOS"

DISCOS=$(discos_externos)

# 🔴 Al arrancar, un disco por USB tarda en existir para el sistema. El
# 13/08/2026 este guion corrió 6 segundos después de encender el servidor,
# dijo «no hay ningún disco enchufado» —y lo había—, y se quedó tan ancho.
#
# Una espera fija siempre es o demasiado corta o demasiado larga. Aquí se
# espera A QUE APAREZCA, mirando cada segundo: si ya está, no se espera
# nada; si tarda, se le da tiempo; si no hay ninguno, se sale al agotarlo.
if [ -z "$DISCOS" ] && [ "$ESPERAR" -gt 0 ]; then
  printf "   ${GR}esperando a que aparezca algún disco (hasta %ss)…${V}\n" "$ESPERAR"
  for _ in $(seq 1 "$ESPERAR"); do
    sleep 1
    DISCOS=$(discos_externos)
    [ -n "$DISCOS" ] && break
  done
fi

if [ -z "$DISCOS" ]; then
  nota "no hay ningún disco externo enchufado"
  [ "$ACCION" = "abrir" ] && limpiar_samba
  echo
  nota "Enchufa uno y vuelve a ejecutarlo. El del sistema no se toca nunca."
  echo
  exit 0
fi

for d in $DISCOS; do
  MOD=$(lsblk -dno MODEL "/dev/$d" 2>/dev/null | sed 's/  */ /g;s/ *$//')
  TAM=$(lsblk -dno SIZE "/dev/$d" 2>/dev/null)
  printf "\n   ${AZ}%s${V}  %s  ${GR}%s${V}\n" "/dev/$d" "$TAM" "${MOD:-sin modelo}"
  for p in $(particiones "$d"); do
    N="${p%%|*}"; F="${p##*|}"
    ETQ=$(lsblk -dno LABEL "/dev/$N" 2>/dev/null); ETQ="${ETQ:-$N}"
    PUNTO=$(findmnt -nro TARGET "/dev/$N" 2>/dev/null | head -1)
    if [ -n "$PUNTO" ]; then
      printf "      %-14s %-8s ${VE}abierta${V} en %s\n" "$ETQ" "$F" "$PUNTO"
    else
      printf "      %-14s %-8s ${GR}cerrada${V}\n" "$ETQ" "$F"
    fi
  done
done

# ── Soltar ────────────────────────────────────────────────────────────
if [ "$ACCION" = "soltar" ]; then
  [ "$(id -u)" = "0" ] || { echo; mal "hace falta sudo"; exit 1; }
  printf "\n   ${AZ}Soltando${V}\n"
  for d in $DISCOS; do
    for p in $(particiones "$d"); do
      N="${p%%|*}"
      PUNTO=$(findmnt -nro TARGET "/dev/$N" 2>/dev/null | head -1)
      [ -n "$PUNTO" ] || continue
      if umount "/dev/$N" 2>/dev/null; then ok "$N soltada"
      else mal "$N no se deja soltar — alguien la está usando"
           fuser -vm "$PUNTO" 2>&1 | head -4 | sed 's/^/      /'; fi
    done
  done
  echo; nota "Ya se pueden desenchufar."
  echo
  exit 0
fi

if [ "$ACCION" = "mirar" ]; then
  printf "\n   ${GR}Para abrirlos y que los vea también el Windows:${V}\n"
  printf "   ${AZ}   sudo redhornoma-discos --abrir${V}\n\n"
  exit 0
fi

# ══ ABRIR ═════════════════════════════════════════════════════════════
[ "$(id -u)" = "0" ] || { echo; mal "hace falta sudo"; exit 1; }

printf "\n   ${AZ}Abriéndolos en Linux${V}\n"
ABIERTAS=""; SUCIOS=0
for d in $DISCOS; do
  for p in $(particiones "$d"); do
    N="${p%%|*}"; F="${p##*|}"
    ETQ=$(lsblk -dno LABEL "/dev/$N" 2>/dev/null); ETQ="${ETQ:-$N}"
    # Un nombre con espacios o barras rompe la ruta y el recurso de red.
    SEG=$(printf '%s' "$ETQ" | tr -c 'A-Za-z0-9_-' '_' | cut -c1-24)
    PUNTO="$BASE/$SEG"

    YA=$(findmnt -nro TARGET "/dev/$N" 2>/dev/null | head -1)
    if [ -n "$YA" ]; then
      ok "$ETQ ya estaba abierta en $YA"; ABIERTAS="$ABIERTAS$SEG|$YA"$'\n'; continue
    fi

    # La carpeta vacía queda SIN PERMISO DE ESCRITURA. Así, si el disco no
    # llega a montarse, nadie —ni Windows ni una persona— puede escribir
    # dentro creyendo que escribe en el disco. Al montarse encima, mandan
    # los permisos del disco y esto deja de verse.
    #
    # 🔴 Antes era «chmod 000», y eso hacía que la carpeta ni siquiera se
    # pudiera ABRIR: el explorador decía «permiso denegado» y nadie entendía
    # por qué. Se veía como una avería del disco cuando era una protección.
    # Con 555 se puede entrar y leer —solo no escribir— y dentro hay un
    # papelito que explica lo que pasa. Protege igual y no asusta.
    mkdir -p "$PUNTO"
    if ! findmnt -nro TARGET "$PUNTO" >/dev/null 2>&1; then
      printf '%s\n' \
        "AQUI NO HAY NINGUN DISCO." \
        "" \
        "Esta carpeta es el sitio donde se abre el disco externo cuando esta" \
        "enchufado. Ahora mismo no lo esta, asi que esto es una carpeta vacia" \
        "del disco de la computadora." \
        "" \
        "Por eso no deja escribir: lo que copiaras aqui NO iria al disco" \
        "externo, se quedaria dentro de esta maquina y desapareceria de la" \
        "vista en cuanto el disco se enchufe." \
        "" \
        "Enchufa el disco y esta carpeta se llenara sola." > "$PUNTO/LEEME-NO-HAY-DISCO.txt" 2>/dev/null
      chmod 555 "$PUNTO" 2>/dev/null
    fi
    U=$(id -u "$USUARIO"); G=$(id -g "$USUARIO")
    ERR=""
    case "$F" in
      ntfs*) mount -t ntfs3 -o "rw,uid=$U,gid=$G,windows_names" "/dev/$N" "$PUNTO" 2>/dev/null \
             || ERR=$(mount -t ntfs-3g -o "rw,uid=$U,gid=$G" "/dev/$N" "$PUNTO" 2>&1) ;;
      exfat|vfat) ERR=$(mount -o "rw,uid=$U,gid=$G" "/dev/$N" "$PUNTO" 2>&1) ;;
      *)     ERR=$(mount -o rw "/dev/$N" "$PUNTO" 2>&1) ;;
    esac

    # 🔴 Si no se deja ESCRIBIR, se intenta LEER antes de rendirse.
    #
    # El 13/08/2026 esta herramienta se rindió con un disco que no montaba
    # para escritura, y no probó a leerlo. La diferencia entre «no puedo
    # usarlo» y «puedo salvar lo que hay dentro» es exactamente esa, y con
    # un disco tocado es la diferencia que importa.
    if ! findmnt -nro TARGET "$PUNTO" >/dev/null 2>&1; then
      case "$F" in
        ntfs*) mount -t ntfs3 -o "ro,uid=$U,gid=$G" "/dev/$N" "$PUNTO" 2>/dev/null \
               || mount -t ntfs-3g -o "ro,uid=$U,gid=$G" "/dev/$N" "$PUNTO" 2>/dev/null ;;
        *)     mount -o ro "/dev/$N" "$PUNTO" 2>/dev/null ;;
      esac
      if findmnt -nro TARGET "$PUNTO" >/dev/null 2>&1; then
        avi "$ETQ se abrió SOLO PARA LEER en $PUNTO"
        nota "no deja escribir, pero lo que hay dentro se puede copiar"
        nota "para dejarlo escribible: pásale «chkdsk /f» en Windows"
        ABIERTAS="$ABIERTAS$SEG|$PUNTO"$'\n'
        continue
      fi
    fi

    if findmnt -nro TARGET "$PUNTO" >/dev/null 2>&1; then
      ok "$ETQ abierta en $PUNTO"; ABIERTAS="$ABIERTAS$SEG|$PUNTO"$'\n'
    else
      mal "$ETQ no se dejó abrir ni siquiera para leer"
      [ -n "$ERR" ] && printf '%s\n' "$ERR" | head -2 | sed 's/^/         /'
      # ¿Por qué no se dejó abrir? Hay dos casos y NO son lo mismo.
      #
      # 🔴 Hasta el 15/08/2026 se trataban igual: los dos pedían que la
      # persona volviera a escribir el comando con «--forzar». Y euflo lo
      # dijo con razón: «en Windows lo colocas y se abre, así de sencillo;
      # en Linux nos hacemos mucho lío». Tenía razón — un disco que no se
      # abre solo es un disco roto para quien lo usa.
      HIBERNADO=no; MARCADO=no
      case "$ERR" in
        *hibernat*|*hiberfil*)               HIBERNADO=si ;;
        *[Dd]irty*|*unclean*|*"was not shut down"*|*"Metadata kept"*) MARCADO=si ;;
      esac

      # Caso 1 · HIBERNADO. Aquí NO se toca nada. El Windows no está
      # apagado: está dormido, con media escritura por terminar guardada en
      # su archivo de hibernación. Escribir encima es la forma más rápida de
      # perder lo que hay. Se dice y se para.
      if [ "$HIBERNADO" = "si" ]; then
        SUCIOS=2
        avi "el Windows de este disco está DORMIDO, no apagado"
        nota "hay que encenderlo y apagarlo del todo antes de tocarlo aquí"

      # Caso 2 · solo MARCADO como en uso. Esto sí se arregla solo: es el
      # «inicio rápido» de Windows, que al apagar no cierra del todo y deja
      # una banderita puesta. Quitarla no toca ni un archivo: es un bit.
      elif [ "$MARCADO" = "si" ] && command -v ntfsfix >/dev/null 2>&1; then
        avi "venía marcada como EN USO por Windows — se limpia sola"
        printf "   %-30s " "quitando la marca"
        ntfsfix -d "/dev/$N" >/dev/null 2>&1
        if mount -t ntfs3 -o "rw,uid=$U,gid=$G,windows_names" "/dev/$N" "$PUNTO" 2>/dev/null \
           || mount -t ntfs-3g -o "rw,uid=$U,gid=$G" "/dev/$N" "$PUNTO" 2>/dev/null; then
          printf "${VE}abierta${V}\n"; ABIERTAS="$ABIERTAS$SEG|$PUNTO"$'\n'
          rm -f "$PUNTO/LEEME-NO-HAY-DISCO.txt" 2>/dev/null
          continue
        else printf "${RO}sigue sin abrirse${V}\n"; SUCIOS=1; fi
      fi

      # Y si aun así se pidió --forzar, se intenta igual: puede ser un caso
      # que no supimos leer en el mensaje de error.
      if [ "$FORZAR" = "si" ] && [ "$HIBERNADO" = "no" ] && command -v ntfsfix >/dev/null 2>&1; then
        printf "   %-30s " "limpiando la marca"
        ntfsfix -d "/dev/$N" >/dev/null 2>&1
        if mount -t ntfs3 -o "rw,uid=$U,gid=$G,windows_names" "/dev/$N" "$PUNTO" 2>/dev/null \
           || mount -t ntfs-3g -o "rw,uid=$U,gid=$G" "/dev/$N" "$PUNTO" 2>/dev/null; then
          printf "${VE}abierta${V}\n"; ABIERTAS="$ABIERTAS$SEG|$PUNTO"$'\n'
        else printf "${RO}sigue sin abrirse${V}\n"; fi
      fi
      rmdir "$PUNTO" 2>/dev/null
    fi
  done
done

if [ -z "$ABIERTAS" ]; then
  echo
  [ "$SUCIOS" = "2" ] && {
    printf "   ${AM}El Windows de ese disco está DORMIDO, no apagado.${V}\n"
    printf "   Tiene escrituras a medio terminar guardadas. Tocarlo desde aquí\n"
    printf "   es la forma más rápida de perder lo que hay dentro.\n\n"
    printf "   Enciende ese Windows y apágalo del todo —Inicio → Apagar,\n"
    printf "   no cerrar la tapa— y vuelve a enchufarlo.\n\n"; exit 1; }
  [ "$SUCIOS" = "1" ] && {
    printf "   ${AM}Se quitó la marca de Windows y aun así no se abre.${V}\n"
    printf "   Eso ya no es la marca: el disco puede tener el sistema de\n"
    printf "   archivos dañado. Pásale ${AZ}chkdsk /f${V}${AM} en Windows.${V}\n\n"; exit 1; }
  mal "no se pudo abrir ninguna partición"
  limpiar_samba
  echo; exit 1
fi

# ── Dárselos a su Windows ─────────────────────────────────────────────
# Solo a su propia máquina virtual: la red interna de libvirt. Ninguna
# computadora del centro llega ahí, ni estando en la misma red.
printf "\n   ${AZ}Dándoselos a su Windows${V}\n"
IP_PUERTA=$(ip -4 addr show virbr0 2>/dev/null | grep -oP 'inet \K[\d.]+')
if [ -z "$IP_PUERTA" ]; then
  avi "este equipo no tiene máquinas virtuales — los discos quedan solo en Linux"
  echo; exit 0
fi
RED_INT="${IP_PUERTA%.*}."

cp -f "$CONF_SMB" "$CONF_SMB.antes-de-discos-$MARCA" 2>/dev/null && ok "copia de smb.conf guardada"
# Se borra por marcas, no contando líneas: contar es frágil y ya nos costó
# un fstab con entradas duplicadas.
awk -v a="$MARCA_INI" -v b="$MARCA_FIN" '
  $0==a {d=1; next} $0==b {d=0; next} !d {print}' "$CONF_SMB" > /tmp/smb.nuevo
{
  printf '%s\n' "$MARCA_INI"
  printf '# Puesto por redhornoma-discos. NO editar entre las marcas.\n'
  while IFS='|' read -r nom pto; do
    [ -n "$nom" ] || continue
    printf '\n[%s]\n' "$nom"
    printf '   comment = Disco externo %s\n' "$nom"
    printf '   path = %s\n' "$pto"
    printf '   browseable = yes\n   read only = no\n   guest ok = yes\n'
    printf '   force user = %s\n' "$USUARIO"
    printf '   hosts allow = %s 127.\n   hosts deny = 0.0.0.0/0\n' "$RED_INT"
  done <<< "$ABIERTAS"
  printf '%s\n' "$MARCA_FIN"
} >> /tmp/smb.nuevo

# Si no ha cambiado nada, NO se toca Samba. Esto corre en cada arranque y
# cada vez que se enchufa un disco: reiniciar el servicio de carpetas
# compartidas sin motivo cortaría a quien esté copiando algo en ese momento.
if cmp -s /tmp/smb.nuevo "$CONF_SMB"; then
  rm -f /tmp/smb.nuevo
  ok "las carpetas ya estaban publicadas — no se toca Samba"
  SIN_CAMBIOS=si
elif testparm -s /tmp/smb.nuevo >/dev/null 2>&1; then
  cp -f /tmp/smb.nuevo "$CONF_SMB"; rm -f /tmp/smb.nuevo
  ok "configuración de Samba correcta"
else
  mal "la configuración quedaría mal — no se toca nada"
  testparm -s /tmp/smb.nuevo 2>&1 | head -3 | sed 's/^/      /'
  rm -f /tmp/smb.nuevo; exit 1
fi

if [ "${SIN_CAMBIOS:-no}" != "si" ]; then
  systemctl restart smbd 2>/dev/null; sleep 2
fi
systemctl is-active smbd >/dev/null 2>&1 || { mal "smbd no está en marcha"; exit 1; }
ok "carpetas compartidas en marcha"

# ── El icono dentro de Windows ────────────────────────────────────────
VM=$(LC_ALL=C virsh -c qemu:///system list --name --state-running 2>/dev/null | grep -v '^$' | head -1)
if [ -z "$VM" ]; then
  avi "su Windows está apagado — los iconos se pondrán la próxima vez"
else
  GUION=$(mktemp /tmp/rh-discos-XXXXXX.ps1); chmod 600 "$GUION"
  { printf '$puerta = %s\n' "'$IP_PUERTA'"
    printf '$discos = @(%s)\n' "$(while IFS='|' read -r n _; do [ -n "$n" ] && printf "'%s'," "$n"; done <<< "$ABIERTAS" | sed 's/,$//')"; } > "$GUION"
  cat >> "$GUION" <<'PS'
$ErrorActionPreference = 'Continue'
# Windows 10/11 traen PROHIBIDO de fabrica entrar a carpetas de red sin
# contrasena, y no lo explican: la carpeta simplemente no aparece.
$k = 'HKLM:\SYSTEM\CurrentControlSet\Services\LanmanWorkstation\Parameters'
New-ItemProperty -Path $k -Name AllowInsecureGuestAuth -Value 1 -PropertyType DWord -Force | Out-Null
if ((Get-ItemProperty -Path $k -Name AllowInsecureGuestAuth -EA SilentlyContinue).AllowInsecureGuestAuth -eq 1) {
  "OK  permitido entrar sin contrasena" } else { "MAL no se pudo permitir" }
try { Restart-Service LanmanWorkstation -Force -EA Stop; Start-Sleep -Seconds 4; "OK  cliente de red reiniciado" }
catch { "AVISO habra que reiniciar Windows para que lo tome" }

# NO se mapean letras de unidad: el agente corre como SYSTEM y una unidad
# suya no la ve ningun usuario. Van iconos, con la ruta entera.
$esc = Join-Path $env:PUBLIC 'Desktop'
$w = New-Object -ComObject WScript.Shell
foreach ($d in $discos) {
  try {
    $s = $w.CreateShortcut((Join-Path $esc ("Disco " + $d + ".lnk")))
    $s.TargetPath = '\\' + $puerta + '\' + $d
    $s.Description = "Disco externo del servidor"
    $s.Save(); "OK  icono: Disco $d"
  } catch { "MAL icono de $d" }
}
PS
  redhornoma-en-windows --maquina "$VM" --guion "$GUION" 2>&1 | sed 's/^/      /'
  rm -f "$GUION"
fi

# ── La salud del disco, como información ──────────────────────────────
for d in $DISCOS; do
  command -v smartctl >/dev/null 2>&1 || break
  PEND=$(smartctl -A "/dev/$d" 2>/dev/null | awk '/Current_Pending_Sector/{print $10}')
  [ -n "$PEND" ] && [ "$PEND" != "0" ] && {
    printf "\n   ${AM}Salud de /dev/%s:${V} %s sectores que no lee bien.\n" "$d" "$PEND"
    nota "No frena nada. Pero lo que solo esté ahí, no está a salvo."; }
done

printf "\n${AZ}══════════════════════════════════════════════════════${V}\n"
printf "   Dentro de Windows, en el escritorio, hay un icono por disco.\n"
printf "   Y si prefieres escribir la ruta:\n\n"
while IFS='|' read -r n _; do [ -n "$n" ] && printf '      \\\\%s\\%s\n' "$IP_PUERTA" "$n"; done <<< "$ABIERTAS"
printf "\n   Para desenchufarlos:  ${AZ}sudo redhornoma-discos --soltar${V}\n\n"
