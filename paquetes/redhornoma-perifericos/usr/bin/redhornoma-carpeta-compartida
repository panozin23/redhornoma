#!/bin/bash
# redhornoma-carpeta-compartida — Una carpeta que ven Linux y Windows.
#
# Pasar un archivo al Windows virtual no debería obligar a grabar un CD ni
# a buscar un pendrive. Esta carpeta aparece en Windows como una unidad de
# red y en Linux como una carpeta normal.
#
# Para qué sirve en un centro de salud:
#   · sacar los respaldos de SALMI hacia el disco externo
#   · meter los catálogos que manda el Ministerio
#   · llevar informes a imprimir
#
# Uso:
#   redhornoma-carpeta-compartida              mira e informa
#   sudo redhornoma-carpeta-compartida --crear
#
# La carpeta NO se abre a internet: solo la ven las máquinas virtuales de
# este equipo y, si se pide, las computadoras del centro.
set -u

CARPETA=/var/lib/libvirt/compartido
USUARIO_SMB=redhornoma
CONF_SMB=/etc/samba/smb.conf
RESP=/var/backups/redhornoma

CREAR=0; ABRIR_CENTRO=0; SOLO_VISIBLE=0
for a in "$@"; do
  case "$a" in
    --crear) CREAR=1 ;;
    --tambien-el-centro) ABRIR_CENTRO=1 ;;
    # Solo la parte que se ve: el enlace del escritorio y el acceso en el
    # gestor de archivos. Corre al iniciar sesión, como la propia persona y
    # SIN sudo.
    #
    # Va aparte porque es cuestión de MOMENTO: el servicio de arranque corre
    # como root, y en ese instante la carpeta «Escritorio» del usuario puede
    # no existir todavía —se crea al iniciar sesión—. El enlace no aparecería
    # y nadie sabría por qué.
    --visible) SOLO_VISIBLE=1 ;;
    --ayuda|-h) sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  esac
done

V=$'\033[0m'; AZ=$'\033[1;34m'; VE=$'\033[1;32m'; RO=$'\033[1;31m'; AM=$'\033[1;33m'
titulo(){ printf "\n${AZ}══════════════════════════════════════════════════════${V}\n"
          printf "${AZ} %s${V}\n" "$1"
          printf "${AZ}══════════════════════════════════════════════════════${V}\n"; }
ok(){  printf "   ${VE}✅${V} %s\n" "$1"; }
mal(){ printf "   ${RO}❌${V} %s\n" "$1"; }
avi(){ printf "   ${AM}⚠️ ${V} %s\n" "$1"; }
d(){   printf "   %-24s %s\n" "$1" "$2"; }

# ── Que se VEA ────────────────────────────────────────────────────────
#
# Hasta aquí la carpeta funciona, pero vive en /var/lib/libvirt/compartido.
# Nadie que no sea informático va a escribir esa ruta, y quien no la
# encuentra acaba enchufando un pendrive — que es exactamente lo que esto
# venía a evitar.
#
# Objetivo 6 de euflo, con sus palabras: «sin usar código, todo en un
# entorno gráfico de jalar y soltar».
#
# Se pone un enlace en el escritorio y un acceso en la barra lateral del
# gestor de archivos. Un ENLACE a la carpeta, no un lanzador .desktop: al
# enlace se le pueden arrastrar archivos encima y al lanzador no. Jalar y
# soltar tiene que funcionar de verdad, no parecerlo.
visible_para_el_usuario(){
  local U="$1" CASA ESCRITORIO ENLACE
  CASA=$(getent passwd "$U" 2>/dev/null | cut -d: -f6)
  [ -n "$CASA" ] && [ -d "$CASA" ] || return 0

  # El nombre de la carpeta cambia con el idioma: «Escritorio» en español,
  # «Desktop» en inglés. Se le pregunta al sistema en vez de adivinar.
  #
  # Esto corre de dos maneras: como root desde el servicio de arranque, y
  # como la propia persona al iniciar sesión. En el segundo caso no hay
  # sudo ni hace falta.
  if [ "$(id -un)" = "$U" ]; then
    ESCRITORIO=$(xdg-user-dir DESKTOP 2>/dev/null)
  else
    ESCRITORIO=$(sudo -u "$U" env HOME="$CASA" xdg-user-dir DESKTOP 2>/dev/null)
  fi
  if [ -z "$ESCRITORIO" ] || [ "$ESCRITORIO" = "$CASA" ] || [ ! -d "$ESCRITORIO" ]; then
    for posible in "$CASA/Escritorio" "$CASA/Desktop"; do
      [ -d "$posible" ] && ESCRITORIO="$posible" && break
    done
  fi

  if [ -n "$ESCRITORIO" ] && [ -d "$ESCRITORIO" ]; then
    ENLACE="$ESCRITORIO/Pasar a Windows"
    if [ ! -e "$ENLACE" ] || [ -L "$ENLACE" ]; then
      ln -sfn "$CARPETA" "$ENLACE"
      chown -h "$U":"$U" "$ENLACE" 2>/dev/null
      ok "en el escritorio de $U: «Pasar a Windows»"
    fi
  else
    avi "no encontré el escritorio de $U; no puse el enlace"
  fi

  # ── La barra lateral de Dolphin ───────────────────────────────────
  #
  # Solo se toca si el archivo ya existe: si Dolphin no se ha abierto nunca,
  # lo crea él al arrancar y machacaría lo que pusiéramos.
  #
  # Se inserta el texto justo antes de </xbel>, SIN releer y reescribir el
  # XML entero. El primer intento usaba ElementTree y corrompía el archivo:
  # al reescribirlo descartaba la declaración «xmlns:bookmark» de la primera
  # línea y dejaba huérfana la etiqueta «bookmark:icon». Dolphin se quedaba
  # sin barra lateral —«unbound prefix»— y nadie habría sabido por qué.
  #
  # Tocar lo mínimo deja el resto del archivo byte por byte como estaba.
  local LUGARES="$CASA/.local/share/user-places.xbel"
  if [ -f "$LUGARES" ] && command -v python3 >/dev/null 2>&1; then
    if python3 - "$LUGARES" "$CARPETA" <<'PY'
import sys, xml.etree.ElementTree as ET
ruta, carpeta = sys.argv[1], sys.argv[2]
url = "file://" + carpeta
texto = open(ruta, encoding="utf-8").read()

# Ya está: esto corre en cada arranque y no debe duplicar.
if 'href="%s"' % url in texto:
    sys.exit(0)
if "</xbel>" not in texto:
    sys.exit(1)

entrada = (' <bookmark href="%s">\n'
           '  <title>Pasar a Windows</title>\n'
           '  <info>\n'
           '   <metadata owner="http://freedesktop.org">\n'
           '    <bookmark:icon name="folder-windows"/>\n'
           '   </metadata>\n'
           '  </info>\n'
           ' </bookmark>\n') % url

nuevo = texto.replace("</xbel>", entrada + "</xbel>", 1)

# Comprobar ANTES de escribir. Un archivo de lugares roto deja al usuario
# sin barra lateral, y arreglarlo a mano no está al alcance de nadie en un
# centro de salud.
try:
    ET.fromstring(nuevo)
except ET.ParseError:
    sys.exit(1)

open(ruta, "w", encoding="utf-8").write(nuevo)
PY
    then
      chown "$U":"$U" "$LUGARES" 2>/dev/null
      ok "en la barra lateral del gestor de archivos"
    fi
  fi

  # ── Los gestores de archivos de GTK ───────────────────────────────
  #
  # NUNCA se crea .config aquí. La primera versión hacía
  #
  #     mkdir -p "$CASA/.config/gtk-3.0"
  #
  # y como esto llegó a ejecutarse como root antes del primer inicio de
  # sesión, dejaba **/home/usuario/.config perteneciendo a root**. Después
  # KDE, que corre como la persona, no podía escribir nada dentro: ksmserver,
  # kded6, kcminit y KDE Connect llenaban la pantalla de avisos de
  # «archivo de configuración no escribible». Un escritorio inservible por
  # querer añadir un marcador.
  #
  # Se vio el 2026-08-06 al arrancar la ISO en el banco de pruebas.
  #
  # Ahora: solo se escribe si la carpeta YA existe, y eso solo ocurre cuando
  # la persona ya ha iniciado sesión alguna vez. Si no existe, no pasa nada:
  # el enlace del escritorio y el acceso de Dolphin ya cumplen el objetivo.
  local GTK="$CASA/.config/gtk-3.0/bookmarks"
  if [ -d "$CASA/.config/gtk-3.0" ] \
     && ! grep -qs "^file://$CARPETA " "$GTK" 2>/dev/null; then
    printf 'file://%s Pasar a Windows\n' "$CARPETA" >> "$GTK"
    [ "$(id -u)" = "0" ] && chown "$U":"$U" "$GTK" 2>/dev/null
  fi
}

# ── Modo «solo lo que se ve» ──────────────────────────────────────────
# Lo lanza /etc/xdg/autostart al iniciar sesión, como la propia persona.
# No necesita sudo, no toca Samba, y sale en silencio si no hay nada que
# hacer: se ejecuta en CADA inicio de sesión y no debe molestar.
if [ "$SOLO_VISIBLE" = "1" ]; then
  [ -d "$CARPETA" ] || exit 0
  visible_para_el_usuario "$(id -un)" >/dev/null 2>&1
  exit 0
fi

echo

titulo "CARPETA COMPARTIDA CON WINDOWS"

# ── Dónde llegarán las máquinas virtuales ─────────────────────────────
# Cada máquina virtual ve a su anfitrión en la red interna de libvirt,
# normalmente en 192.168.122.1. Esa es la dirección que hay que darle a
# Windows, no la del equipo en la red del centro.
IP_VIRT=$(ip -4 -o addr show virbr0 2>/dev/null | grep -oP 'inet \K[\d.]+')
RT=$(ip route get 1.1.1.1 2>/dev/null | head -1)
IP_LAN=$(echo "$RT" | grep -oP 'src \K\S+')
RED_LAN=$(echo "$IP_LAN" | cut -d. -f1-3)

d "Carpeta:" "$CARPETA"
[ -n "$IP_VIRT" ] && d "La verán en:" "\\\\$IP_VIRT\\compartido" \
                  || avi "no hay red virtual (virbr0) — ¿está libvirt encendido?"
d "Este equipo en el centro:" "${IP_LAN:-sin red}"

# ── Estado actual ─────────────────────────────────────────────────────
echo
[ -d "$CARPETA" ] && ok "la carpeta existe" || avi "la carpeta todavía no existe"

if ! command -v smbd >/dev/null 2>&1 && [ ! -x /usr/sbin/smbd ]; then
  avi "falta Samba, que es lo que la hace visible desde Windows"
  echo "         sudo apt install samba"
  FALTA_SAMBA=1
else
  FALTA_SAMBA=0
  systemctl is-active smbd >/dev/null 2>&1 && ok "Samba en marcha" || avi "Samba parado"
  grep -q '^\[compartido\]' "$CONF_SMB" 2>/dev/null \
    && ok "la carpeta ya está publicada" \
    || avi "la carpeta aún no está publicada"
fi

if [ "$CREAR" = "0" ]; then
  titulo "PARA CREARLA"
  cat <<FIN
   Ejecuta lo mismo añadiendo --crear:

      ${AZ}sudo redhornoma-carpeta-compartida --crear${V}

   Y si además quieres que la vean las otras computadoras del centro
   —no solo las máquinas virtuales de este equipo—:

      ${AZ}sudo redhornoma-carpeta-compartida --crear --tambien-el-centro${V}

FIN
  exit 0
fi

[ "$(id -u)" = "0" ] || { mal "hace falta sudo"; exit 1; }
[ "$FALTA_SAMBA" = "1" ] && { mal "instala Samba primero: sudo apt install samba"; exit 1; }

# ═════════════════════════════════════════════════════════════════════
titulo "CREANDO"

mkdir -p "$CARPETA" "$RESP"
chmod 2775 "$CARPETA"
# Que el usuario del escritorio pueda dejar archivos ahí sin sudo.
#
# Con «sudo» sabemos quién lo lanzó. Pero esto también corre solo en el
# primer arranque, desde systemd, donde no hay SUDO_USER: entonces se busca
# al usuario de la persona —el primero que creó el instalador, UID 1000—.
# Si quedara como root, la carpeta no serviría para nada: nadie podría
# dejar archivos en ella sin sudo, que es justo lo que viene a evitar.
DUENO="${SUDO_USER:-$(getent passwd 1000 2>/dev/null | cut -d: -f1)}"
DUENO="${DUENO:-root}"
chown "$DUENO":"$DUENO" "$CARPETA" 2>/dev/null
ok "carpeta lista en $CARPETA"

# ── ¿Hace falta contraseña? ───────────────────────────────────────────
# Depende de QUIÉN puede llegar a la carpeta, no de una regla general.
#
# Si solo la ve la máquina virtual de este mismo equipo —lo normal—, una
# contraseña no protege de nada: quien pueda entrar en esa máquina ya está
# dentro del equipo. Y sí estorba: hay que inventarla, apuntarla y
# escribirla en Windows peleándose con la barra invertida. El 2026-08-02
# ese paso costó media hora y una contraseña olvidada.
#
# Si se abre al centro entero (--tambien-el-centro) entonces sí hace falta:
# ahí ya hay información de pacientes viajando por la red y cualquiera de
# las computadoras puede llegar.
if [ "$ABRIR_CENTRO" = "1" ]; then
  echo
  printf "   ${AZ}Contraseña para entrar desde las computadoras del centro${V}\n"
  echo "      La carpeta se abre a toda la red, así que hace falta."
  echo
  printf "   Contraseña para el usuario «%s»: " "$USUARIO_SMB"
  read -rs CLAVE; echo
  [ ${#CLAVE} -ge 4 ] || { mal "muy corta — al menos 4 caracteres"; exit 1; }

  id "$USUARIO_SMB" >/dev/null 2>&1 || \
    useradd -M -s /usr/sbin/nologin "$USUARIO_SMB" 2>/dev/null
  printf '%s\n%s\n' "$CLAVE" "$CLAVE" | smbpasswd -s -a "$USUARIO_SMB" >/dev/null 2>&1 \
    && ok "usuario «$USUARIO_SMB» listo" || { mal "no se pudo crear el usuario"; exit 1; }
  unset CLAVE
  ACCESO="valid users = $USUARIO_SMB"
else
  ACCESO="guest ok = yes"
  ok "sin contraseña: solo la ve el Windows de este mismo equipo"
fi

# ── Publicar la carpeta ───────────────────────────────────────────────
echo
# Se guarda el nombre exacto de ESTA copia. Antes se restauraba con un
# comodín —«smb.conf.antes-de-*»— y eso funciona la primera vez y solo la
# primera: en cuanto hay dos copias, el comodín devuelve dos nombres y
# «cp» falla porque el destino no es una carpeta. Es decir, la recuperación
# se rompía exactamente el día que hiciera falta usarla.
mkdir -p "$RESP"
COPIA_PREVIA="$RESP/smb.conf.antes-de-$(date '+%Y%m%d-%H%M%S')"
cp -f "$CONF_SMB" "$COPIA_PREVIA" 2>/dev/null || COPIA_PREVIA=""
sed -i '/^\[compartido\]/,/^$/d' "$CONF_SMB" 2>/dev/null

PERMITIDOS="192.168.122. 127."
[ "$ABRIR_CENTRO" = "1" ] && [ -n "$RED_LAN" ] && PERMITIDOS="$PERMITIDOS $RED_LAN."

cat >> "$CONF_SMB" <<CFG

[compartido]
   comment = Carpeta compartida de RedHornoma
   path = $CARPETA
   browseable = yes
   read only = no
   $ACCESO
   force user = $DUENO
   force group = $DUENO
   create mask = 0664
   directory mask = 2775
   hosts allow = $PERMITIDOS
   hosts deny = 0.0.0.0/0
CFG
ok "carpeta publicada"
d "Solo la ven:" "$PERMITIDOS"

if testparm -s >/dev/null 2>&1; then
  ok "la configuración de Samba es correcta"
else
  mal "la configuración de Samba tiene un error"
  if [ -n "$COPIA_PREVIA" ] && [ -f "$COPIA_PREVIA" ]; then
    if cp -f "$COPIA_PREVIA" "$CONF_SMB"; then
      ok "se restauró la configuración anterior — Samba sigue como estaba"
    else
      mal "NO se pudo restaurar. La copia buena está en:"
      echo "      $COPIA_PREVIA"
    fi
  else
    mal "no hay copia de la configuración anterior que restaurar"
  fi
  exit 1
fi


[ "$DUENO" != "root" ] && visible_para_el_usuario "$DUENO"

systemctl enable --now smbd >/dev/null 2>&1
systemctl restart smbd >/dev/null 2>&1
sleep 2
systemctl is-active smbd >/dev/null 2>&1 && ok "Samba en marcha" || avi "revisa: systemctl status smbd"

# El cortafuegos, si está puesto
if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q "^Status: active"; then
  ufw allow in on virbr0 to any port 445 proto tcp >/dev/null 2>&1
  [ "$ABRIR_CENTRO" = "1" ] && ufw allow from "$RED_LAN.0/24" to any port 445 proto tcp >/dev/null 2>&1
  ok "cortafuegos ajustado"
fi

# ═════════════════════════════════════════════════════════════════════
titulo "✅ LISTA — CÓMO SE USA"

cat <<FIN

   ${AZ}En Linux${V}

      Es una carpeta normal:  $CARPETA
      Deja ahí lo que quieras pasar a Windows.

   ${AZ}En Windows${V}

      1. Abre el Explorador de archivos
      2. Escribe esto en la barra de dirección de arriba y pulsa Enter:

            ${AZ}\\\\$IP_VIRT\\compartido${V}

      Y ya está: la carpeta se abre.$([ "$ABRIR_CENTRO" = "1" ] && printf ' Pedirá el usuario\n      «%s» y su contraseña.' "$USUARIO_SMB" || printf ' No pide contraseña.')

      ${AZ}Para tenerla siempre como unidad Z:${V}

      Clic derecho en «Este equipo» → «Conectar a unidad de red»,
      unidad Z:, la misma dirección, y marcar «Conectar de nuevo al
      iniciar sesión».

   ${AZ}Para qué la vas a usar${V}

      · Sacar los respaldos de SALMI hacia el disco externo
      · Meter los catálogos que manda el Ministerio
      · Pasar informes de un lado a otro

   ${AM}Para quitarla${V}

      sudo sed -i '/^\[compartido\]/,/^\$/d' $CONF_SMB
      sudo systemctl restart smbd

FIN
