#!/bin/bash
# redhornoma-windows-agil — Deja el Windows virtual ligero y suelto.
#
# Un centro de salud usa Windows para un puñado de programas, no para
# lucirlo. Y muchas veces se ve desde otra computadora, por red: entonces
# cada animación es una pantalla entera que viaja cifrada. Quitar los
# adornos se nota más que cambiar el hardware.
#
# Todo se hace desde Linux, a través del agente invitado. No hay que
# tocar el teclado de Windows ni entrar en él.
#
# Uso:
#   redhornoma-windows-agil                 mira e informa
#   sudo redhornoma-windows-agil --aplicar
#   sudo redhornoma-windows-agil --aplicar --maquina salud-servidor
#
# Todo es reversible: al final se explica cómo deshacerlo.
set -u

VM=""; APLICAR=0
while [ $# -gt 0 ]; do
  case "$1" in
    --aplicar) APLICAR=1; shift ;;
    --maquina) VM="${2:-}"; shift 2 ;;
    --ayuda|-h) sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "Opción desconocida: $1"; exit 1 ;;
  esac
done

V=$'\033[0m'; AZ=$'\033[1;34m'; VE=$'\033[1;32m'; RO=$'\033[1;31m'; AM=$'\033[1;33m'
titulo(){ printf "\n${AZ}══════════════════════════════════════════════════════${V}\n"
          printf "${AZ} %s${V}\n" "$1"
          printf "${AZ}══════════════════════════════════════════════════════${V}\n"; }
ok(){  printf "   ${VE}✅${V} %s\n" "$1"; }
mal(){ printf "   ${RO}❌${V} %s\n" "$1"; }
avi(){ printf "   ${AM}⚠️ ${V} %s\n" "$1"; }
d(){   printf "   %-30s %s\n" "$1" "$2"; }

VIRSH="virsh -c qemu:///system"

# ── Ejecutar algo dentro de Windows y recoger su respuesta ────────────
en_win(){
  local pet pid r
  pet=$(python3 -c '
import json,sys
print(json.dumps({"execute":"guest-exec","arguments":{
  "path":"cmd.exe","arg":["/c",sys.argv[1]],"capture-output":True}}))' "$1")
  pid=$($VIRSH qemu-agent-command "$VM" "$pet" 2>/dev/null | grep -oP '"pid":\K[0-9]+')
  [ -z "$pid" ] && return 1
  for _ in $(seq 1 25); do
    r=$($VIRSH qemu-agent-command "$VM" \
        "{\"execute\":\"guest-exec-status\",\"arguments\":{\"pid\":$pid}}" 2>/dev/null)
    echo "$r" | grep -q '"exited":true' && break
    sleep 1
  done
  # Windows termina cada línea con un carácter invisible (retorno de
  # carro). Si no se quita, cualquier filtro que busque el final de
  # línea falla sin decir por qué.
  python3 -c '
import json,sys,base64
d=json.loads(sys.stdin.read()).get("return",{})
for k in ("out-data","err-data"):
    if d.get(k): print(base64.b64decode(d[k]).decode("cp850","replace"))' <<< "$r" \
  | tr -d '\r'
}

# ── Ejecutar un programa de Windows con sus argumentos separados ─────
# Al pasar por cmd.exe, una ruta con espacios («Control Panel») pierde
# las comillas y el comando falla con «sintaxis incorrecta». Llamando al
# programa directamente, cada argumento viaja aparte y no hay que citar
# nada.
prog_win(){
  local prog="$1"; shift
  local pet pid r
  pet=$(python3 -c '
import json,sys
print(json.dumps({"execute":"guest-exec","arguments":{
  "path":sys.argv[1],"arg":sys.argv[2:],"capture-output":True}}))' "$prog" "$@")
  pid=$($VIRSH qemu-agent-command "$VM" "$pet" 2>/dev/null | grep -oP '"pid":\K[0-9]+')
  [ -z "$pid" ] && return 1
  for _ in $(seq 1 20); do
    r=$($VIRSH qemu-agent-command "$VM" \
        "{\"execute\":\"guest-exec-status\",\"arguments\":{\"pid\":$pid}}" 2>/dev/null)
    echo "$r" | grep -q '"exited":true' && break
    sleep 1
  done
  python3 -c '
import json,sys,base64
d=json.loads(sys.stdin.read()).get("return",{})
print("SALIDA:%s" % d.get("exitcode","?"))
for k in ("out-data","err-data"):
    if d.get(k): print(base64.b64decode(d[k]).decode("cp850","replace"))' <<< "$r" \
  | tr -d '\r'
}

titulo "DEJAR EL WINDOWS VIRTUAL LIGERO"
if [ "$APLICAR" = "1" ]; then
  printf "   Modo: ${RO}APLICANDO${V}\n"
  # No hace falta sudo: esto no toca el sistema Linux, solo manda
  # órdenes al Windows de la máquina virtual a través de libvirt.
  $VIRSH list >/dev/null 2>&1 || {
    mal "no puedes manejar las máquinas virtuales"
    echo "      Tu usuario debe estar en el grupo «libvirt»:"
    echo "         sudo usermod -aG libvirt \$USER"
    echo "      y después cerrar sesión y volver a entrar."
    exit 1; }
else
  printf "   Modo: ${VE}solo mirar${V}\n"
fi

# ── Qué máquina ───────────────────────────────────────────────────────
if [ -z "$VM" ]; then
  ENCENDIDAS=$($VIRSH list --name 2>/dev/null | grep -v '^$')
  N=$(echo "$ENCENDIDAS" | grep -c .)
  if [ "$N" = "1" ]; then VM="$ENCENDIDAS"
  elif [ "$N" = "0" ]; then
    mal "no hay ninguna máquina encendida"
    echo "      Enciéndela primero: sudo virsh start NOMBRE"
    exit 1
  else
    mal "hay varias máquinas encendidas — elige una con --maquina"
    echo "$ENCENDIDAS" | sed 's/^/         /'
    exit 1
  fi
fi
ok "máquina: $VM"

# ── ¿Responde el agente? ──────────────────────────────────────────────
$VIRSH qemu-agent-command "$VM" '{"execute":"guest-info"}' >/dev/null 2>&1 \
  || { mal "el agente invitado no responde"
       echo "      Instálalo dentro de Windows desde el CD de controladores:"
       echo "         guest-agent\\qemu-ga-x86_64.msi"; exit 1; }
ok "el agente responde"

# ── Quién usa Windows ─────────────────────────────────────────────────
# Los ajustes de aspecto son de cada usuario, no del sistema. Y el agente
# corre como servicio, así que hay que escribir en la rama del usuario
# concreto en vez de en «la mía».
SID=$(en_win 'reg query HKU' 2>/dev/null \
      | grep -oP 'S-1-5-21-[0-9-]+$' | grep -vE '_Classes$' \
      | awk -F- '$NF >= 1000' | head -1)
USUARIO=$(en_win 'query user' 2>/dev/null | awk 'NR==2{print $1}' | tr -d '>')

if [ -z "$SID" ]; then
  avi "no encuentro qué usuario tiene la sesión abierta"
  echo "      Los adornos son ajustes suyos; sin eso solo se puede tocar"
  echo "      lo del sistema. Abre la sesión en Windows y vuelve a probar."
else
  d "Usuario con la sesión:" "${USUARIO:-?}"
  d "Su rama del registro:" "$(echo "$SID" | cut -c1-28)…"
fi

# ═════════════════════════════════════════════════════════════════════
titulo "QUÉ SE VA A CAMBIAR"

cat <<QUE

   ${AZ}Los adornos${V}   — cada animación es una pantalla que viaja por la red
      · Ventanas y menús sin desvanecidos ni deslizamientos
      · Sin sombras ni transparencias
      · Fondo de un color liso en vez de imagen
      · Menús que abren al instante

   ${AZ}Lo que trabaja de fondo${V}   — en un disco mecánico se nota
      · El buscador de Windows deja de indexar el disco
      · La precarga de programas se apaga
      · Edge deja de quedarse cargado sin que nadie lo use (medido: 766 MB)
      · OneDrive y Edge dejan de arrancar solos con la sesión

   ${AZ}Lo que NO se toca${V}
      · SALMI ni sus datos
      · El antivirus ni las actualizaciones
      · Nada de la red

QUE

if [ "$APLICAR" = "0" ]; then
  titulo "PARA APLICARLO"
  printf "      ${AZ}sudo redhornoma-windows-agil --aplicar${V}\n\n"
  exit 0
fi

# ═════════════════════════════════════════════════════════════════════
titulo "APLICANDO"

R="HKU\\$SID"
CAMBIOS=0
poner(){  # clave  valor  tipo  dato   descripción
  local salida
  # Un dato vacío no se puede pasar como argumento: «reg» lo rechaza.
  # Omitiendo /d, el valor queda vacío, que es justo lo que se busca
  # para quitar la imagen de fondo.
  if [ -z "$4" ]; then
    salida=$(prog_win reg.exe add "$1" /v "$2" /t "$3" /f 2>&1)
  else
    salida=$(prog_win reg.exe add "$1" /v "$2" /t "$3" /d "$4" /f 2>&1)
  fi
  case "$salida" in
    SALIDA:0*) ok "$5"; CAMBIOS=$((CAMBIOS+1)) ;;
    *) avi "$5 — no se pudo"
       echo "$salida" | grep -v '^SALIDA:' | grep . | head -1 | sed 's/^/         /' ;;
  esac
}

if [ -n "$SID" ]; then
  printf "\n   ${AZ}Los adornos${V}\n"
  # 2 = «ajustar para obtener el mejor rendimiento»
  poner "$R\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\VisualEffects" \
        VisualFXSetting REG_DWORD 2 "efectos visuales al mínimo"
  poner "$R\\Control Panel\\Desktop\\WindowMetrics" \
        MinAnimate REG_SZ 0 "ventanas sin animación al minimizar"
  poner "$R\\Control Panel\\Desktop" \
        DragFullWindows REG_SZ 0 "arrastrar ventanas sin repintar todo"
  poner "$R\\Control Panel\\Desktop" \
        MenuShowDelay REG_SZ 0 "menús al instante"
  poner "$R\\Software\\Microsoft\\Windows\\DWM" \
        EnableAeroPeek REG_DWORD 0 "sin vista previa transparente"
  poner "$R\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced" \
        ListviewAlphaSelect REG_DWORD 0 "sin selección translúcida"
  poner "$R\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced" \
        TaskbarAnimations REG_DWORD 0 "barra de tareas sin animación"
  # Fondo liso: menos que enviar cada vez que se redibuja
  poner "$R\\Control Panel\\Desktop" Wallpaper REG_SZ "" "fondo sin imagen"
  poner "$R\\Control Panel\\Colors" Background REG_SZ "58 110 165" "fondo azul liso"
fi

printf "\n   ${AZ}Lo que trabaja de fondo${V}\n"
for par in "WSearch:el buscador deja de indexar el disco" \
           "SysMain:la precarga de programas se apaga"; do
  S=${par%%:*}; DESC=${par#*:}
  EXISTE=$(en_win "sc query $S" 2>&1)
  case "$EXISTE" in
    *1060*|*"no existe"*) d "$S:" "no está en este Windows" ;;
    *)  en_win "sc config $S start= disabled" >/dev/null 2>&1
        en_win "sc stop $S" >/dev/null 2>&1
        ok "$DESC"; CAMBIOS=$((CAMBIOS+1)) ;;
  esac
done

printf "\n   ${AZ}Los que corren sin que nadie los llame${V}\n"
# 🔴 MEDIDO EL 17/08/2026, y fue euflo quien lo sospechó: «escuché decir
# que Edge utiliza mucha memoria».
#
# Tenía razón, y por bastante. Con NADIE usándolo:
#
#   Hornoma      Edge: 13 procesos, 766 MB
#   Cochabamba   Edge: 17 procesos, 508 MB
#
# Más que el propio SQL Server, que es para lo que existe la máquina. Edge
# se deja procesos vivos «por si acaso lo abres» —lo llaman arranque
# rápido— y en un servidor de un centro de salud eso no sirve para nada:
# nadie navega ahí.
#
# En Cochabamba había además OneDrive y Copilot arrancando solos. Se
# comprobó: OneDrive NO tenía cuenta ni carpeta, así que no subía nada a
# ninguna parte. Solo gastaba memoria y tocaba el disco.
#
# Lo importante no es la memoria —sobra— sino que en un disco de platos
# cada programa que se despierta le roba la aguja a SQL Server.
poner "HKLM\\SOFTWARE\\Policies\\Microsoft\\Edge" StartupBoostEnabled REG_DWORD 0 \
      "Edge deja de quedarse cargado por si acaso"
poner "HKLM\\SOFTWARE\\Policies\\Microsoft\\Edge" BackgroundModeEnabled REG_DWORD 0 \
      "Edge deja de correr en segundo plano"

# Los que arrancan solos con la sesión. Se quitan del arranque, no se
# desinstalan: si algún día hacen falta, se abren a mano y funcionan.
for par in "OneDrive:OneDrive deja de arrancar solo" \
           "MicrosoftEdgeAutoLaunch:Edge deja de arrancar solo"; do
  V=${par%%:*}; DESC=${par#*:}
  SAL=$(en_win "reg query \"HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Run\" /v $V" 2>&1)
  case "$SAL" in
    *"$V"*) en_win "reg delete \"HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Run\" /v $V /f" >/dev/null 2>&1
            ok "$DESC"; CAMBIOS=$((CAMBIOS+1)) ;;
    *)      d "${V}:" "no arranca solo en este Windows" ;;
  esac
done

# ── Cómo se ven los cambios ──────────────────────────────────────────
# NO se reinicia el escritorio de Windows. El agente corre como servicio,
# en una sesión distinta a la del usuario: puede MATAR explorer.exe pero
# no puede volver a arrancarlo en la sesión de nadie. Resultado: pantalla
# negra y el usuario sin escritorio. Pasó una vez; no vuelve a pasar.
printf "\n   ${AZ}Para que se vean${V}\n"
echo "      Cierra la sesión de Windows y vuelve a entrar."
echo "      Los servicios ya están apagados; lo demás entra al reabrir."

# ═════════════════════════════════════════════════════════════════════
titulo "✅ LISTO — $CAMBIOS AJUSTES"

cat <<FIN

   ${AM}Cierra la sesión de Windows y vuelve a entrar${V} para ver el cambio.
   Inicio → tu nombre de usuario → Cerrar sesión.

   Windows se verá más soso y responderá más rápido. En una pantalla
   que viaja por la red, eso es lo que más se nota.

   ${AZ}Si además la ves desde otra computadora${V}

      Bájale la resolución dentro de Windows. Menos puntos que enviar:

         Configuración → Sistema → Pantalla → Resolución
         1280 x 720  o  1366 x 768  es de sobra para SALMI

   ${AM}Para deshacerlo${V}

      Dentro de Windows, con el ratón:

         Clic derecho en Inicio → Sistema
         → Configuración avanzada del sistema → Rendimiento
         → ⦿ Dejar que Windows elija

      Y para devolver los servicios:

         sc config WSearch start= delayed-auto
         sc config SysMain  start= auto

FIN
