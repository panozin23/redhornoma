#!/bin/bash
# redhornoma-directo-abrir — Lo que se ejecuta al encender, cuando la
#                            computadora entra directa a Windows.
#
# Lo lanza /etc/xdg/autostart, que lo pone «redhornoma-directo --poner».
#
# EL PORQUÉ DE CADA COSA QUE HACE
#
# Abrir el visor a secas no basta. Windows tarda entre 30 segundos y un
# minuto en estar listo, y en ese rato la persona ve un escritorio vacío o
# una ventana en negro. Si además el Windows no arranca —porque se apagó
# mal, porque falta espacio— se queda mirando la nada, sin saber si está
# roto, si tiene que esperar, o si hizo algo mal.
#
# 🔴 Esa es la diferencia entre una prueba piloto que sale bien y un
# susto. Una pantalla que no explica nada es peor que la pantalla de
# contraseña que quitamos.
#
# Así que aquí:
#   · se espera a que el Windows esté de verdad en marcha
#   · mientras tanto se dice qué está pasando
#   · si no arranca, se dice qué hacer, con botones grandes
#   · y siempre hay una salida hacia Linux
set -u

CONF=/etc/redhornoma/directo.conf
ESPERA_MAX=180          # 3 minutos: un disco de platos con Windows tarda

# Solo para la cuenta que se configuró. En /etc/xdg/autostart esto se
# lanza para CUALQUIERA que entre, y si el técnico inicia sesión para
# arreglar algo no queremos secuestrarle la pantalla.
CUENTA=$(grep -oP '^usuario=\K.*' "$CONF" 2>/dev/null)
[ -n "$CUENTA" ] || exit 0
[ "$(id -un)" = "$CUENTA" ] || exit 0

VM=$(grep -oP '^maquina=\K.*' "$CONF" 2>/dev/null)
[ -n "$VM" ] || VM=$(LC_ALL=C virsh -c qemu:///system list --all --name 2>/dev/null | grep -v '^$' | head -1)

encendida(){ LC_ALL=C virsh -c qemu:///system list --name --state-running 2>/dev/null | grep -qx "$VM"; }

# ── Mientras arranca ──────────────────────────────────────────────────
# Una ventana sin botones, en el centro, que se cierra sola cuando el
# Windows está listo. No dice «cargando»: dice qué es y para qué.
espera_abierta(){
  yad --progress --pulsate --auto-close --no-buttons --undecorated \
      --center --width=520 --skip-taskbar \
      --title="RedHornoma" \
      --text="\n<span size='xx-large'><b>RedHornoma</b></span>\n\n<span size='large'>Preparando el sistema del centro…</span>\n\n<i>Esto tarda menos de un minuto. No hay que hacer nada.</i>\n" \
      2>/dev/null &
  ESPERA_PID=$!
}
espera_cerrada(){ [ -n "${ESPERA_PID:-}" ] && kill "$ESPERA_PID" 2>/dev/null; ESPERA_PID=""; }

# ── Si no hay forma ───────────────────────────────────────────────────
# Con botones, grandes, y sin una sola palabra de informático.
no_arranco(){
  yad --center --width=560 --borders=20 --title="El sistema del centro" \
    --image=dialog-warning \
    --text="<span size='x-large'><b>Windows no ha arrancado</b></span>\n\nEl centro no puede trabajar hasta que arranque.\n\nPrueba a <b>volver a intentarlo</b>. Si sigue igual, apaga la computadora del botón, espera diez segundos y vuelve a encenderla.\n\n<i>Si tampoco así, avisa a quien lleva el sistema.</i>" \
    --button="Salir a Linux:1" --button="Volver a intentar:0" 2>/dev/null
}

# ── El bucle ──────────────────────────────────────────────────────────
while true; do
  if ! encendida; then
    espera_abierta
    # Se intenta encenderla: puede que la computadora acabe de arrancar y
    # libvirt todavía no haya llegado a hacerlo.
    virsh -c qemu:///system start "$VM" >/dev/null 2>&1
    T=0
    while ! encendida && [ "$T" -lt "$ESPERA_MAX" ]; do sleep 3; T=$((T+3)); done
    espera_cerrada
  fi

  if ! encendida; then
    no_arranco || exit 0        # «Salir a Linux» → se queda el escritorio
    continue
  fi

  # Ya está en marcha. Aun así hay que esperar un poco: la máquina existe
  # antes de que su pantalla acepte visitas.
  espera_abierta
  sleep 12
  espera_cerrada

  # 🔴 SIN «--reconnect», Y ESO COSTÓ UNA PANTALLA BLANCA — 20/08/2026
  #
  # Con «--reconnect», el visor NO SE CIERRA cuando el Windows se apaga:
  # se queda esperando a que vuelva. euflo apagó Windows desde su menú,
  # vio «apagando equipo»… y la pantalla se quedó EN BLANCO, congelada.
  #
  # Y no era solo feo: mientras el visor sigue abierto, el guion se queda
  # parado en esta línea y nunca llega a la parte que apaga la
  # computadora. La mitad del trabajo de hoy no se ejecutaba jamás.
  #
  # Sin «--reconnect» el visor se cierra cuando el Windows se va, que es
  # justo la señal que necesitamos. Volver a abrirlo lo hace el bucle de
  # aquí abajo, que además puede DECIDIR — y esa decisión es lo que
  # convierte «se apagó Windows» en «se apaga la computadora».
  #
  # Un reinicio de Windows por dentro no cierra el visor: la máquina
  # virtual sigue existiendo y la pantalla se mantiene.
  virt-viewer --connect qemu:///system --full-screen \
              --hotkeys=release-cursor=shift+f12 "$VM" \
              2> >(grep -v "Gtk-WARNING" >&2)

  # Un respiro: la máquina tarda un segundo en pasar de «apagándose» a
  # «apagada», y preguntar demasiado pronto daría la respuesta de antes.
  sleep 4

  # ── Se cerró el visor. ¿Por qué? ───────────────────────────────────
  #
  # 🔴 Aquí está la otra mitad de la idea, y la pidió euflo el 20/08/2026:
  #
  #     «Si enciende directo a Windows, el apagado tiene que ser lo mismo:
  #      la máquina se tiene que apagar toda, Windows y Linux.»
  #
  # Tiene razón. Quien usa esto no sabe que hay un Linux debajo, así que
  # le da a «Apagar» dentro de Windows y se va a su casa. Si la
  # computadora se queda encendida toda la noche con una pantalla rara,
  # el sistema le ha mentido.
  #
  # Se distinguen los dos casos MIRANDO la máquina, no suponiendo:
  #
  #   el Windows está apagado  →  la persona lo apagó: se apaga todo
  #   el Windows sigue vivo    →  se cerró el visor por accidente,
  #                               o lo cerró el técnico: se pregunta
  if ! encendida; then
    # Quince segundos para arrepentirse. Si Windows se cerró por un fallo
    # y no porque nadie lo pidiera, esto evita apagar la computadora de
    # un centro sin que nadie lo haya decidido.
    yad --center --width=520 --borders=20 --title="Apagando" \
        --image=system-shutdown --timeout=15 --timeout-indicator=bottom \
        --text="<span size='x-large'><b>Se apagó Windows</b></span>\n\nLa computadora se va a apagar entera.\n\n<i>Si no querías apagarla, pulsa «No apagar».</i>" \
        --button="No apagar:1" --button="Apagar ahora:0" 2>/dev/null
    RESPUESTA=$?
    # 0 = pulsó «Apagar ahora»   ·   1 = «No apagar»   ·   70 = se agotó
    # el tiempo, que es el caso NORMAL: la persona ya se fue.
    if [ "$RESPUESTA" != "1" ]; then
      # El «-n» es para que no se quede esperando una contraseña que nadie
      # va a escribir: el permiso lo dio «redhornoma-directo --poner».
      sudo -n /usr/bin/redhornoma-apagar >/dev/null 2>&1 && exit 0
      yad --center --width=520 --borders=20 --title="No se pudo apagar" \
        --image=dialog-warning \
        --text="<b>No se pudo apagar la computadora sola.</b>\n\nApágala con su botón." \
        --button="Entendido:0" 2>/dev/null
      exit 0
    fi
    continue            # dijo que no: se vuelve a intentar abrir Windows
  fi

  # El Windows sigue vivo: alguien cerró la ventana. NO se sale en
  # silencio, que dejaría un escritorio que la persona no sabe usar.
  yad --center --width=520 --borders=20 --title="El sistema del centro" \
    --image=dialog-question \
    --text="<span size='x-large'><b>Se cerró la pantalla de Windows</b></span>\n\nWindows sigue funcionando por dentro.\n\n¿Qué quieres hacer?" \
    --button="Salir a Linux:1" --button="Volver a Windows:0" 2>/dev/null || exit 0
done
