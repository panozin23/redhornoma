#!/bin/bash
# redhornoma-windows — Prepara una máquina virtual de Windows para los
# programas de salud (SALMI, SNIS, SOAPS).
#
# Soporta Windows 7, 8.1, 10 y 11. Cada versión necesita un hardware virtual
# distinto y el asistente lo aplica solo.
#
# El principio del proyecto: preguntar a la máquina, nunca suponer. Antes de
# crear nada se le pregunta a libvirt qué acepta ESTE equipo concreto, y se
# ajusta la memoria y el disco a lo que de verdad hay.
#
# Uso:
#   sudo redhornoma-windows                    asistente, paso a paso
#   sudo redhornoma-windows --version 11 --iso /ruta/Win11.iso --nombre salud-servidor
#
# Qué hace:     crea el disco virtual y DEFINE la máquina.
# Qué NO hace:  no la enciende, no instala Windows, no toca tus particiones,
#               no borra nada. Si la máquina ya existe, se detiene sin tocarla.
#
# LICENCIAS: esto solo prepara el hardware virtual. Usar Windows requiere una
# licencia válida, y conseguirla es responsabilidad del centro. RedHornoma no
# incluye ni reparte Windows.
set -u

IMG=/var/lib/libvirt/images
REGISTRO="/tmp/redhornoma-windows-$(date '+%Y%m%d-%H%M').txt"

VERSION=""; ISO_WIN=""; NOMBRE=""; PAPEL=""

V=$'\033[0m'; AZ=$'\033[1;34m'; VE=$'\033[1;32m'; RO=$'\033[1;31m'; AM=$'\033[1;33m'

# El estado de una máquina hay que leerlo SIEMPRE en idioma fijo. En un
# sistema en español virsh responde «ejecutando», no «running», y comparar
# con la palabra inglesa hace creer que falló algo que funcionó bien.
# Los mensajes de error del usuario siguen en español: solo se fija el
# idioma para esta consulta concreta.
estado_vm(){ LC_ALL=C virsh -c qemu:///system domstate "$1" 2>/dev/null | tr -d '\n'; }

titulo(){ printf "\n${AZ}══════════════════════════════════════════════════════${V}\n"
          printf "${AZ} %s${V}\n" "$1"
          printf "${AZ}══════════════════════════════════════════════════════${V}\n"; }
ok(){  printf "   ${VE}✅${V} %s\n" "$1"; }
mal(){ printf "   ${RO}❌${V} %s\n" "$1"; }
avi(){ printf "   ${AM}⚠️ ${V} %s\n" "$1"; }
d(){   printf "   %-22s %s\n" "$1" "$2"; }

while [ $# -gt 0 ]; do
  case "$1" in
    --version) VERSION="${2:-}"; shift 2 ;;
    --iso)     ISO_WIN="${2:-}"; shift 2 ;;
    --nombre)  NOMBRE="${2:-}";  shift 2 ;;
    --papel)   PAPEL="${2:-}";   shift 2 ;;
    --ayuda|-h) sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "Opción desconocida: $1  (usa --ayuda)"; exit 1 ;;
  esac
done

exec > >(tee "$REGISTRO") 2>&1

titulo "PREPARAR WINDOWS PARA LOS PROGRAMAS DE SALUD"
printf "   %s\n" "$(date '+%d de %B de %Y, %H:%M')"

[ "$(id -u)" = "0" ] || { echo; mal "hace falta sudo"; echo "      sudo redhornoma-windows"; exit 1; }

# ═════════════════════════════════════════════════════════════════════
titulo "1 · EXAMINANDO ESTE EQUIPO"

# ── El procesador tiene que poder virtualizar ─────────────────────────
if grep -qm1 ' svm ' /proc/cpuinfo;   then MARCA_CPU=AMD;   ok "procesador AMD con virtualización activa"
elif grep -qm1 ' vmx ' /proc/cpuinfo; then MARCA_CPU=Intel; ok "procesador Intel con virtualización activa"
else
  MARCA_CPU=desconocida
  mal "este procesador no tiene la virtualización disponible"
  echo "      Suele estar apagada en la BIOS. Busca «Virtualization»,"
  echo "      «SVM» o «VT-x», actívala y vuelve a intentarlo."
  exit 1
fi
[ -e /dev/kvm ] || { mal "falta /dev/kvm"; exit 1; }

# ── Encender el motor si está dormido ─────────────────────────────────
# En un equipo recién instalado nadie ha arrancado libvirtd, y sin él
# virt-install falla con un mensaje que no dice nada útil.
if ! virsh -c qemu:///system version >/dev/null 2>&1; then
  systemctl enable --now libvirtd >/dev/null 2>&1 \
    || systemctl enable --now virtqemud.socket >/dev/null 2>&1
  sleep 3
  virsh -c qemu:///system version >/dev/null 2>&1 \
    && ok "motor de virtualización encendido" \
    || { mal "no se pudo encender el motor de virtualización"
         echo "      Mira qué dice:  sudo systemctl status libvirtd"; exit 1; }
else
  ok "motor de virtualización en marcha"
fi

# ── La red virtual, sin la cual Windows se queda aislado ──────────────
if ! virsh -c qemu:///system net-info default >/dev/null 2>&1; then
  virsh -c qemu:///system net-define /usr/share/libvirt/networks/default.xml >/dev/null 2>&1
fi
if ! virsh -c qemu:///system net-info default 2>/dev/null | grep -qiE 'activo: *s|active: *y'; then
  virsh -c qemu:///system net-start    default >/dev/null 2>&1
  virsh -c qemu:///system net-autostart default >/dev/null 2>&1
fi
ok "red virtual disponible"

# ── Que el usuario pueda manejar sus máquinas sin sudo ────────────────
USUARIO_REAL="${SUDO_USER:-}"
if [ -n "$USUARIO_REAL" ] && [ "$USUARIO_REAL" != "root" ]; then
  for g in libvirt kvm; do
    if getent group "$g" >/dev/null && ! id -nG "$USUARIO_REAL" | tr ' ' '\n' | grep -qx "$g"; then
      usermod -aG "$g" "$USUARIO_REAL" && \
        avi "$USUARIO_REAL añadido al grupo «$g» — cierra sesión al terminar"
    fi
  done
fi

# ── Qué acepta libvirt AQUÍ ───────────────────────────────────────────
# Esto es lo que provocó una tarde entera de errores en cursalialinux:
# SPICE y el vídeo qxl no están en todos los equipos, y cuando faltan
# libvirt rechaza la máquina entera con mensajes incomprensibles.
CAPS=$(virsh -c qemu:///system domcapabilities 2>/dev/null)
if echo "$CAPS" | grep -q '<value>spice</value>'; then
  PANTALLA="spice"
  echo "$CAPS" | grep -q '<value>qxl</value>' && VIDEO=qxl || VIDEO=vga
  ok "pantalla SPICE con vídeo $VIDEO"
else
  PANTALLA="vnc"; VIDEO=vga
  avi "este equipo no acepta SPICE — se usará VNC con vídeo VGA"
fi

HAY_UEFI=0; HAY_TPM=0
echo "$CAPS" | grep -q 'efi' && { HAY_UEFI=1; ok "arranque UEFI disponible"; } \
                             || avi "sin arranque UEFI — solo Windows 7"
echo "$CAPS" | grep -q 'tpm' && { HAY_TPM=1;  ok "TPM emulado disponible"; } \
                             || avi "sin TPM emulado — Windows 11 no será posible"

# ── Cuánta memoria y disco hay de verdad ──────────────────────────────
# ── Cuántos procesadores puede prestar ────────────────────────────────
# Pedir más hilos de los que la máquina tiene no la hace más rápida: la
# hace más lenta, y de paso ahoga al sistema de abajo. En los centros de
# salud hay equipos de dos hilos, así que esto no es teórico.
HILOS=$(nproc)
if   [ "$HILOS" -le 2 ]; then VCPUS=2
elif [ "$HILOS" -le 4 ]; then VCPUS=2
else VCPUS=$(( HILOS - 2 )); [ "$VCPUS" -gt 4 ] && VCPUS=4
fi
d "Hilos del procesador:" "$HILOS"
if [ "$HILOS" -le 2 ]; then
  avi "solo $HILOS hilos — Windows funcionará, pero despacio"
  echo "      Windows se llevará los dos y el sistema de abajo irá justo."
  echo "      Es lo que hay: con menos de dos, Windows ni arranca."
else
  d "Para Windows:" "$VCPUS procesadores"
fi

RAM_TOTAL_MB=$(( $(awk '/MemTotal/{print $2}' /proc/meminfo) / 1024 ))
# Al sistema anfitrión hay que dejarle lo suyo: con menos de 3 GB el
# escritorio se arrastra y la experiencia es peor que sin virtualizar.
RAM_MAX_VM=$(( RAM_TOTAL_MB - 3072 ))
d "Memoria del equipo:" "$(( RAM_TOTAL_MB / 1024 )) GB"
d "Disponible para Windows:" "$(( RAM_MAX_VM / 1024 )) GB como mucho"

[ -d "$IMG" ] || mkdir -p "$IMG"
LIBRE_GB=$(df -BG --output=avail "$IMG" | tail -1 | tr -dc '0-9')
d "Espacio libre:" "$LIBRE_GB GB"

if [ "$RAM_MAX_VM" -lt 2048 ]; then
  mal "no queda memoria suficiente para una máquina virtual"
  echo "      Hacen falta al menos 5 GB en el equipo. Aquí hay $(( RAM_TOTAL_MB / 1024 ))."
  exit 1
fi

# ═════════════════════════════════════════════════════════════════════
titulo "2 · PARA QUÉ VA A SERVIR"

if [ -z "$PAPEL" ]; then
  cat <<OPCIONES

   ${AZ}1)  SERVIDOR${V}
       Guarda la base de datos de todo el centro. Los demás consultorios
       se conectan aquí. Necesita más memoria y más disco.

   ${AZ}2)  PUESTO DE TRABAJO${V}
       Una persona metiendo información desde su consultorio.

OPCIONES
  printf "   Escribe 1 o 2 y pulsa Enter: "
  read -r R
  case "$R" in 1) PAPEL=servidor ;; 2) PAPEL=puesto ;; *) mal "no entendí «$R»"; exit 1 ;; esac
fi

case "$PAPEL" in
  servidor) ok "será el SERVIDOR del centro" ;;
  puesto)   ok "será un PUESTO DE TRABAJO"   ;;
  *) mal "papel no reconocido: «$PAPEL» (servidor o puesto)"; exit 1 ;;
esac

# ═════════════════════════════════════════════════════════════════════
titulo "3 · QUÉ VERSIÓN DE WINDOWS"

if [ -z "$VERSION" ]; then
  cat <<VERSIONES

   ${AZ}7 ${V}   Windows 7      BIOS antiguo, sin TPM
   ${AZ}8 ${V}   Windows 8.1    UEFI, sin TPM
   ${AZ}10${V}   Windows 10     UEFI y TPM
   ${AZ}11${V}   Windows 11     UEFI, Arranque Seguro y TPM obligatorios

   Los programas del Ministerio funcionan bien en Windows 10 y 11.

VERSIONES
  printf "   Escribe el número y pulsa Enter: "
  read -r VERSION
fi
case "$VERSION" in 8.1) VERSION=8 ;; esac

# ── El perfil de cada versión ─────────────────────────────────────────
# Cada Windows espera un hardware virtual distinto. Estos ajustes están
# probados: cambiarlos a ojo es la forma más rápida de que no arranque.
case "$VERSION" in
  7)  ETIQUETA="Windows 7";    OSINFO=win7;   MAQUINA=pc;  FIRMWARE=bios
      TPM=no;  RAM_BASE=4096; DISCO_BASE=40; USB=ehci;      DRIVERS=w7
      SIN_PARCHES=si
      SOPORTE="Sin parches de seguridad desde 2020, ni siquiera de pago" ;;
  8)  ETIQUETA="Windows 8.1";  OSINFO=win8.1; MAQUINA=q35; FIRMWARE=uefi
      TPM=no;  RAM_BASE=4096; DISCO_BASE=40; USB=qemu-xhci; DRIVERS=w8.1
      SIN_PARCHES=si
      SOPORTE="Sin parches de seguridad desde 2023, ni siquiera de pago" ;;
  10) ETIQUETA="Windows 10";   OSINFO=win10;  MAQUINA=q35; FIRMWARE=uefi
      TPM=si;  RAM_BASE=4096; DISCO_BASE=64; USB=qemu-xhci; DRIVERS=w10
      # Terminó su soporte normal en octubre de 2025, pero Microsoft
      # mantiene parches de seguridad: un año más para uso doméstico y
      # hasta 2028 para instituciones que lo contraten. No está
      # abandonado, pero tiene fecha de caducidad.
      SIN_PARCHES=no
      SOPORTE="Recibe parches de seguridad prorrogados. Fin previsto: 2026 en
   el hogar, hasta 2028 para instituciones que lo contraten" ;;
  11) ETIQUETA="Windows 11";   OSINFO=win11;  MAQUINA=q35; FIRMWARE=uefi-secure
      TPM=si;  RAM_BASE=6144; DISCO_BASE=80; USB=qemu-xhci; DRIVERS=w11
      SIN_PARCHES=no
      SOPORTE="Con soporte completo del fabricante" ;;
  *)  mal "versión no reconocida: «$VERSION»"; echo "      Válidas: 7, 8, 10, 11"; exit 1 ;;
esac

# ── ¿Puede este equipo con esa versión? ───────────────────────────────
if [ "$FIRMWARE" != "bios" ] && [ "$HAY_UEFI" = "0" ]; then
  mal "$ETIQUETA necesita arranque UEFI y este equipo no lo tiene"
  echo "      En este equipo solo se puede instalar Windows 7."
  exit 1
fi
if [ "$TPM" = "si" ] && [ "$HAY_TPM" = "0" ]; then
  mal "$ETIQUETA necesita TPM y este equipo no lo puede emular"
  echo "      Falta el programa «swtpm». Instálalo con:"
  echo "         sudo apt install swtpm swtpm-tools"
  exit 1
fi
# ── ¿Aceptará Windows 11 este procesador? ─────────────────────────────
# Windows 11 no se instala en cualquier procesador: comprueba el modelo
# contra una lista, y los anteriores a 2017 quedan fuera. Como la máquina
# virtual usa el procesador en modo directo, Windows ve el de verdad.
#
# Todos los procesadores de esa lista saben hacer AVX2, y los de antes no.
# No es exacto al cien por cien, pero avisa a tiempo en vez de dejar que
# la instalación falle después de veinte minutos.
if [ "$VERSION" = "11" ] && ! grep -qm1 ' avx2 ' /proc/cpuinfo; then
  echo
  avi "este procesador es anterior a los que Windows 11 admite"
  cat <<VIEJO

      $(grep -m1 'model name' /proc/cpuinfo | cut -d: -f2- | sed 's/^ *//')

      Aunque haya TPM y Arranque Seguro, el instalador de Windows 11
      comprueba el modelo del procesador y rechazará este.

      ${AZ}Lo sensato: instalar Windows 10.${V} Los programas del Ministerio
      funcionan igual de bien, y en un equipo de esta edad irá más suelto.

      Escribe ${AZ}10${V} para cambiar a Windows 10, o pulsa Enter para
      intentarlo con el 11 de todos modos.

VIEJO
  printf "   ¿Qué hago? "
  read -r CAMBIAR
  if [ "$CAMBIAR" = "10" ]; then
    echo
    ok "mejor así — vuelve a ejecutarlo eligiendo Windows 10"
    echo
    echo "         sudo redhornoma-windows --version 10"
    echo
    exit 0
  fi
  avi "se sigue con Windows 11; puede que el instalador lo rechace"
fi

ok "este equipo puede con $ETIQUETA"

# ── Ajustar a lo que hay de verdad ────────────────────────────────────
RAM_MB=$RAM_BASE
[ "$PAPEL" = "servidor" ] && RAM_MB=$(( RAM_BASE + 2048 ))
if [ "$RAM_MB" -gt "$RAM_MAX_VM" ]; then
  avi "se pedían $(( RAM_MB / 1024 )) GB de memoria y solo hay $(( RAM_MAX_VM / 1024 )) disponibles"
  RAM_MB=$RAM_MAX_VM
  [ "$RAM_MB" -lt 3072 ] && { mal "con menos de 3 GB $ETIQUETA no funciona bien"; exit 1; }
  echo "      Se usarán $(( RAM_MB / 1024 )) GB. Funcionará, pero irá justo."
fi

# El Windows del servidor NO es más grande que el de un puesto: es el mismo
# Windows con los mismos programas. Lo que el servidor necesita de más es
# sitio para los respaldos, y esos van a un disco externo y a otra
# computadora del centro, nunca al mismo disco que la base de datos.
DISCO_GB=$DISCO_BASE
NECESARIO=$(( DISCO_GB / 2 + 10 ))   # qcow2 crece según se usa, no de golpe

if [ "$LIBRE_GB" -lt "$NECESARIO" ]; then
  mal "hacen falta al menos $NECESARIO GB libres y hay $LIBRE_GB"
  echo
  echo "      $ETIQUETA necesita un disco de ${DISCO_GB} GB. Aunque crece poco"
  echo "      a poco, conviene tener sitio para que lo haga."
  echo
  echo "      ${AZ}Qué puedes hacer${V}"
  echo "         · Liberar espacio en este equipo"
  [ "$VERSION" = "11" ] && echo "         · Instalar Windows 10, que pide menos disco"
  echo "         · Usar otro equipo con más espacio"
  echo
  exit 1
fi

if [ "$PAPEL" = "servidor" ] && [ "$LIBRE_GB" -lt $(( NECESARIO + 60 )) ]; then
  avi "queda justo para un servidor: $LIBRE_GB GB libres"
  echo "      Los respaldos del centro tendrán que ir por fuerza a un disco"
  echo "      externo. Que es lo recomendable de todos modos, pero aquí"
  echo "      dejará de ser una opción."
fi

# ═════════════════════════════════════════════════════════════════════
titulo "4 · LOS DOS DISCOS QUE HACEN FALTA"

# ── El CD de controladores VirtIO ─────────────────────────────────────
VIRTIO=""
for f in "$IMG"/virtio-win*.iso "$IMG"/virtio*.iso; do
  [ -r "$f" ] && VIRTIO="$f"
done
if [ -z "$VIRTIO" ]; then
  mal "no encuentro el CD de controladores en $IMG"
  cat <<AYUDA

      Windows no reconoce por sí solo el disco ni la tarjeta de red de una
      máquina virtual. Ese CD trae los controladores que le faltan.

      Descárgalo en un equipo con internet:
         https://fedorapeople.org/groups/virt/virtio-win/direct-downloads/stable-virtio/virtio-win.iso

      Y déjalo en:  $IMG/

      Para los centros sin internet: la versión reducida de 52 MB se genera
      con  redhornoma-virtio-reducido  y cabe en cualquier pendrive.

AYUDA
  exit 1
fi
ok "controladores: $(basename "$VIRTIO")  ($(du -h "$VIRTIO" | cut -f1))"

# ── La imagen de Windows ──────────────────────────────────────────────
if [ -z "$ISO_WIN" ]; then
  echo
  echo "   Imágenes de Windows encontradas en $IMG:"
  echo
  N=0; CANDIDATOS=()
  for f in "$IMG"/*.iso; do
    [ -r "$f" ] || continue
    case "$(basename "$f")" in virtio*) continue ;; esac
    N=$((N+1)); CANDIDATOS+=("$f")
    printf "   %d)  %-44s %s\n" "$N" "$(basename "$f")" "$(du -h "$f" | cut -f1)"
  done
  if [ "$N" -eq 0 ]; then
    echo "      (ninguna)"
    cat <<AYUDA

   ${AM}RedHornoma no incluye Windows.${V} Cada centro debe usar su propia
   licencia y su propia imagen.

   Consigue la imagen de $ETIQUETA por los medios que tu institución
   tenga previstos, y déjala en:

      $IMG/

AYUDA
    exit 1
  fi
  echo
  printf "   Escribe el número y pulsa Enter: "
  read -r ELEGIDO
  ISO_WIN="${CANDIDATOS[$((ELEGIDO-1))]:-}"
fi
[ -r "${ISO_WIN:-}" ] || { mal "no puedo leer «$ISO_WIN»"; exit 1; }
ok "Windows: $(basename "$ISO_WIN")  ($(du -h "$ISO_WIN" | cut -f1))"

# ── ¿La imagen es de la versión que se eligió? ────────────────────────
# Elegir Windows 10 y montar una imagen de Windows 11 deja una máquina que
# no arranca la instalación: al 11 le falta el Arranque Seguro, que el
# perfil del 10 no activa. El nombre del archivo casi siempre lo delata.
case "$(basename "$ISO_WIN")" in
  *[Ww][Ii][Nn]*11*) ISO_VER=11 ;;
  *[Ww][Ii][Nn]*10*) ISO_VER=10 ;;
  *[Ww][Ii][Nn]*8*)  ISO_VER=8  ;;
  *[Ww][Ii][Nn]*7*)  ISO_VER=7  ;;
  *) ISO_VER="" ;;
esac

if [ -n "$ISO_VER" ] && [ "$ISO_VER" != "$VERSION" ]; then
  echo
  avi "elegiste Windows $VERSION pero la imagen parece de Windows $ISO_VER"
  cat <<AVISO

      Eso importa: cada versión necesita un hardware virtual distinto.
      Windows 11 no se instala sin Arranque Seguro, y el perfil de
      Windows $VERSION no lo activa.

      ${AZ}Escribe $ISO_VER${V} para usar el perfil correcto para esa imagen,
      o pulsa Enter para seguir con Windows $VERSION de todos modos.

AVISO
  printf "   ¿Qué hago? "
  read -r CORREGIR
  if [ "$CORREGIR" = "$ISO_VER" ]; then
    echo
    ok "cambiando al perfil de Windows $ISO_VER — vuelve a ejecutar el asistente"
    echo "      Es más seguro empezar de nuevo que cambiar a mitad."
    echo
    echo "         sudo redhornoma-windows --version $ISO_VER --iso \"$ISO_WIN\""
    echo
    exit 0
  fi
  avi "se sigue con Windows $VERSION bajo tu responsabilidad"
fi

# ═════════════════════════════════════════════════════════════════════
titulo "5 · CÓMO SE VA A LLAMAR"

if [ -z "$NOMBRE" ]; then
  SUGERIDO="salud-$PAPEL"
  printf "   Nombre para esta máquina [%s]: " "$SUGERIDO"
  read -r NOMBRE
  NOMBRE="${NOMBRE:-$SUGERIDO}"
fi
NOMBRE=$(echo "$NOMBRE" | tr -c 'A-Za-z0-9._-' '-' | sed 's/-*$//')
DISCO="$IMG/$(echo "$NOMBRE" | tr 'A-Z' 'a-z').qcow2"
XML="/tmp/redhornoma-$NOMBRE.xml"

if virsh -c qemu:///system dominfo "$NOMBRE" >/dev/null 2>&1; then
  mal "ya existe una máquina llamada «$NOMBRE»"
  cat <<BORRAR

      Para rehacerla desde cero, en DOS pasos:

         sudo virsh undefine $NOMBRE --nvram
         sudo rm -f $DISCO

      ${RO}NUNCA uses --remove-all-storage.${V} Para libvirt los CDs conectados
      cuentan como discos, y ese comando borra también las imágenes de
      Windows. Ya nos costó 8,5 GB una vez.

BORRAR
  exit 1
fi
ok "el nombre «$NOMBRE» está libre"
[ -e "$DISCO" ] && { mal "ya existe el disco $DISCO — no lo sobrescribo"; exit 1; }
ok "el disco no existe todavía"

# ═════════════════════════════════════════════════════════════════════
titulo "6 · LO QUE SE VA A CREAR"

echo
d "Sistema:"        "$ETIQUETA"
d "Papel:"          "$([ "$PAPEL" = servidor ] && echo 'servidor del centro' || echo 'puesto de trabajo')"
d "Nombre:"         "$NOMBRE"
d "Memoria:"        "$(( RAM_MB / 1024 )) GB"
d "Procesadores:"   "$VCPUS, en modo directo"
d "Chipset:"        "$MAQUINA"
case "$FIRMWARE" in
  bios)        d "Firmware:" "BIOS antiguo, lo que Windows 7 espera" ;;
  uefi)        d "Firmware:" "UEFI sin Arranque Seguro" ;;
  uefi-secure) d "Firmware:" "UEFI con Arranque Seguro y claves del fabricante" ;;
esac
[ "$TPM" = "si" ] && d "TPM:" "2.0 emulado, modelo CRB" || d "TPM:" "ninguno, esta versión no lo pide"
d "Disco:"          "${DISCO_GB} GB, crece según se use"
d "Pantalla:"       "$PANTALLA con vídeo $VIDEO"
d "Controladores:"  "viostor\\$DRIVERS\\amd64 y NetKVM\\$DRIVERS\\amd64"

echo
printf "   ${AZ}Soporte del fabricante${V}\n"
printf "   %s\n" "$SOPORTE"
if [ "$SIN_PARCHES" = "si" ]; then
  echo
  avi "$ETIQUETA ya no recibe parches de seguridad"
  echo "      Úsalo solo para el programa que lo necesita. Al final te"
  echo "      explico cómo dejarlo sin internet si hace falta."
elif [ "$VERSION" = "10" ]; then
  echo
  printf "   ${AZ}Mantenlo actualizado.${V} Los parches prorrogados hay que\n"
  echo "   activarlos: Configuración → Actualización y seguridad."
fi

cat <<LICENCIA

   ${AM}Licencia${V}
   Esto solo prepara el hardware virtual. Usar Windows requiere una
   licencia válida, y conseguirla corresponde al centro. RedHornoma no
   incluye ni reparte Windows.

LICENCIA

printf "   Para continuar escribe exactamente  ${AZ}CREAR${V}  y pulsa Enter: "
read -r RESPUESTA
[ "$RESPUESTA" = "CREAR" ] || { echo; echo "   Cancelado. No se creó nada."; exit 0; }

# ═════════════════════════════════════════════════════════════════════
titulo "7 · CREANDO"

qemu-img create -f qcow2 "$DISCO" "${DISCO_GB}G" >/dev/null \
  || { mal "no se pudo crear el disco"; exit 1; }
chown libvirt-qemu:kvm "$DISCO" 2>/dev/null || true
chmod 660 "$DISCO"
ok "disco creado: $(basename "$DISCO")  (${DISCO_GB} GB)"

ARGS=(
  --connect qemu:///system --dry-run --print-xml 1
  --name "$NOMBRE"
  --osinfo "$OSINFO"
  --memory "$RAM_MB"
  --vcpus "$VCPUS"
  --cpu host-passthrough
  --machine "$MAQUINA"
  --disk "path=$DISCO,format=qcow2,bus=virtio,cache=writeback,discard=unmap"
  --disk "device=cdrom,path=$ISO_WIN,boot.order=1"
  --disk "device=cdrom,path=$VIRTIO"
  --network network=default,model=virtio
  --controller "type=usb,model=$USB"
  --channel unix,target.type=virtio,target.name=org.qemu.guest_agent.0
  --graphics "$PANTALLA"
  --video "$VIDEO"
  --sound none
  --noautoconsole
)

case "$FIRMWARE" in
  uefi)        ARGS+=( --boot firmware=efi ) ;;
  uefi-secure) ARGS+=( --boot "firmware=efi,firmware.feature0.name=enrolled-keys,firmware.feature0.enabled=yes,firmware.feature1.name=secure-boot,firmware.feature1.enabled=yes" ) ;;
esac

# Las mejoras Hyper-V se listan una a una A PROPÓSITO. Si se dejara que
# virt-install las eligiera, metería <evmcs>, que en procesadores AMD
# impide arrancar la máquina.
FEATURES="hyperv.relaxed.state=on,hyperv.vapic.state=on,hyperv.spinlocks.state=on,hyperv.spinlocks.retries=8191"
[ "$FIRMWARE" = "uefi-secure" ] && FEATURES="smm.state=on,$FEATURES"
ARGS+=( --features "$FEATURES" )

[ "$TPM" = "si" ] && ARGS+=( --tpm backend.type=emulator,backend.version=2.0,model=tpm-crb )

if ! virt-install "${ARGS[@]}" > "$XML" 2>/dev/null; then
  mal "no se pudo generar la configuración"
  echo "      Se borra el disco creado para no dejar basura."
  rm -f "$DISCO"
  exit 1
fi
ok "configuración generada"

# ── Revisión antes de definir ─────────────────────────────────────────
echo
printf "   ${AZ}Revisando la configuración${V}\n"

# <evmcs> es una función de Intel: allí es correcta y hasta conviene.
# En AMD impide arrancar. Por eso solo se quita cuando el equipo es AMD.
if grep -q evmcs "$XML"; then
  if [ "$MARCA_CPU" = "AMD" ]; then
    sed -i '/<evmcs/d' "$XML"
    grep -q evmcs "$XML" \
      && { mal "no se pudo quitar <evmcs>, que en AMD impide arrancar"; rm -f "$DISCO"; exit 1; } \
      || ok "quitado <evmcs>, que en AMD impide arrancar"
  else
    ok "procesador $MARCA_CPU: <evmcs> es correcto aquí, se conserva"
  fi
fi

# La pantalla viaja por la red hasta quien la mira, y de fábrica va SIN
# comprimir. En la misma computadora no se nota; desde otra, cada ventana
# que se mueve se arrastra. Esto lo arregla, y de paso deja el
# portapapeles y el envío de archivos funcionando.
if [ "$PANTALLA" = "spice" ]; then
  python3 - "$XML" <<'PY' 2>/dev/null
import re,sys
f=sys.argv[1]; s=open(f).read()
extra = ("""<graphics type="spice" autoport="yes" listen="127.0.0.1">
      <listen type="address" address="127.0.0.1"/>
      <image compression="auto_glz"/>
      <jpeg compression="auto"/>
      <zlib compression="auto"/>
      <playback compression="on"/>
      <streaming mode="filter"/>
      <clipboard copypaste="yes"/>
      <filetransfer enable="yes"/>
    </graphics>""")
s = re.sub(r"<graphics type=.spice.*?</graphics>|<graphics type=.spice.*?/>", extra, s, flags=re.S)
open(f,"w").write(s)
PY
  grep -q 'auto_glz' "$XML" \
    && ok "pantalla comprimida — se verá suelta también desde otra computadora" \
    || avi "no se pudo ajustar la compresión de pantalla"
fi

# Que dos personas puedan mirar la misma pantalla a la vez. Sirve para
# ayudar a distancia sin echar a quien está trabajando.
if [ "$PANTALLA" = "vnc" ]; then
  sed -i "s|<graphics type=\"vnc\"|<graphics type=\"vnc\" sharePolicy=\"force-shared\"|" "$XML"
  grep -q 'force-shared' "$XML" && ok "pantalla compartible: dos personas pueden verla a la vez"
fi

grep -q "machine=\"$MAQUINA\""    "$XML" && ok "chipset $MAQUINA"
grep -q 'mode="host-passthrough"' "$XML" && ok "procesador en modo directo"
grep -q 'bus="virtio"'            "$XML" && ok "disco rápido VirtIO"
grep -q 'org.qemu.guest_agent.0'  "$XML" && ok "canal del agente invitado — hace falta para los respaldos"
[ "$FIRMWARE" != "bios" ] && { grep -q 'firmware="efi"' "$XML" && ok "firmware UEFI"; }
[ "$FIRMWARE" = "uefi-secure" ] && {
  grep -q 'name="secure-boot"'  "$XML" && ok "Arranque Seguro"
  grep -q 'name="enrolled-keys"' "$XML" && ok "claves del fabricante"; }
[ "$TPM" = "si" ] && { grep -q 'model="tpm-crb"' "$XML" && ok "TPM 2.0 modelo CRB"; }

# ── Definir ───────────────────────────────────────────────────────────
echo
if ! SALIDA=$(virsh -c qemu:///system define "$XML" 2>&1); then
  mal "libvirt rechazó la máquina. Esto es lo que dijo:"
  echo "$SALIDA" | sed 's/^/      /'
  echo
  echo "      El disco creado queda en $DISCO"
  echo "      La configuración, para revisarla, en $XML"
  exit 1
fi
ok "máquina «$NOMBRE» registrada"

# ═════════════════════════════════════════════════════════════════════
titulo "8 · PRUEBA DE ARRANQUE EN ESTE EQUIPO"

# Que libvirt acepte la configuración no significa que QEMU pueda
# arrancarla: eso solo se sabe intentándolo. Es la clase de fallo que en
# cursalialinux se descubría veinte minutos después, ya con el usuario
# delante. Aquí se enciende unos segundos y se apaga.
#
# Es seguro: Windows todavía no está instalado, no hay nada que perder.

echo "   Encendiéndola unos segundos para comprobar que este equipo"
echo "   puede realmente con ella…"
echo

ARRANCA=0
if ARRANQUE=$(virsh -c qemu:///system start "$NOMBRE" 2>&1); then
  sleep 6
  if [ "$(estado_vm "$NOMBRE")" = "running" ]; then
    ARRANCA=1
    ok "arranca correctamente en este equipo"
    virsh -c qemu:///system destroy "$NOMBRE" >/dev/null 2>&1
    ok "apagada — lista para que la instales cuando quieras"
  else
    mal "arrancó pero se detuvo sola"
    printf "      Estado ahora: %s\n" "$(estado_vm "$NOMBRE")"
    echo "      Mira la razón:"
    echo "         sudo virsh domstate $NOMBRE --reason"
    # Que no se quede encendida por un fallo de la comprobación
    virsh -c qemu:///system destroy "$NOMBRE" >/dev/null 2>&1
  fi
else
  mal "este equipo NO puede arrancar la máquina"
  echo
  echo "$ARRANQUE" | sed 's/^/      /'
  cat <<PROBLEMA

      ${AZ}Qué suele significar${V}

      La configuración es válida en general, pero algo de este equipo
      concreto no la admite. Lo más habitual:

         · El procesador no admite alguna función pedida
         · Falta un componente de QEMU para este tipo de máquina
         · El firmware UEFI no está donde libvirt lo busca

      La máquina queda registrada y apagada. Nada se ha perdido.

      ${AZ}Para que lo mire${V}

         redhornoma-informe --sin-color > ~/informe.txt

      y mándame ese archivo junto con el mensaje de arriba.

PROBLEMA
fi

# ── Anotarlo en el catálogo de equipos probados ───────────────────────
# Cada máquina en la que se prueba deja constancia. Con el tiempo esto
# dice qué hardware funciona y cuál da guerra, sin depender de la memoria
# de nadie.
CATALOGO=/var/lib/redhornoma
mkdir -p "$CATALOGO" 2>/dev/null
{
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$(date '+%Y-%m-%d')" \
    "$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null | head -1 | tr '\t' ' ')" \
    "$(cat /sys/class/dmi/id/product_name 2>/dev/null | head -1 | tr '\t' ' ')" \
    "$MARCA_CPU" \
    "$ETIQUETA" \
    "$PANTALLA/$VIDEO" \
    "$([ "$ARRANCA" = "1" ] && echo 'ARRANCA' || echo 'FALLA')"
} >> "$CATALOGO/equipos-probados.tsv" 2>/dev/null
chmod 644 "$CATALOGO/equipos-probados.tsv" 2>/dev/null
ok "anotado en el catálogo de equipos probados"

if [ "$PAPEL" = "servidor" ]; then
  virsh -c qemu:///system autostart "$NOMBRE" >/dev/null 2>&1 \
    && ok "arrancará sola con el equipo, como corresponde a un servidor"
fi

# ═════════════════════════════════════════════════════════════════════
titulo "LISTA — PERO APAGADA, A PROPÓSITO"

cat <<FIN

   ${AZ}Paso 1 · Ábrela ANTES de encenderla${V}

   Abre «Gestor de máquinas virtuales», haz doble clic en «$NOMBRE»
   para ver su pantalla, y ${AM}solo entonces${V} pulsa ▶.

   Si la enciendes sin mirar, te pierdes el aviso «Press any key to boot
   from CD», que dura cinco segundos, y no arrancará la instalación.

   ${AZ}Paso 2 · La pantalla de discos saldrá VACÍA${V}

   Es normal y le pasa a todo el mundo. Windows no reconoce el disco de
   una máquina virtual hasta que le das el controlador.

   Pulsa «Cargar controlador» y busca en el ${AM}segundo CD${V}:

      viostor\\$DRIVERS\\amd64     → aparecerá el disco de ${DISCO_GB} GB
      NetKVM\\$DRIVERS\\amd64      → para la tarjeta de red

   ${AZ}Paso 3 · Ya dentro de Windows, instala el agente${V}

   En ese mismo segundo CD, ejecuta:

      guest-agent\\qemu-ga-x86_64.msi

   Sin eso no se pueden hacer copias de seguridad con la máquina
   encendida, y ${AM}el respaldo es lo más importante del sistema${V}.

FIN

if [ "$PAPEL" = "servidor" ]; then
cat <<SERVIDOR
   ${AZ}Paso 4 · Ponle dirección fija${V}

   Un servidor no puede cambiar de número. Dentro de Windows:

      Configuración → Red e Internet → Ethernet
      Asignación de IP → Editar → Manual → IPv4 activado

   Y para que los demás consultorios lo vean, este equipo necesita la
   red en puente:

      sudo redhornoma-papel --configurar --papel servidor

SERVIDOR
fi

if [ "$SIN_PARCHES" = "si" ]; then
cat <<VIEJO
   ${AM}Sobre la seguridad de $ETIQUETA${V}

   Ya no recibe parches. Si solo lo usas para un programa concreto,
   conviene dejarlo sin internet. Primero mira su dirección física:

      sudo virsh domiflist $NOMBRE

   Y con ese número, cortar o devolver la red:

      sudo virsh domif-setlink $NOMBRE LA:DIRECCION:DE:ARRIBA down
      sudo virsh domif-setlink $NOMBRE LA:DIRECCION:DE:ARRIBA up

   Usa la dirección física, no «vnet0»: ese nombre cambia cada vez que
   se enciende y no existe cuando está apagada.

VIEJO
fi

printf "   Registro de todo esto: %s\n\n" "$REGISTRO"
