#!/bin/bash
# redhornoma-virtio-reducido — Adelgaza el CD de controladores VirtIO.
#
# El CD original pesa unos 750 MB, de los que más de 200 son símbolos de
# depuración (.pdb) que solo sirven a quien programa los controladores, y
# otros tantos son versiones de Windows que ningún centro de salud usa
# (2000, XP, Vista, y los Server).
#
# Quitando eso queda en unos 50 MB: cabe en cualquier pendrive y viaja bien
# por internet lento, que es lo normal en las áreas rurales.
#
# Uso:
#   redhornoma-virtio-reducido                        busca el original solo
#   redhornoma-virtio-reducido /ruta/virtio-win.iso
#
# No modifica el original. Escribe uno nuevo al lado.
set -u

V=$'\033[0m'; AZ=$'\033[1;34m'; VE=$'\033[1;32m'; RO=$'\033[1;31m'; AM=$'\033[1;33m'
ok(){  printf "   ${VE}✅${V} %s\n" "$1"; }
mal(){ printf "   ${RO}❌${V} %s\n" "$1"; }
avi(){ printf "   ${AM}⚠️ ${V} %s\n" "$1"; }

IMG=/var/lib/libvirt/images
ORIGEN="${1:-}"

printf "\n${AZ}══════════════════════════════════════════════════════${V}\n"
printf "${AZ} ADELGAZAR EL CD DE CONTROLADORES${V}\n"
printf "${AZ}══════════════════════════════════════════════════════${V}\n\n"

# ── Encontrar el original ─────────────────────────────────────────────
if [ -z "$ORIGEN" ]; then
  for f in "$IMG"/virtio-win*.iso ./virtio-win*.iso "${HOME:-/root}"/Descargas/virtio-win*.iso; do
    [ -r "$f" ] && ORIGEN="$f" && break
  done
fi

if [ -z "$ORIGEN" ] || [ ! -r "$ORIGEN" ]; then
  mal "no encuentro el CD original"
  cat <<AYUDA

      Descárgalo en un equipo con internet:
         https://fedorapeople.org/groups/virt/virtio-win/direct-downloads/stable-virtio/virtio-win.iso

      Y pásale la ruta:
         redhornoma-virtio-reducido /ruta/virtio-win.iso

AYUDA
  exit 1
fi

case "$ORIGEN" in *reducido*|*redhornoma*)
  avi "«$(basename "$ORIGEN")» ya parece una versión reducida"
  echo "      Si insistes, se hará igual." ;;
esac

ok "original: $(basename "$ORIGEN")  ($(du -h "$ORIGEN" | cut -f1))"

for h in xorriso 7z bsdtar; do command -v "$h" >/dev/null 2>&1 && HERR="$h" && break; done
if [ -z "${HERR:-}" ]; then
  mal "falta una herramienta para abrir el CD"
  echo "      sudo apt install xorriso"
  exit 1
fi

DESTINO="$(dirname "$ORIGEN")/virtio-redhornoma.iso"
TRABAJO=$(mktemp -d /tmp/redhornoma-virtio.XXXXXX)
trap 'rm -rf "$TRABAJO"' EXIT

# ── Extraer ───────────────────────────────────────────────────────────
printf "\n${AZ}1 · Abriendo el CD original${V}\n"
case "$HERR" in
  xorriso) xorriso -osirrox on -indev "$ORIGEN" -extract / "$TRABAJO" >/dev/null 2>&1 ;;
  7z)      7z x -o"$TRABAJO" "$ORIGEN" >/dev/null 2>&1 ;;
  bsdtar)  bsdtar -xf "$ORIGEN" -C "$TRABAJO" >/dev/null 2>&1 ;;
esac
chmod -R u+w "$TRABAJO" 2>/dev/null
ANTES=$(du -sm "$TRABAJO" | cut -f1)
[ "${ANTES:-0}" -gt 10 ] || { mal "no se pudo abrir el CD"; exit 1; }
ok "abierto — $ANTES MB"

# ── Quitar lo que sobra ───────────────────────────────────────────────
printf "\n${AZ}2 · Quitando lo que ningún centro de salud usa${V}\n"

PDB=$(find "$TRABAJO" -iname '*.pdb' | wc -l)
find "$TRABAJO" -iname '*.pdb' -delete
ok "$PDB archivos de depuración quitados"

# Se conservan solo las carpetas de las versiones que se usan. La lista es
# de lo que SE QUITA para no dejar fuera algo por descuido: si mañana el CD
# trae una carpeta nueva de Windows 12, seguirá dentro.
QUITADAS=0
for patron in 'w2k*' 'w2k3*' 'w2k8*' 'w2k12*' 'w2k16*' 'w2k19*' 'w2k22*' 'w2k25*' \
              'wxp*' 'wlh*' 'wnet*' '2k12*' '2k16*' '2k19*' '2k22*'; do
  while IFS= read -r dir; do
    [ -n "$dir" ] && rm -rf "$dir" && QUITADAS=$((QUITADAS+1))
  done < <(find "$TRABAJO" -maxdepth 3 -type d -iname "$patron" 2>/dev/null)
done
ok "$QUITADAS carpetas de versiones antiguas o de servidor quitadas"

# Las arquitecturas de 32 bits ya no se usan en ningún equipo actual
X86=0
while IFS= read -r dir; do
  [ -n "$dir" ] && rm -rf "$dir" && X86=$((X86+1))
done < <(find "$TRABAJO" -maxdepth 4 -type d -iname 'x86' 2>/dev/null)
ok "$X86 carpetas de 32 bits quitadas"

# El instalador todo-en-uno pesa mucho y duplica lo que ya está suelto
find "$TRABAJO" -maxdepth 1 -iname 'virtio-win-gt-*.msi' -delete 2>/dev/null
find "$TRABAJO" -maxdepth 1 -iname 'virtio-win-guest-tools.exe' -delete 2>/dev/null

DESPUES=$(du -sm "$TRABAJO" | cut -f1)
printf "\n   %s MB  →  %s MB\n" "$ANTES" "$DESPUES"

# ── Comprobar que no se rompió nada ───────────────────────────────────
printf "\n${AZ}3 · Comprobando que sigue sirviendo${V}\n"
FALTA=0
for necesario in viostor NetKVM guest-agent; do
  if find "$TRABAJO" -maxdepth 1 -iname "$necesario" -type d | grep -q .; then
    ok "$necesario"
  else
    mal "$necesario — ha desaparecido"; FALTA=1
  fi
done
for v in w10 w11; do
  find "$TRABAJO" -type d -iname "$v" | grep -q . && ok "controladores para $v" \
    || { mal "faltan los controladores de $v"; FALTA=1; }
done
[ "$FALTA" = "1" ] && { mal "el resultado no sirve — no se escribe nada"; exit 1; }

# ── Escribir el nuevo ─────────────────────────────────────────────────
printf "\n${AZ}4 · Escribiendo el CD reducido${V}\n"
[ -e "$DESTINO" ] && { avi "ya existe $(basename "$DESTINO") — se reemplaza"; rm -f "$DESTINO"; }

if xorriso -as mkisofs -J -r -V "VIRTIO-RH" -o "$DESTINO" "$TRABAJO" >/dev/null 2>&1; then
  chmod 644 "$DESTINO"
  ok "escrito: $DESTINO  ($(du -h "$DESTINO" | cut -f1))"
else
  mal "no se pudo escribir el CD"
  exit 1
fi

printf "\n${AZ}══════════════════════════════════════════════════════${V}\n"
printf "${AZ} LISTO${V}\n"
printf "${AZ}══════════════════════════════════════════════════════${V}\n"
cat <<FIN

   El original no se ha tocado. El nuevo está en:

      $DESTINO

   Si lo dejas en $IMG/, el asistente
   de Windows lo encontrará solo:

      sudo redhornoma-windows

FIN
