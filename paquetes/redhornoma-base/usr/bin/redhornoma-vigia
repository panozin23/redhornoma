#!/bin/bash
# redhornoma-vigia — Avisa cuando un centro deja de estar bien, sin que
#                    nadie tenga que preguntar.
#
# EL PORQUÉ
#
# Es el objetivo 9, y es el que más falta hace. El sistema YA sabe cuándo
# algo va mal: lo anota, deja señales en la nube, y hay pantallas que lo
# enseñan. Lo que faltaba es que lo DIGA.
#
# Y no es teoría. Ha pasado dos veces:
#
#   · SOAPS estuvo CINCO SEMANAS sin respaldo (visto el 08/08/2026)
#   · Hornoma, NUEVE DÍAS (visto el 12/08/2026)
#
# Las dos veces el sistema hizo bien su trabajo y lo apuntó. Las dos veces
# nadie leyó el apunte. Un centro que anota sus fallos en un archivo que
# nadie abre está tan roto como uno que no los anota.
#
# LAS DOS REGLAS QUE LO HACEN ÚTIL
#
# 1 · SI TODO VA BIEN, NO DICE NADA. Un aviso que sale todos los días se
#     ignora a la semana, y entonces el día que importa tampoco se lee.
#     El silencio es la señal de que todo está en orden.
#
# 2 · SI NO PUEDE COMPROBARLO, NO DICE «TODO BIEN». Sin internet no se
#     sabe nada de los centros, y eso NO es lo mismo que estar bien.
#     Se calla ese día —quedarse sin internet un rato es normal— pero si
#     pasan varios días sin poder mirar, avisa de eso también: el vigía
#     también se vigila a sí mismo.
#
# Uso:
#   redhornoma-vigia              mira y avisa solo si hay algo
#   redhornoma-vigia --siempre    habla aunque todo esté bien (para probar)
#   redhornoma-vigia --texto      escrito, sin ventana
#   sudo redhornoma-vigia --instalar   que mire solo al iniciar sesión
set -u

CONF_RESP=/var/lib/redhornoma/respaldo.conf
CONF_CENTROS=/etc/redhornoma/centros.conf
MEMORIA="${XDG_CACHE_HOME:-${HOME:-/root}/.cache}/redhornoma-vigia"
# Cuántos días sin poder mirar la nube antes de preocuparse por eso.
CIEGO_MAX=3

# 🔴 EL PUNTO CIEGO, VISTO EL 14/08/2026
#
# El vigía decía «todos los centros respaldaron a tiempo y dan señal»
# mientras Hornoma llevaba DOS DÍAS muerta. Y no mentía por un fallo: hacía
# exactamente lo que se le pidió. Miraba las señales que hay en la nube y
# las encontraba en orden.
#
# El problema era otro, y es el más viejo de este proyecto: SOLO VEÍA LO
# QUE ESTABA. Un centro que deja de dar señales no aparece en ninguna
# lista, así que no había nada que revisar. Cuanto peor va un centro, menos
# se le ve.
#
# La cura es tener una lista de a QUIÉN se espera, y esa lista ya existía
# sin darnos cuenta: Tailscale sabe qué máquinas hay y cuándo se vio a cada
# una por última vez. No hay que escribirla ni mantenerla a mano.
#
# Cuántas horas sin conectarse antes de avisar. 36 y no 48 a propósito: una
# máquina que enciende todas las noches y falla una sola ya pasa de 24, y
# esperar dos días completos es perder una noche más.
SILENCIO_HORAS=36
[ -f "$CONF_CENTROS" ] && {
  _s=$(grep -oP '^silencio_horas=\K[0-9]+' "$CONF_CENTROS" 2>/dev/null | head -1)
  [ -n "${_s:-}" ] && SILENCIO_HORAS="$_s"
}

V=$'\033[0m'; AZ=$'\033[1;34m'; VE=$'\033[1;32m'; GR=$'\033[0;90m'
export GDK_BACKEND=x11

MODO=auto; SIEMPRE=0
while [ $# -gt 0 ]; do
  case "$1" in
    --siempre)  SIEMPRE=1; shift ;;
    --texto)    MODO=texto; shift ;;
    --instalar) MODO=instalar; shift ;;
    -h|--ayuda) sed -n '2,35p' "$0" | sed 's/^# \?//'; exit 0 ;;
    *) echo "No entiendo «$1»"; exit 1 ;;
  esac
done

# ── Dejarlo puesto para que mire al iniciar sesión ────────────────────
if [ "$MODO" = "instalar" ]; then
  D=/etc/xdg/autostart/redhornoma-vigia.desktop
  [ "$(id -u)" = "0" ] || { echo "Hace falta sudo: sudo redhornoma-vigia --instalar"; exit 1; }
  cat > "$D" <<'FIN'
[Desktop Entry]
Type=Application
Name=Vigía de los centros
Comment=Avisa si algún centro dejó de respaldar o de dar señales
# El retraso es a propósito: al iniciar sesión la red tarda en estar
# lista, y preguntar antes daría un «no se pudo comprobar» que no es
# verdad. Se espera a que el escritorio esté en marcha.
Exec=sh -c 'sleep 90; redhornoma-vigia'
Terminal=false
X-GNOME-Autostart-enabled=true
NoDisplay=true
FIN
  printf "   ✅ puesto: mirará al iniciar sesión, 90 segundos después\n"
  printf "   %s\n" "$D"
  printf "\n   Para quitarlo:  sudo rm %s\n\n" "$D"
  exit 0
fi

# ── Dónde está el permiso de la nube ──────────────────────────────────
leer(){ [ -f "$2" ] && grep -oP "^$1=\K.*" "$2" 2>/dev/null | head -1; }
if [ -z "${RCLONE_CONFIG:-}" ]; then
  for _p in "${HOME:-/root}/.config/rclone/rclone.conf" /etc/redhornoma/rclone.conf \
            "/home/${SUDO_USER:-nadie}/.config/rclone/rclone.conf"; do
    [ -r "$_p" ] && { export RCLONE_CONFIG="$_p"; break; }
  done
fi
NUBE=$(leer nube "$CONF_RESP"); REMOTO="${NUBE%%:*}"; REMOTO="${REMOTO:-drive}"

mkdir -p "$(dirname "$MEMORIA")" 2>/dev/null
ULTIMA_BUENA=$(cat "$MEMORIA" 2>/dev/null | head -1)
case "$ULTIMA_BUENA" in ''|*[!0-9]*) ULTIMA_BUENA=0 ;; esac

# ── Traer las señales ─────────────────────────────────────────────────
PROBLEMAS=""; SE_PUDO=no
if command -v rclone >/dev/null 2>&1 && [ -n "${RCLONE_CONFIG:-}" ]; then
  TD=$(mktemp -d); trap 'rm -rf "$TD"' EXIT
  if timeout 120 rclone copy "$REMOTO:SENALES-REDHORNOMA" "$TD/resp" --include '*.txt' >/dev/null 2>&1; then
    SE_PUDO=si
  fi
  timeout 120 rclone copy "$REMOTO:ESTADO-REDHORNOMA" "$TD/estado" --include '*.txt' >/dev/null 2>&1
fi

if [ "$SE_PUDO" = "si" ]; then
  AHORA=$(date +%s)
  printf '%s\n' "$AHORA" > "$MEMORIA" 2>/dev/null

  # ── Los respaldos: ¿alguno lleva demasiado sin copiar? ──
  for f in "$TD"/resp/*.txt; do
    [ -f "$f" ] || continue
    C=$(grep -oP '^centro=\K.*' "$f");   M=$(grep -oP '^maquina=\K.*' "$f")
    S=$(grep -oP '^segundos=\K.*' "$f"); CADA=$(grep -oP '^cada_dias=\K.*' "$f")
    OK=$(grep -oP '^confirmado=\K.*' "$f")
    case "$S" in ''|*[!0-9]*) continue ;; esac
    case "$CADA" in ''|*[!0-9]*) CADA=2 ;; esac
    DIAS=$(( (AHORA - S) / 86400 ))
    # Margen de un día: que el respaldo se retrase unas horas es normal.
    if [ "$DIAS" -gt $(( CADA + 1 )) ]; then
      PROBLEMAS="$PROBLEMAS🔴|$C ($M)|lleva $DIAS días sin respaldar"$'\n'
    elif [ "$OK" != "si" ]; then
      PROBLEMAS="$PROBLEMAS🔴|$C ($M)|su último respaldo NO pasó la comprobación"$'\n'
    fi
  done

  # ── Los que dijeron «vuelvo» y no volvieron ──
  #
  # 🔴 MEJORADO EL 18/08/2026. Antes esto solo saltaba tras 24 HORAS de
  # silencio, y ese plazo no servía para el caso real:
  #
  #   Hornoma se apaga a las 08:00 y promete volver a la 01:00. Si no
  #   vuelve, han pasado 17 horas — por debajo del plazo. El aviso llegaba
  #   AL DÍA SIGUIENTE, con el centro ya un día entero sin respaldo.
  #
  # El problema de fondo era que la promesa iba escrita para una persona
  # («19/08 a las 01:00») y ningún programa puede saber si esa hora ya
  # pasó. Ahora el aviso escribe además «vuelve_segundos», y aquí se
  # compara con el reloj: en cuanto pasa la hora prometida más una hora de
  # margen, se dice. Sin esperar a mañana.
  for f in "$TD"/estado/*.txt; do
    [ -f "$f" ] || continue
    C=$(grep -oP '^centro=\K.*' "$f");  M=$(grep -oP '^maquina=\K.*' "$f")
    Q=$(grep -oP '^que=\K.*' "$f");     S=$(grep -oP '^segundos=\K.*' "$f")
    VU=$(grep -oP '^vuelve=\K.*' "$f")
    VS=$(grep -oP '^vuelve_segundos=\K.*' "$f")
    case "$S" in ''|*[!0-9]*) continue ;; esac
    [ "$Q" = "apagando" ] || continue
    HORAS=$(( (AHORA - S) / 3600 ))
    case "${VS:-}" in
      ''|*[!0-9]*)
        # Señal antigua, sin hora comparable: se conserva el plazo de un
        # día. Vale para no perder de vista a un centro que aún no se ha
        # actualizado, aunque avise tarde.
        [ "$HORAS" -gt 24 ] && \
          PROBLEMAS="$PROBLEMAS🟡|$C ($M)|dijo que volvía el $VU y lleva $((HORAS/24)) días sin dar señal"$'\n'
        ;;
      *)
        # Una hora de margen: arrancar, levantar la red y avisar lleva su
        # rato, y en el campo el internet tarda en subir.
        if [ "$AHORA" -gt $(( VS + 3600 )) ]; then
          TARDE=$(( (AHORA - VS) / 3600 ))
          PROBLEMAS="$PROBLEMAS🔴|$C ($M)|prometió volver el $VU y NO ha vuelto — lleva $TARDE h de retraso"$'\n'
        fi
        ;;
    esac
  done
  # ── Los centros que se esperan, y no están ──
  #
  # Esto es lo que arregla el punto ciego. Lo de arriba revisa las señales
  # que HAY; esto revisa a los centros que DEBERÍAN estar dando señales.
  #
  # Dos avisos distintos, y conviene no confundirlos:
  #
  #   · «lleva N días sin conectarse» — el centro está caído o sin luz.
  #   · «nunca ha avisado» — el centro funciona, pero no sabe avisar.
  #     Es el caso de Hornoma: tiene respaldos en la nube y ni una sola
  #     señal de estado, porque le falta el aviso puesto. Un centro así
  #     puede morirse en silencio, y por eso se dice aunque esté sano.
  if command -v tailscale >/dev/null 2>&1; then
    YO=$(timeout 10 tailscale status --self=true --peers=false 2>/dev/null | awk 'NR==1{print $2}')
    # Se guarda la respuesta ANTES de intentar leerla, para poder
    # distinguir «Tailscale no dijo nada» de «no supe leer lo que dijo».
    # No es lo mismo: lo primero es un centro suelto, lo segundo es este
    # equipo estropeado, y solo lo segundo hay que contarlo.
    CRUDO=$(timeout 15 tailscale status --json 2>/dev/null)
    LISTA=""
    [ -n "$CRUDO" ] && LISTA=$(printf '%s' "$CRUDO" \
      | jq -r '.Peer[]? | "\(.HostName)|\(.Online)|\(.LastSeen // "")"' 2>/dev/null)
    if [ -n "$CRUDO" ] && [ -z "$LISTA" ] && printf '%s' "$CRUDO" | grep -q '"Peer"'; then
      # Tailscale contestó y traía centros, pero no se pudo leer la
      # respuesta: falta jq o está roto. Sin esto, la revisión entera
      # desaparecía SIN DECIRLO y el vigía volvía a estar ciego callado,
      # que es justo el fallo que este trozo vino a arreglar.
      PROBLEMAS="$PROBLEMAS🟡|este equipo|no puede revisar los centros — falla «jq»"$'\n'
      LISTA=""
    fi
    if [ -n "$LISTA" ]; then
      while IFS='|' read -r maq en_linea visto; do
        [ -n "$maq" ] || continue
        [ "$maq" = "$YO" ] && continue
        # El centro al que pertenece la máquina se saca del nombre del
        # archivo de señal: «centro--maquina.txt». Si no hay ninguno, es
        # una máquina que nunca respaldó y no se le exige nada.
        ARCH=$(ls "$TD"/resp/*--"$maq".txt 2>/dev/null | head -1)
        [ -n "$ARCH" ] || continue
        CEN=$(grep -oP '^centro=\K.*' "$ARCH" 2>/dev/null); CEN="${CEN:-$maq}"

        if [ "$en_linea" != "true" ] && [ -n "$visto" ] && [ "${visto:0:4}" != "0001" ]; then
          SEG=$(date -d "$visto" +%s 2>/dev/null)
          if [ -n "${SEG:-}" ]; then
            H=$(( (AHORA - SEG) / 3600 ))
            [ "$H" -gt "$SILENCIO_HORAS" ] && \
              PROBLEMAS="$PROBLEMAS🔴|$CEN ($maq)|lleva $((H/24)) día(s) y $((H%24)) h sin conectarse"$'\n'
          fi
        fi
        # ¿Sabe avisar? Si nunca dejó una señal de estado, no puede decir
        # que se apaga ni que despertó, y su silencio no significa nada.
        [ -f "$TD/estado/$(basename "$ARCH")" ] || \
          PROBLEMAS="$PROBLEMAS🟡|$CEN ($maq)|no avisa cuando se apaga ni cuando despierta"$'\n'
      done <<< "$LISTA"
    fi
  fi
else
  # 🔴 No poder mirar NO es «todo bien». Pero un rato sin internet es
  # normal: se calla ese día. Si pasan varios, eso ya es el problema.
  CIEGO=$(( ( $(date +%s) - ULTIMA_BUENA ) / 86400 ))
  if [ "$ULTIMA_BUENA" = "0" ]; then
    [ "$SIEMPRE" = "1" ] && PROBLEMAS="⚪|este equipo|nunca ha podido leer la nube — ¿tiene permiso de Drive?"$'\n'
  elif [ "$CIEGO" -ge "$CIEGO_MAX" ]; then
    PROBLEMAS="🟡|este equipo|lleva $CIEGO días sin poder mirar los centros"$'\n'
  fi
fi

# ── Decir lo que haya ─────────────────────────────────────────────────
N=$(printf '%s' "$PROBLEMAS" | grep -c . || true)

if [ "$N" = "0" ] && [ "$SIEMPRE" = "0" ]; then
  exit 0            # todo bien: el silencio es la señal
fi

if [ "$MODO" = "texto" ] || ! command -v yad >/dev/null 2>&1 \
   || [ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
  printf "\n${AZ}══════════════════════════════════════════════════════${V}\n"
  printf "${AZ} VIGÍA DE LOS CENTROS${V}\n"
  printf "${AZ}══════════════════════════════════════════════════════${V}\n\n"
  if [ "$N" = "0" ]; then
    printf "   ${VE}●${V} todos los centros respaldaron a tiempo y dan señal\n\n"
  else
    printf '%s' "$PROBLEMAS" | while IFS='|' read -r ico quien detalle; do
      [ -n "$quien" ] || continue
      printf "   %s %-26s %s\n" "$ico" "$quien" "$detalle"
    done
    printf "\n   ${GR}Para verlo con detalle:  redhornoma-vigilar${V}\n\n"
  fi
  exit 0
fi

if [ "$N" = "0" ]; then
  yad --info --center --width=420 --title="Vigía de los centros" \
      --text="<b>Todos los centros están al día.</b>\n\nRespaldaron a tiempo y dan señal." \
      --button="Entendido:0" >/dev/null 2>&1
  exit 0
fi

TEXTO="<b>Hay algo que mirar en los centros:</b>\n"
while IFS='|' read -r ico quien detalle; do
  [ -n "$quien" ] || continue
  TEXTO="$TEXTO\n$ico  <b>$quien</b>\n     $detalle\n"
done <<< "$PROBLEMAS"
TEXTO="$TEXTO\n<small>Este aviso solo sale cuando hay algo. Si no lo ves, es que todo va bien.</small>"

yad --warning --center --width=520 --title="Vigía de los centros" \
    --text="$TEXTO" --button="Ver detalle:2" --button="Entendido:0" >/dev/null 2>&1
[ "$?" = "2" ] && command -v redhornoma-vigilar >/dev/null 2>&1 && {
  # El «sed» quita los códigos de color: una ventana no los entiende y los
  # pinta como basura. La herramienta de al lado ya no los manda cuando no
  # hay terminal, pero esto vale también para las que aún no lo sepan.
  redhornoma-vigilar 2>&1 | sed -r 's/\x1b\[[0-9;]*[mK]//g' \
    | yad --text-info --center --width=760 --height=420 \
    --title="Los centros, con detalle" --button="Cerrar:0" >/dev/null 2>&1; }
exit 0
