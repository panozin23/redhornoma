#!/bin/bash
# Se ejecuta en el centro justo después de desempaquetar el paquete.
#
# EL PORQUÉ — 18/08/2026
#
# El guion que apaga el servidor cada noche NO viene dentro del paquete: lo
# ESCRIBE «redhornoma-horario --instalar» la primera vez, con los valores de
# ese centro. Eso está bien —cada centro tiene su horario— pero tiene una
# consecuencia que costó ver:
#
#   Actualizar el paquete NO cambia ese guion. Se queda como se escribió.
#
# En Hornoma el guion era del 12/08 y no sabía avisar a la nube. El paquete
# se actualizó tres veces desde entonces y el guion siguió igual, callado,
# sin que nada lo delatara.
#
# Así que aquí se vuelve a escribir, con LOS MISMOS VALORES que ya tiene
# puestos —leídos de lo que hay instalado, no inventados—, para que reciba
# las mejoras como cualquier otro archivo del paquete.
#
# REGLAS DE ORO DE ESTE ARCHIVO
#
#   · Si el centro no tiene horario, no se toca nada.
#   · Si algo sale mal, NO se falla. Un postinst que falla deja el paquete a
#     medio configurar, y eso es peor que un guion viejo. Por eso todo
#     acaba en «|| true».
set -u

RELOJ=/etc/systemd/system/redhornoma-apagar-noche.timer
UNIDAD=/etc/systemd/system/redhornoma-apagar-noche.service

if [ "${1:-}" = "configure" ] && [ -f "$RELOJ" ] && [ -f "$UNIDAD" ]; then
  # ── Recuperar los valores de lo que ya está puesto ──
  #    OnCalendar=Wed,Thu,Fri,Sat,Sun *-*-* 8..12:00/30:00
  #               └── días ──────────┘      └┘ hora de apagar
  LINEA=$(grep -oP '^OnCalendar=\K.*' "$RELOJ" 2>/dev/null | head -1)
  DIAS=$(printf '%s' "$LINEA" | awk '{print $1}')
  HORA=$(printf '%s' "$LINEA" | awk '{print $3}' | cut -d. -f1)
  ENCENDER=$(grep -oP '^Environment=ENCENDER=\K.*' "$UNIDAD" 2>/dev/null | head -1)

  # Solo se sigue si los tres valores tienen sentido. Ante la duda, se deja
  # el horario como está: mejor un guion viejo que un centro sin horario.
  BIEN=1
  case "$DIAS"     in ''|*[!A-Za-z,]*) BIEN=0 ;; esac
  case "$HORA"     in ''|*[!0-9]*)     BIEN=0 ;; esac
  case "$ENCENDER" in ''|*[!0-9:]*)    BIEN=0 ;; esac

  if [ "$BIEN" = "1" ] && command -v redhornoma-horario >/dev/null 2>&1; then
    APAGAR=$(printf '%02d:00' "$((10#$HORA))")
    echo "   RedHornoma: rehaciendo el horario de noche ($ENCENDER → $APAGAR, $DIAS)"
    redhornoma-horario --instalar \
      --encender "$ENCENDER" --apagar "$APAGAR" --dias "$DIAS" >/dev/null 2>&1 || true

    # 🔴 Se mira el RESULTADO, no el código de salida.
    #
    # «redhornoma-horario» acaba llamando a systemctl, y systemctl puede
    # quejarse por motivos que no impiden nada —dentro de un contenedor, o
    # a media instalación— y devolver error habiendo hecho el trabajo. Al
    # revés también pasa: devolver cero sin haber escrito nada.
    #
    # Es el fallo más repetido de este proyecto: dar por bueno un verde que
    # solo dice «el último comando no protestó». Así que se comprueba lo
    # único que importa: que el guion existe y sabe avisar.
    GUION=/usr/local/sbin/redhornoma-apagar-noche
    if [ -s "$GUION" ] && grep -q 'redhornoma-aviso' "$GUION" 2>/dev/null; then
      echo "   RedHornoma: horario al día — y ahora avisa a la nube antes de apagarse"
    else
      echo "   RedHornoma: el horario quedó como estaba (rehacerlo a mano con"
      echo "               «sudo redhornoma-horario --instalar»)"
    fi
  fi
fi

# ── ¿El aviso a la nube apunta a una copia vieja? ─────────────────────
#
# 🔴 EL 19/08/2026 COCHABAMBA LLEVABA SEIS DÍAS SIN AVISAR, Y EL PAQUETE
#    ESTABA AL DÍA.
#
# «redhornoma-desperte.service» lo escribió una versión antigua de
# «redhornoma-horario», cuando el aviso todavía se copiaba a mano a
# /usr/local/sbin. El paquete lo instala en /usr/bin y lo mantiene, pero
# el servicio seguía llamando a la copia de /usr/local/sbin — la del 13 de
# agosto, con el fallo del $HOME.
#
# Y hay una trampa añadida: /usr/local/sbin va ANTES que /usr/bin en el
# camino del administrador. Así que la copia vieja ganaba también cuando
# alguien escribía «redhornoma-aviso» a mano, y devolvía lo de siempre sin
# que nada delatara que era otra.
#
# El apartado de arriba no lo cubría: solo rehace las cosas cuando el
# centro tiene horario de noche, y Cochabamba no lo tiene a propósito.
DESPERTE=/etc/systemd/system/redhornoma-desperte.service
VIEJO=/usr/local/sbin/redhornoma-aviso

if [ "${1:-}" = "configure" ] && [ -f "$DESPERTE" ]; then
  DONDE=$(grep -oP '^ExecStart=\K\S+' "$DESPERTE" 2>/dev/null | head -1)
  if [ -n "$DONDE" ] && [ "$DONDE" != "/usr/bin/redhornoma-aviso" ]; then
    echo "   RedHornoma: el aviso a la nube apuntaba a «$DONDE»"
    if command -v redhornoma-horario >/dev/null 2>&1; then
      redhornoma-horario --solo-avisos >/dev/null 2>&1 || true
    fi
    # Se comprueba el RESULTADO, no el código de salida.
    NUEVO=$(grep -oP '^ExecStart=\K\S+' "$DESPERTE" 2>/dev/null | head -1)
    if [ "$NUEVO" = "/usr/bin/redhornoma-aviso" ]; then
      echo "   RedHornoma: ahora usa el aviso del paquete, que está al día"
      systemctl restart redhornoma-desperte.service >/dev/null 2>&1 || true
    else
      echo "   RedHornoma: no se pudo corregir — sigue apuntando a «$NUEVO»"
    fi
  fi
fi

# La copia suelta se APARTA, no se borra: no es nuestra para tirarla, y
# quien la puso puede querer verla. Pero deja de estar en el camino, que
# es lo que hacía daño.
if [ "${1:-}" = "configure" ] && [ -f "$VIEJO" ]; then
  mv -f "$VIEJO" "$VIEJO.reemplazado-por-el-paquete" 2>/dev/null \
    && echo "   RedHornoma: apartada la copia suelta de $VIEJO"
fi

# ── Que apagar no se quede clavado cinco minutos ──────────────────────
#
# 🔴 LA MADRUGADA DEL 20/08/2026 Cochabamba se quedó parada varios minutos
# en «esperando a que el dominio de huéspedes reinicie». No estaba rota:
# «libvirt-guests» le pide al Windows que se cierre y espera hasta CINCO
# MINUTOS, que es el valor de fábrica de Debian.
#
# Lo normal es apagar con «redhornoma-apagar», que cierra el Windows con
# orden y deja a libvirt-guests sin trabajo. Esto es la red de seguridad
# para cuando se apaga por otro camino: el botón, «systemctl poweroff», o
# un corte de luz con batería.
#
# 🔴 SE ESCRIBE EN UN ARCHIVO DE DEBIAN, y hay que hacerlo con cuidado:
# se AÑADE al final, con una marca, y solo si nadie ha puesto ya ese
# valor. Nunca se reescribe el archivo entero.
#
# Y va aquí y no en un ajuste de systemd porque el programa fija los 300
# A SECAS y DESPUÉS lee este archivo: cualquier variable de entorno se
# pierde. Se comprobó leyendo su código, línea 36.
CFGG=/etc/default/libvirt-guests
if [ "${1:-}" = "configure" ] && [ -f "$CFGG" ] \
   && ! grep -qE '^\s*SHUTDOWN_TIMEOUT=' "$CFGG"; then
  {
    echo ""
    echo "# --- puesto por RedHornoma ---"
    echo "# Dos minutos, no cinco. Suficiente para un Windows que se cierra"
    echo "# bien, y poco para quedarse mirando una pantalla parada."
    echo "# No se baja más: SQL Server necesita cerrar sus archivos."
    echo "SHUTDOWN_TIMEOUT=120"
  } >> "$CFGG"
  if grep -qE '^SHUTDOWN_TIMEOUT=120' "$CFGG"; then
    echo "   RedHornoma: apagar ya no esperará cinco minutos, sino dos"
  fi
fi

exit 0
